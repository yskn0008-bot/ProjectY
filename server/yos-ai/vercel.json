{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "github": {
    "autoJobCancelation": false
  },
  "functions": {
    "api/yos/chat.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/yos/nav-model.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/yos/taxi-event.mjs": {
      "maxDuration": 30,
      "supportsCancellation": true
    },
    "api/yos/taxi-health.mjs": {
      "maxDuration": 10
    },
    "api/yos/health.mjs": {
      "maxDuration": 10
    },
    "api/yos/public-config.mjs": {
      "maxDuration": 10
    }
  },
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ]; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD ./; else git diff --quiet HEAD^ HEAD ./; fi"
}
