{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "github": {
    "autoJobCancelation": false
  },
  "functions": {
    "api/yos/notification.mjs": {
      "maxDuration": 30
    },
    "api/yos/inbox-sort.mjs": {
      "maxDuration": 60
    },
    "api/yos/chat.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/yos/nav-model.mjs": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/yos/taxi-event.mjs": {
      "maxDuration": 30,
      "supportsCancellation": true
    },
    "api/yos/taxi-health.mjs": {
      "maxDuration": 10
    },
    "api/yos/health.mjs": {
      "maxDuration": 10
    },
    "api/yos/public-config.mjs": {
      "maxDuration": 10
    }
  },
  "crons": [
    {"path": "/api/yos/inbox-sort", "schedule": "0 0 * * *"}
  ],
  "ignoreCommand": "if git rev-parse HEAD^ >/dev/null 2>&1; then git diff --quiet HEAD^ HEAD ./; else exit 1; fi"
}
