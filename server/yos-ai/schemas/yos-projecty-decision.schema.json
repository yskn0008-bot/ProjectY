{
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "facts", "assumptions", "unknowns", "memoryCandidates", "nextAction"],
  "properties": {
    "answer": {"type": "string", "minLength": 1, "maxLength": 800},
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "sourceIds"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 500},
          "sourceIds": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "assumptions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 400}},
    "unknowns": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 400}},
    "memoryCandidates": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "nextAction": {
      "type": "string",
      "enum": [
        "CONTINUE|RERUN_FAILED",
        "CONTINUE|REQUEST_CODE_FIX",
        "CONTINUE|REQUEST_TRANSPORT",
        "CONTINUE|REQUEST_STATUS",
        "CONTINUE|UPDATE_BRANCH",
        "REVISE|REQUEST_CODE_FIX",
        "HOLD|NONE",
        "NEEDS_YOUSUKE|NONE"
      ]
    }
  }
}
