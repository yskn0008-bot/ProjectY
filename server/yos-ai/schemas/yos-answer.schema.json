{
  "type": "object",
  "required": [
    "answer",
    "facts",
    "assumptions",
    "unknowns",
    "memoryCandidates",
    "nextAction"
  ],
  "properties": {
    "answer": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "text",
          "sourceIds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memoryCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "content",
          "category",
          "domain",
          "status",
          "evidenceSourceIds",
          "privacyLevel"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "category": {
            "enum": [
              "personal-data",
              "hypothesis",
              "operation-rule",
              "spec-change",
              "implementation-change"
            ]
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "const": "candidate"
          },
          "evidenceSourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privacyLevel": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "nextAction": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
