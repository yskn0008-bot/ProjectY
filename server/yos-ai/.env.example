# Never commit real values or private resource identifiers.

# ============================================================
# YOS Taxi / YOSナビ 共通（最初に設定する最小構成）
# ============================================================
GOOGLE_AUTH_MODE=vercel_oidc
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
YOS_ALLOWED_ORIGINS=
PROJECT75_SPREADSHEET_ID=

# Taxiの書き込み認証。元トークンではなくSHA-256のみをVercelへ登録する。
YOS_TAXI_SYNC_TOKEN_SHA256=

# 任意。未指定時は「リアルタイム記録」。
YOS_TAXI_LIVE_SHEET_NAME=リアルタイム記録

# 任意。未指定時は15分。
YOS_NAV_MODEL_CACHE_SECONDS=900

# ============================================================
# YOS AI本体（Taxi連携の後に設定する）
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_SUBJECT_HASH=
YOS_LAW_DOCUMENT_ID=
YOS_MASTER_DOCUMENT_ID=
YOS_CHANGE_LOG_DOCUMENT_ID=
YOS_SYSTEM_MASTER_DOCUMENT_ID=
YOS_TAXI_MASTER_DOCUMENT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 任意の制限値
YOS_AUDIT_RETENTION_DAYS=30
YOS_REQUESTS_PER_HOUR=30
YOS_MAX_OUTPUT_TOKENS=5000
YOS_LIVE_MAX_OUTPUT_TOKENS=1500
YOS_MAX_CONTEXT_CHARACTERS=100000
YOS_MAX_DOCUMENT_CHARACTERS=30000
