{
  "always_run_in_app": true,
  "icon": {
    "color": "blue",
    "glyph": "calendar"
  },
  "name": "YOS DAYSTREAM Timeline 開発確認 20261105",
  "script": "// YOS DAYSTREAM native preview bridge — Scriptable (development only)\n// Existing Scriptable Keychain; read-only Notion / Apple Calendar. No new shortcuts or servers.\n// Requires the unchanged production Clarity / Notion Inbox setup only for credentials.\n'use strict';\n/* Local deterministic timeline engine. No network, credentials, or source mutations. */\n(function(root){\n'use strict';\nconst MIN='2026-10-16',MAX='2027-01-13',PX=2;\nfunction day(k){if(typeof k!=='string'||!/^\\d{4}-\\d{2}-\\d{2}$/.test(k))return false;const d=new Date(k+'T00:00:00Z');return Number.isFinite(+d)&&d.toISOString().slice(0,10)===k}\nconst date=k=>new Date(k+'T00:00:00Z');\nconst key=d=>d.toISOString().slice(0,10);\nconst plus=(k,n)=>key(new Date(+date(k)+n*86400000));\nconst minute=k=>+date(k)/60000;\nconst clock=n=>String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');\nconst at=(k,t)=>minute(k)+Number(t.slice(0,2))*60+Number(t.slice(3));\nfunction validEvent(e){return e&&typeof e.id==='string'&&e.id.length<180&&typeof e.title==='string'&&e.title.length>0&&e.title.length<=120&&day(e.date)&&Number.isInteger(e.start)&&e.start>=0&&e.start<1440&&Number.isInteger(e.duration)&&e.duration>=1&&e.duration<=1440&&['none','daily','weekly','monthly','yearly'].includes(e.repeat)&&['task','habit','sleep','meal','walk','wash','moisturizer','travel','other'].includes(e.kind)&&Number.isInteger(e.transfer)&&e.transfer>=0&&e.transfer<=240}\nfunction valid(data){return data&&Array.isArray(data.events)&&data.events.every(validEvent)&&(!data.completed||(typeof data.completed==='object'&&!Array.isArray(data.completed)&&Object.keys(data.completed).length<=1000&&Object.entries(data.completed).every(([k,v])=>/^.+@\\d{4}-\\d{2}-\\d{2}$/.test(k)&&k.length<220&&day(k.slice(-10))&&typeof v==='boolean'&&data.events.some(e=>k.slice(0,-11)===e.id&&occurs(e,k.slice(-10))))))&&(!data.fixedBuffers||(typeof data.fixedBuffers==='object'&&!Array.isArray(data.fixedBuffers)&&Object.keys(data.fixedBuffers).length<=500&&Object.entries(data.fixedBuffers).every(([k,v])=>k.length<200&&Number.isInteger(v)&&v>=0&&v<=240)))&&data.version===1&&Array.isArray(data.events)&&data.events.length<=300&&data.events.every(validEvent)&&new Set(data.events.map(x=>x.id)).size===data.events.length&&data.overrides&&typeof data.overrides==='object'&&!Array.isArray(data.overrides)&&Object.keys(data.overrides).length<=1000&&Object.entries(data.overrides).every(([k,v])=>k.length<220&&/^.+@\\d{4}-\\d{2}-\\d{2}$/.test(k)&&v&&Number.isInteger(v.start)&&v.start>=0&&v.start<1440&&Number.isInteger(v.duration)&&v.duration>=1&&v.duration<=1440)}\nfunction occurs(e,k){if(k<e.date)return false;const a=date(e.date),b=date(k);switch(e.repeat){case'none':return k===e.date;case'daily':return true;case'weekly':return (+b-+a)%604800000===0;case'monthly':return b.getUTCDate()===Math.min(a.getUTCDate(),new Date(Date.UTC(b.getUTCFullYear(),b.getUTCMonth()+1,0)).getUTCDate());case'yearly':return b.getUTCMonth()===a.getUTCMonth()&&b.getUTCDate()===Math.min(a.getUTCDate(),new Date(Date.UTC(b.getUTCFullYear(),a.getUTCMonth()+1,0)).getUTCDate());default:return false}}\nfunction instances(data,k){const rows=[];for(const d of [plus(k,-1),k])for(const e of data.events){if(!occurs(e,d))continue;const id=e.id+'@'+d,o=data.overrides[id]||{},s=minute(d)+(o.start??e.start),duration=o.duration??e.duration;rows.push({...e,...o,id,baseId:e.id,occurrenceDate:d,startAbs:s,endAbs:s+duration,fixed:false,source:'端末内の計画'});}return rows}\nfunction fixed(items,buffers={}){const out=[],seen=new Set();for(const e of items){if(!e.id||!e.source||!['schedule','task'].includes(e.type))continue;const id=e.source+':'+e.id;if(seen.has(id))continue;seen.add(id);const raw=e.startISO||(e.fixedTime?e.date+'T'+e.fixedTime+':00+09:00':null);if(!raw||!Number.isFinite(Date.parse(raw)))continue;const startAbs=Date.parse(raw)/60000+540,endAbs=e.endISO&&Number.isFinite(Date.parse(e.endISO))?Date.parse(e.endISO)/60000+540:null;out.push({id,title:e.title,startAbs,endAbs:endAbs>startAbs?endAbs:null,fixed:true,kind:'fixed',transfer:buffers[id]||0,source:e.source});}return out}\nfunction clip(row,k){const lo=minute(k),hi=lo+1440;if(row.startAbs>=hi||(row.endAbs??row.startAbs+1)<=lo)return null;const start=Math.max(row.startAbs,lo)-lo,end=Math.min(row.endAbs??row.startAbs+1,hi)-lo;return {...row,start,end,top:start*PX,height:(end-start)*PX,continuesBefore:row.startAbs<lo,continuesAfter:row.endAbs>hi}}\nfunction impact(rows){const notes=[],sorted=rows.filter(x=>x.endAbs!==null).slice().sort((a,b)=>a.startAbs-b.startAbs);for(let i=0;i<sorted.length;i++){const a=sorted[i];for(let j=i+1;j<sorted.length;j++){const b=sorted[j];if(b.startAbs<a.endAbs)notes.push({sign:'!',text:a.title+' と '+b.title+' が重複',ids:[a.id,b.id]});else if(j===i+1&&b.startAbs-a.endAbs<(b.transfer||0))notes.push({sign:'!',text:b.title+' 前の移動時間が不足（必要 '+b.transfer+'分）',ids:[b.id]});}if(a.kind==='meal'||a.kind==='wash'){const kind=a.kind==='meal'?'walk':'moisturizer',next=sorted.find(b=>b.kind===kind&&b.startAbs>=a.endAbs&&b.startAbs-a.endAbs<=30);notes.push(next?{sign:'+',text:a.title+' → '+next.title+'：習慣のつなぎやすさ（設定ルール）',ids:[a.id,next.id]}:{sign:'?',text:a.title+' の後の '+(kind==='walk'?'歩行':'保湿')+'：任意の連結候補（30分は仮ルール）',ids:[a.id]});}}\nnotes.push({sign:'?',text:'健康効果・最適な間隔は未検証。ここでの評価は習慣配置ルールで、科学的効果の判定ではありません。',ids:[]});return notes}\nconst api={MIN,MAX,PX,day,plus,minute,clock,at,valid,validEvent,occurs,instances,fixed,clip,impact};root.YOSTimeline=api;if(typeof module!=='undefined')module.exports=api;\n})(typeof window==='undefined'?globalThis:window);\n\nconst HTML_SHA256 = '6c1a44f8f6b7d7df265fcbb6adb918e7d50188dd55005c8c8e2c3a4a5354bbcf';\nconst HTML_BUNDLE=\"<!doctype html>\\n<html lang=\\\"ja\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#fbfbf9\\\">\\n<meta name=\\\"apple-mobile-web-app-capable\\\" content=\\\"yes\\\">\\n<meta name=\\\"apple-mobile-web-app-title\\\" content=\\\"YOS Calendar\\\">\\n<title>YOS / LIFE FLOW — DAYSTREAM</title>\\n<style>\\n:root{color-scheme:light;--paper:#fbfbf9;--ink:#151718;--muted:#74787e;--line:#e9e9e6;--schedule:#279BFA;--task:#A77BFA;--habit:#42CDA3;--money:#F5B942;--danger:#FF7485;--accent:#279BFA}\\n[hidden]{display:none!important}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--paper);font-family:-apple-system,BlinkMacSystemFont,'Hiragino Kaku Gothic ProN','Hiragino Sans',sans-serif;-webkit-font-smoothing:antialiased;color:var(--ink)}\\nbutton{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}\\nbutton:disabled{opacity:.4;cursor:default} .frame{max-width:900px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 15px) 23px calc(env(safe-area-inset-bottom) + 20px);min-height:100dvh;display:flex;flex-direction:column;gap:0}\\n.header{height:44px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.identity{display:flex;gap:10px;align-items:baseline}.identity strong{font-size:18px;letter-spacing:-.095em;font-weight:950}.identity em{font-style:normal;font-weight:600;letter-spacing:.16em;color:#92969b;font-size:9px}.header-tools{display:flex;gap:10px;align-items:center}.iconbutton{border:0;background:transparent;color:#151718;width:37px;height:36px;display:grid;place-items:center;font-size:22px;border-radius:50%}.iconbutton:hover{background:#eceff6}.tiny-circ{height:25px;width:25px;border-radius:50%;background:#151718;color:white;display:grid;place-items:center;font-size:15px;font-weight:650}\\n.hero{display:grid;grid-template-columns:1fr auto;align-items:end;padding:10px 0 19px;border-bottom:1px solid var(--line);gap:8px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.17em;color:#8a9095}.date-line{display:flex;align-items:baseline;gap:12px;margin:0}.big-date{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:clamp(75px,17vw,94px);font-weight:250;letter-spacing:-.095em;line-height:1.03;font-variant-numeric:tabular-nums}.day-meta{display:flex;flex-direction:column;gap:7px}.day-meta strong{font-size:17px;font-weight:800;letter-spacing:-.025em}.day-meta span{font-size:13px;color:#646b75}.hero-right{align-self:center;text-align:right;display:flex;flex-direction:column;gap:8px;align-items:end}.status-pill{display:flex;align-items:center;gap:6px;color:#62676e;font-size:10px;font-weight:700}.status-pill b{display:inline-block;width:7px;height:7px;border-radius:100%;background:#8d9497}.hero-right button{border:0;background:none;padding:5px;color:#235BEB;font-size:12px;font-weight:800}\\n.week-title{display:flex;justify-content:space-between;align-items:center;margin:18px 0 7px}.week-title span{font-size:11px;font-weight:800;letter-spacing:.09em;color:#646c75}.week-nav{display:flex;align-items:center;gap:7px}.week-nav button{width:30px;height:28px;border:0;background:transparent;color:#6c7178;font-size:21px}.weeknav-hint{font-size:10px;color:#8d9195}\\n.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:1px;align-items:center;padding-bottom:16px;border-bottom:1px solid var(--line)}.daybtn{border:0;background:transparent;min-width:0;height:64px;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:#646973}.daybtn .wd{font-size:10px;font-weight:700}.daybtn .num{font-size:22px;font-weight:470;font-variant-numeric:tabular-nums;letter-spacing:-.06em}.daybtn .dots{height:4px;display:flex;gap:2px}.dots i{height:4px;width:4px;border-radius:50%}.daybtn.selected{background:var(--ink);color:#fff}.daybtn.selected .dots i{background:#fff!important}.daybtn.today:not(.selected) .num{text-decoration:underline;text-decoration-color:#235BEB;text-decoration-thickness:2px;text-underline-offset:6px}\\n.streamhead{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:18px 0 12px}.streamhead h2{font-size:25px;letter-spacing:-.06em;font-weight:830;margin:0}.streamhead small{font-size:11px;color:#84888e}.filter-row{display:flex;gap:8px;overflow:auto;scrollbar-width:none;margin-bottom:11px}.filter-row::-webkit-scrollbar{display:none}.filter{flex:none;background:transparent;border:1px solid #d9dbe0;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:720;color:#555d68;min-height:33px;display:flex;align-items:center;gap:6px}.filter i{width:7px;height:7px;border-radius:50%;background:var(--c)}.filter.off{opacity:.38}.filter:first-child{border-color:#151718;color:#151718}\\n.stream{min-height:180px;flex:1;max-height:calc(100dvh - 547px);overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#ced2d7 transparent}.stream:focus-visible{outline:2px solid var(--accent)}.stream-item{display:grid;grid-template-columns:48px 15px minmax(0,1fr) auto;align-items:center;gap:8px;min-height:62px;padding:3px 0 3px 0;border-bottom:1px solid #efefed;text-align:left;width:100%;background:transparent;border-left:0;border-top:0;border-right:0;color:inherit}.stream-item:last-child{border-bottom:0}.stream-item:active{background:#f3f5fb}.time{font-size:12px;font-variant-numeric:tabular-nums;color:#606773;letter-spacing:-.04em;text-align:left}.time.unset{font-size:10px;color:#a1a5a8}.stream-spine{position:relative;align-self:stretch;display:flex;justify-content:center;align-items:center}.stream-spine::before{content:\\\"\\\";position:absolute;top:0;bottom:0;width:1px;background:#e5e8ea;left:7px}.stream-spine i{height:10px;width:10px;position:relative;border-radius:3px;background:var(--color);display:block;transform:rotate(45deg);box-shadow:0 0 0 4px var(--paper)}.stream-item.money .stream-spine i{border-radius:50%;transform:none}.stream-item.habit .stream-spine i{border-radius:50%;height:8px;width:8px;transform:none}.content{min-width:0}.content strong{font-size:14px;line-height:1.35;font-weight:720;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.018em}.content small{font-size:11px;line-height:1.4;color:#82868d;display:block;margin-top:4px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.amount{font-size:13px;font-weight:800;color:var(--money);white-space:nowrap;font-variant-numeric:tabular-nums}.stream-arrow{font-size:18px;color:#b6b8ba}.nothing{padding:28px 3px 30px;font-size:13px;color:#7d838b;line-height:1.8}.nothing b{font-size:17px;display:block;color:var(--ink);margin-bottom:2px}.empty-sample{display:flex;align-items:center;gap:6px;font-size:11px}\\n.brief{margin-top:9px;border-top:1px solid #1e2226;padding:13px 0 5px;display:grid;grid-template-columns:minmax(0,1.05fr) 1px minmax(0,.95fr);gap:11px;align-items:start}.brief .separator{height:63px;background:#e1e3e4}.brief small{display:block;color:#8d9094;font-size:9px;letter-spacing:.13em;font-weight:800;margin-bottom:6px}.brief strong{display:block;font-size:18px;letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}.brief p{margin:5px 0 0;color:#848990;font-size:10px;line-height:1.45}.brief .money-num{color:var(--money)}.brief .hab-num{color:var(--habit)}\\n.insight{display:flex;align-items:center;gap:10px;margin-top:11px;padding:11px 0 3px;border-top:1px solid var(--line)}.insight svg{flex:none}.insight p{margin:0;font-size:12px;line-height:1.45;color:#51575f}.insight b{font-weight:850;color:#151718}.meta-footer{padding-top:9px;font-size:10px;color:#a0a4aa;display:flex;gap:8px;justify-content:space-between}.meta-footer button{background:none;border:0;color:#69737f;padding:0;font-size:10px;font-weight:700}.demo-banner{padding:8px 12px;background:#fff3d3;border-left:3px solid #b17a10;font-size:11px;line-height:1.4;color:#5c4208;display:flex;justify-content:space-between;align-items:center;gap:10px}.demo-banner button{background:none;border:0;color:#604507;text-decoration:underline;padding:3px;font-weight:700;flex-shrink:0;white-space:nowrap}.demo-banner span{flex:1;min-width:0}\\n.dialog{border:0;border-radius:23px 23px 0 0;padding:21px 20px 30px;box-shadow:0 -16px 60px #16191b21;background:#fff;width:min(100%,600px);max-height:min(76dvh,680px);min-height:0;overflow-y:auto;overscroll-behavior:contain;position:fixed;inset:auto 0 0 0;margin:auto;color:var(--ink)}.dialog#infoDialog{padding-bottom:max(20px,env(safe-area-inset-bottom));}.dialog::backdrop{background:#15171840;backdrop-filter:blur(1px)}.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.sheet-head h2{margin:0;font-size:clamp(19px,5.5vw,24px);letter-spacing:-.04em;line-height:1.35;overflow-wrap:anywhere}.sheet-close{border:0;background:#f0f1f2;border-radius:50%;height:36px;width:36px;font-size:23px}.sheet-sub{margin:8px 0 16px;color:#767c85;font-size:12px;line-height:1.5}.month-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}.mwd{text-align:center;color:#8a9097;font-size:11px;padding:6px 0}.mday{height:48px;border:0;background:transparent;border-radius:11px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-weight:700;color:#40454d}.mday.sel{background:var(--ink);color:white}.mday.out{opacity:.28}.mdots{height:4px;display:flex;gap:2px}.mdots i{height:4px;width:4px;border-radius:50%}.mday.sel .mdots i{background:white!important}.month-actions{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:12px}.month-actions button{border:1px solid #e3e4e5;background:#fff;border-radius:11px;padding:9px 13px;font-size:12px;font-weight:700}.detail-line{padding:12px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.5}.detail-line b{display:block;margin-bottom:4px}.detail-line span{color:#72777f}.sheet-link{font-size:12px;color:#2660CF;word-break:break-all}\\n@media(max-width:520px) and (min-height:750px){\\n .frame{padding-top:calc(env(safe-area-inset-top) + 9px);padding-bottom:calc(env(safe-area-inset-bottom) + 10px)}\\n .header{height:33px}.demo-banner{padding:5px 9px;font-size:10px}\\n .hero{padding-top:4px;padding-bottom:9px}.eyebrow{font-size:9px}.big-date{font-size:76px}.day-meta{gap:5px}\\n .week-title{margin:8px 0 3px}.week{padding-bottom:7px}.daybtn{height:51px;gap:3px}.daybtn .num{font-size:19px}\\n .streamhead{padding:10px 0 7px}.streamhead h2{font-size:23px}.filter-row{margin-bottom:5px}\\n .stream-item{min-height:54px}.stream{min-height:140px;max-height:calc(100dvh - 450px)}\\n .brief{margin-top:6px;padding-top:9px}.brief .separator{height:48px}.brief small{margin-bottom:4px}.brief p{margin:3px 0 0}\\n .insight{margin-top:5px;padding:7px 0 0}.meta-footer{padding-top:5px}\\n}\\n@media(min-width:650px){.frame{padding-left:40px;padding-right:40px}.stream{max-height:440px}.brief{gap:22px}.hero{padding-top:30px}.daybtn{height:72px}}\\n@media(max-width:360px){.frame{padding-left:15px;padding-right:15px}.big-date{font-size:72px}.day-meta strong{font-size:15px}.filter{padding:7px 8px}.stream-item{grid-template-columns:42px 13px minmax(0,1fr) auto;gap:6px}.content strong{font-size:13px}}\\n@media(max-height:700px){.hero{padding-top:0;padding-bottom:9px}.big-date{font-size:64px}.week-title{margin-top:9px}.week{padding-bottom:5px}.daybtn{height:48px}.streamhead{padding:8px 0}.stream{max-height:calc(100dvh - 449px)}.brief{margin-top:6px}}\\n@media(prefers-reduced-motion:no-preference){.daybtn,.filter,.stream-item{transition:background .14s ease,opacity .14s ease}.dialog{animation:rise .22s cubic-bezier(.2,.7,.2,1)}@keyframes rise{from{transform:translateY(12px);opacity:.8}to{transform:translateY(0);opacity:1}}}\\n/* System UI audit 2026-11-02: readable labels, reliable tap targets, and actionable-first hierarchy. */\\n.identity em,.eyebrow,.week-title span,.weeknav-hint,.daybtn .wd,\\n.streamhead small,.filter,.content small,.time.unset,.brief small,.brief p,\\n.insight p,.meta-footer,.meta-footer button,.status-pill,.sheet-sub,\\n.mwd,.month-actions button,.detail-line,.demo-banner{font-size:12px;}\\n.identity em,.eyebrow,.week-title span,.weeknav-hint,.daybtn .wd,\\n.streamhead small,.filter,.content small,.time.unset,.brief small,.brief p,\\n.insight p,.meta-footer,.meta-footer button,.status-pill,.sheet-sub,\\n.mwd,.month-actions button,.detail-line,.demo-banner{line-height:1.4;}\\n.filter,.insight p,.detail-line{font-size:14px;line-height:1.45}\\n.meta-footer{flex-wrap:wrap}\\n.iconbutton,.hero-right button,.week-nav button,.filter,.sheet-close,\\n.month-actions button,.meta-footer button,.demo-banner button{min-height:44px;}\\n.iconbutton,.week-nav button,.sheet-close{min-width:44px;}\\n.daybtn{min-height:58px}.filter{padding:9px 11px}.stream-item{min-height:62px}\\n.brief strong{white-space:normal;overflow-wrap:anywhere}\\n.insight{margin-top:11px;padding:11px 0;background:#f4f7fa;border-top:0;border-radius:12px;padding-inline:12px}\\n.stream{max-height:clamp(180px,38dvh,430px)}\\n@media(max-width:360px){.frame{padding-inline:15px}.identity em{letter-spacing:0}.header{height:auto;min-height:44px}.week-nav{gap:0}.day-meta strong{font-size:15px}}\\n\\n/* YOS one-column dayplan; all state is local-only and never a Notion completion */\\n.dayplan{background:white;border:1px solid #dce6df;border-radius:18px;margin:14px 0 10px;padding:15px 12px}\\n.dayplan h2{margin:0;font-size:22px}.planhead{display:flex;align-items:center;justify-content:space-between;gap:9px}\\n.planhead span,.planintro,.planfooter{font-size:14px;color:#5b6c61;line-height:1.5}\\n.planintro{margin:8px 0 12px}.planfooter{padding-top:10px;border-top:1px solid #e7ebe7}\\n.planrow{display:grid;grid-template-columns:46px 44px minmax(0,1fr) 40px;gap:6px;min-height:64px;align-items:center;padding:8px 0;border-top:1px solid #edf0ed}\\n.planclock{font-size:13px;color:#5d6e63}.plancheck{height:44px;width:44px;border:1px solid #c0d2c7;background:white;border-radius:12px;font-size:24px}\\n.plancheck[disabled]{border:0;color:#a0afa4;background:#f0f2f0}.plancheck.checked{background:#dcf0e4;color:#146b43}\\n.plancopy{min-width:0;display:flex;flex-direction:column;gap:3px}.plancopy strong{font-size:16px;overflow-wrap:anywhere;line-height:1.4}\\n.plancopy small{font-size:14px;line-height:1.4;color:#596a60}.planrow.checked .plancopy strong{text-decoration:line-through;color:#8a978e}\\n.planmove{display:flex;flex-direction:column;gap:2px}.planmove button{border:0;background:#edf3ef;width:40px;min-height:28px;border-radius:8px;font-size:16px}.planmove button:disabled{opacity:.25}\\n.planlocked{font-size:12px;color:#7b8a80;text-align:center}\\n.sourcelist summary{min-height:44px;padding:12px 0;font-size:15px;font-weight:750;color:#47687d}\\n.sourcelist .stream{min-height:130px;max-height:260px}\\n@media(max-width:360px){.dayplan{padding:12px 8px}.planrow{grid-template-columns:36px 40px minmax(0,1fr) 36px;gap:4px}.plancheck{width:40px}.planmove button{width:36px}.planclock{font-size:12px}}\\n.plan-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0}\\n.plan-actions button{min-height:46px;border:0;background:#216f4c;color:white;padding:10px 18px;border-radius:12px;font-size:16px;font-weight:770}\\n.plan-actions button:disabled{opacity:.55}\\n.plan-actions span{font-size:14px;color:#516a5b;line-height:1.45;flex:1;min-width:160px}\\n:root{--schedule:#4173b9;--task:#4173b9;--habit:#087c58;--money:#936533;--accent:#087b59}\\nhtml:has(.tlFrame){--paper:#f4f7ff;--ink:#102441;--muted:#4c607a;--line:#cbd6e6;background:var(--paper);color-scheme:light}\\n.frame.tlFrame{height:100dvh;min-height:0;max-width:720px;padding:env(safe-area-inset-top) 20px 0;overflow:hidden;gap:0;background:radial-gradient(ellipse at 96% 16%,#b7f0df88,transparent 42%),radial-gradient(ellipse at 7% 45%,#e5d7ff99,transparent 49%),radial-gradient(ellipse at 85% 88%,#c5e1ff99,transparent 50%),linear-gradient(145deg,#f4fbff,#f6f2ff 52%,#f4fbfc);color:var(--ink)}\\n.tlHeader{display:flex;flex-direction:column;align-items:stretch;flex:none;gap:8px;padding:18px 0 10px}.tlIdentity{font-size:22px;font-weight:600;letter-spacing:.08em;color:#1e526f}.tlIdentity span{font-size:14px;letter-spacing:.16em;color:var(--muted);font-weight:500}.tlHeader h1{margin:0;font-size:28px;font-weight:750;letter-spacing:-.04em;line-height:1.4}.tlDateRow{display:flex;align-items:center;gap:0;min-height:52px;border:1px solid #fff;border-radius:30px;background:#ffffff85;box-shadow:0 9px 24px #6274a51a;backdrop-filter:blur(20px)}.tlDateRow button{border:0;background:transparent;color:var(--ink);min-height:48px;min-width:44px;padding:8px}#tlDateButton{flex:1;font-size:20px;font-weight:700;white-space:nowrap}#tlSettings{width:48px;height:48px;border-left:1px solid #ccd9ed;border-radius:50%}#tlSourceDot{width:5px;height:5px;background:#087b59;border-radius:50%;margin-right:8px}.tlIcon,.tlCardIcon{display:inline-flex;align-items:center;justify-content:center;flex:none}.tlIcon svg{height:24px;width:24px}.tlFrame .week{height:56px;flex:none;border:0;padding:0 0 6px;gap:3px}.tlFrame .daybtn{height:50px;min-height:44px;border-radius:17px;gap:1px;color:var(--muted);background:transparent;border:0}.tlFrame .daybtn .wd{font-size:14px;font-weight:500}.tlFrame .daybtn .num{font-size:18px}.tlFrame .daybtn.selected{background:linear-gradient(135deg,#21bb89,#087b59);color:#fff;box-shadow:0 4px 12px #087b5926}.tlFrame .daybtn .dots{height:3px}.tlFrame .dots i{height:3px;width:3px}\\n#tlPanel{--bg:#f5f7ff;--fg:#102441;--sub:#4c607a;--border:#71839e;position:relative;display:flex;flex-direction:column;flex:1;min-height:0;background:transparent;color:var(--fg);font-size:16px;line-height:1.5}\\n.tlCanvasLabel{display:flex;justify-content:space-between;gap:8px;min-height:24px;font-size:14px;color:var(--sub)}#tlDayLabel{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#tlViewport{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;position:relative;scrollbar-width:thin;background:transparent;scrollbar-color:#a9bad4 transparent}#tlGrid{height:2880px;position:relative;margin-top:8px;margin-bottom:28px}\\n.tlHour{position:absolute;left:0;right:0;height:1px;font-size:14px;line-height:20px;color:var(--sub);pointer-events:none;font-variant-numeric:tabular-nums}.tlHour::before{content:\\\"\\\";position:absolute;left:51px;top:7px;width:5px;height:5px;border-radius:50%;background:#729fe4}.tlHour::after{content:\\\"\\\";position:absolute;left:53px;top:12px;height:108px;border-left:2px solid #9ab8e460}\\n#tlPanel .tlBlock{position:absolute;display:flex;align-items:center;gap:10px;min-height:0;padding:0 12px;border:1px solid #ffffffed;border-left:2px solid #a0c4ff;border-radius:18px;text-align:left;overflow:hidden;line-height:1.4;font-size:16px;background:linear-gradient(120deg,#e3f1ffed,#cce2ffcc);box-shadow:0 5px 13px #5c7db018,inset 0 0 0 1px #a5c8ff50;color:var(--fg);touch-action:pan-y;z-index:1;backdrop-filter:blur(15px)}.tlCardIcon{width:30px;color:#3476c4}.tlCardIcon svg{width:28px;height:28px}.tlCardWords{min-width:0;display:grid;gap:2px}.tlCardWords strong{font-size:16px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tlCardWords>span{font-size:14px;color:#354e72;white-space:nowrap}.tlBlock[data-kind=sleep]{background:linear-gradient(120deg,#f0e7ffed,#e2d7ffcc)!important;border-left-color:#baa3ed!important}.tlBlock[data-kind=sleep] .tlCardIcon{color:#7653b7}.tlBlock[data-kind=habit],.tlBlock[data-kind=walk],.tlBlock[data-kind=wash],.tlBlock[data-kind=moisturizer]{background:linear-gradient(120deg,#e1fff0ed,#cef3e6cc)!important;border-left-color:#89dabb!important}.tlBlock[data-kind=habit] .tlCardIcon,.tlBlock[data-kind=walk] .tlCardIcon{color:#087b59}.tlBlock[data-kind=meal]{background:linear-gradient(120deg,#fff0e6ed,#ffe1d2cc)!important;border-left-color:#edb497!important}.tlBlock[data-kind=meal] .tlCardIcon{color:#ad5432}.tlBlock.fixed{border-left-style:dashed!important}.tlBlock.completed{opacity:.72}.tlBlock.completed strong{text-decoration:line-through}.tlBlock.conflict{outline:2px solid #b53b40;outline-offset:-2px}.tlBlock.dragging{z-index:5;box-shadow:0 14px 32px #3f5d8b40;outline:2px solid #087b59}\\n#tlPanel .tlDrag{position:absolute;right:0;width:44px;height:44px;min-height:44px;padding:0;z-index:6;touch-action:none;font-size:20px;border:0;background:transparent;color:var(--sub)}.tlNow{position:absolute;left:45px;right:0;height:1px;background:var(--fg);color:var(--fg);font-size:14px;line-height:20px;text-align:right;z-index:4;pointer-events:none}.tlNow::before{content:\\\"\\\";position:absolute;left:-3px;top:-3px;width:7px;height:7px;border-radius:50%;background:var(--fg)}\\n.tlTray{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;flex:none}#tlOpenTray{min-height:44px;font-size:14px;background:none;border:0;color:var(--fg);padding:0;text-align:left}#tlUnplacedCount{font-variant-numeric:tabular-nums;margin-left:5px;color:var(--sub)}#tlState{font-size:14px;line-height:1.4;color:var(--sub);text-align:right;max-width:58%}.tlBottom{display:flex;align-items:center;gap:12px;flex:none;padding:0 64px 6px 0}#tlPanel .tlBottom button{font:inherit;min-height:44px;flex:1;border:1px solid #fff;border-radius:18px;background:#ffffff80;color:var(--fg);padding:6px;font-size:16px;box-shadow:0 3px 12px #5d76a115}#tlPanel .tlBottom #tlSave{background:#087b59;color:#fff}#tlPanel .tlBottom #tlAdd{position:absolute;bottom:90px;right:0;z-index:8;flex:none;width:56px;height:56px;min-height:56px;border-radius:50%;background:linear-gradient(135deg,#28c796,#07845f);color:white;border:2px solid #ffffffc0;box-shadow:0 7px 24px #148e6450}#tlAdd .tlIcon svg{width:30px;height:30px}.tlTabs{display:flex;flex:none;gap:3px;padding:7px 5px max(7px,env(safe-area-inset-bottom));background:#ffffff8c;border:1px solid #fff;border-radius:28px 28px 0 0;box-shadow:0 -8px 30px #9ab6d426;backdrop-filter:blur(24px)}.tlTabs button{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;flex:1;padding:7px 2px;min-height:60px;border:0;border-radius:22px;background:transparent;color:#4c607a;font-size:14px;white-space:nowrap}.tlTabs button[aria-current=page]{color:#087b59;background:#d9f3ea91;font-weight:700}.tlTabs svg{height:23px;width:23px}\\n#tlSettingsDialog,#tlDrawer,#tlEditor,.dialog{background:#f5f8ff;color:var(--ink);border:1px solid white;border-radius:28px 28px 0 0;box-shadow:0 -10px 50px #30436630;font-size:16px}.dialog p{font-size:14px;line-height:1.6}.dialog .sheet-close{background:transparent;color:var(--ink);min-height:44px;min-width:44px}.dialog details{border-top:1px solid var(--line);padding:4px 0}.dialog summary{padding:12px 0;font-size:16px;min-height:44px;cursor:pointer}.dialog input,.dialog select,.dialog button:not(.sheet-close){font:inherit;min-height:44px;max-width:100%;padding:8px 12px;border:1px solid #8193ae;border-radius:12px;background:#ffffffa8;color:var(--ink)}.tlTools{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:12px 0}.tlTools label{display:flex;gap:6px;align-items:center}.tlHint,#tlStatus{font-size:14px;color:var(--muted)}#tlUnplaced,#tlPlaced,#tlReviewList,#tlHabitList{display:grid;gap:10px}#tlUnplaced button,#tlPlaced button,.tlReviewItem{text-align:left;font-size:16px;min-height:52px;padding:12px;background:#ffffffa8}.tlHabitCard{border:1px solid white;border-radius:20px;background:#dff5ec80;padding:16px}.tlHabitCard strong{font-size:16px}#tlPanel .tlNote,.tlNote{padding-left:10px;border-left:3px solid currentColor}.green{color:#126842}.amber{color:#895000}.red{color:#b13237}.neutral{color:var(--muted)}#tlEditor label{display:grid;gap:4px;margin:12px 0}#tlEditor select,#tlEditor input{width:100%}.dialog::backdrop{background:#1b345666;backdrop-filter:blur(5px)}#tlSettingsDialog .hero,#tlSettingsDialog .header,#tlSettingsDialog .week-title,#tlSettingsDialog .insight,#tlSettingsDialog .brief{margin:10px 0}#tlSettingsDialog .big-date{font-size:32px}#tlSettingsDialog .hero{padding:0;border:0}.tlBlock.linked{box-shadow:0 0 0 1px #087b5940}.tlBlock.separated:not(.conflict){box-shadow:0 0 0 1px #89500080}\\n#tlFeedback{position:absolute;z-index:12;top:32px;left:48px;right:4px;padding:9px 12px;border:1px solid var(--border);border-radius:16px;background:#f5fafff5;color:var(--fg);font-size:14px;line-height:1.5;white-space:pre-line;box-shadow:0 4px 14px #0002;pointer-events:none}#tlPanel .tlBlock::after{content:attr(data-impact);position:absolute;right:6px;top:0;font-size:16px;font-weight:700;color:var(--impact,var(--sub));padding:0 2px}.tlBlock.conflict{--impact:#b13237}.tlBlock.linked{--impact:#126842}.tlBlock.separated{--impact:#895000}.tlFrame :focus-visible,.dialog :focus-visible{outline:3px solid var(--ink);outline-offset:3px}button:disabled{opacity:.48}#tlSettingsDialog .dayplan,#tlSettingsDialog .plancheck,#tlSettingsDialog .planmove button{background:var(--paper);color:var(--ink);border-color:var(--line)}\\nhtml:has(.tlFrame[data-theme=dark]){--paper:#152236;--ink:#f1f5ff;--muted:#c3d2e7;--line:#607087;color-scheme:dark}.tlFrame[data-theme=dark]{background:radial-gradient(ellipse at 100% 20%,#204b49,transparent 50%),linear-gradient(135deg,#17283e,#302c4b)}#tlPanel[data-theme=dark]{--fg:#f1f5ff;--sub:#c3d2e7;--bg:#17283e;--border:#8297b5}.tlFrame[data-theme=dark] .tlIdentity,.tlFrame[data-theme=dark] .tlDateRow button{color:#f1f5ff}.tlFrame[data-theme=dark] .tlDateRow,.tlFrame[data-theme=dark] .tlTabs{background:#1c304bcc;border-color:#657996}.tlFrame[data-theme=dark] .tlTabs button{color:#d4e4f7}.tlFrame[data-theme=dark] .tlTabs button[aria-current=page]{color:#d9fff0;background:#22654e}.tlFrame[data-theme=dark] .tlBlock{--fg:#102441}.tlFrame[data-theme=dark] .tlBottom button:not(#tlSave):not(#tlAdd){background:#1c304b;color:#f1f5ff}.tlFrame[data-theme=dark] .tlFeedback{background:#17283e}.tlFrame[data-theme=dark] .tlCanvasLabel{color:#c3d2e7}html:has(.tlFrame[data-theme=dark]) .dialog{background:#17283e}html:has(.tlFrame[data-theme=dark]) .dialog button,html:has(.tlFrame[data-theme=dark]) .dialog input,html:has(.tlFrame[data-theme=dark]) .dialog select{background:#20334d;color:#f1f5ff}html:has(.tlFrame[data-theme=dark]) .tlHabitCard{background:#23483e}\\n@media(max-width:360px){.frame.tlFrame{padding-inline:12px}.tlHeader h1{font-size:26px}.tlIdentity{font-size:20px}.tlTabs button{font-size:12px}.tlCardIcon{width:24px}}\\n@media(prefers-reduced-transparency:reduce){.tlDateRow,.tlTabs{background:#f2f7ff;backdrop-filter:none}}\\n\\n.tlPeriods{display:flex;flex:none;border:1px solid white;border-radius:25px;padding:4px;background:#ffffff80;box-shadow:0 8px 20px #6d84b118;margin:2px 0 10px}.tlPeriods button{flex:1;min-height:44px;font-size:16px;color:var(--fg);border:0;background:transparent;border-radius:22px}.tlPeriods button[aria-current=page]{background:linear-gradient(135deg,#21bb89,#087b59);color:white;font-weight:700;box-shadow:0 4px 10px #087b5926}#tlPeriodList{display:grid;gap:10px}#tlPeriodList button{text-align:left}.tlFrame[data-theme=dark] .tlPeriods{background:#1c304bcc;border-color:#657996}\\n\\n#tlPanel[data-theme=dark] .green{color:#7fdeb0}#tlPanel[data-theme=dark] .amber{color:#ffc476}#tlPanel[data-theme=dark] .red{color:#ffa7a1}html:has(.tlFrame[data-theme=dark]) .green{color:#7fdeb0}html:has(.tlFrame[data-theme=dark]) .amber{color:#ffc476}html:has(.tlFrame[data-theme=dark]) .red{color:#ffa7a1}\\n#tlPanel :focus-visible,#tlEditor :focus-visible{outline:3px solid var(--fg,#102441);outline-offset:3px}\\n\\n@media(prefers-color-scheme:dark){\\nhtml:has(.tlFrame[data-theme=auto]){--paper:#152236;--ink:#f1f5ff;--muted:#c3d2e7;--line:#607087;color-scheme:dark}.tlFrame[data-theme=auto]{background:radial-gradient(ellipse at 100% 20%,#204b49,transparent 50%),linear-gradient(135deg,#17283e,#302c4b)}#tlPanel[data-theme=auto]{--fg:#f1f5ff;--sub:#c3d2e7;--bg:#17283e;--border:#8297b5}.tlFrame[data-theme=auto] .tlIdentity,.tlFrame[data-theme=auto] .tlDateRow button{color:#f1f5ff}.tlFrame[data-theme=auto] .tlDateRow,.tlFrame[data-theme=auto] .tlTabs{background:#1c304bcc;b