,8h-8v8a8,8,0,0,1-16,0V96h-8a8,8,0,0,1,0-16h8V72a8,8,0,0,1,16,0v8h8A8,8,0,0,1,248,88Z\\\\\\\"/></svg>\\\"};\\n function tlIcon(name){return tlIcons[name]||tlIcons.other}\\n function tlDecorate(){for(const [id,key] of Object.entries({tlPrev:'left',tlNext:'right',tlSettings:'settings',tlCalendar:'calendar',tlExitEdit:'left',tlAdd:'plus',tlTabTimeline:'calendar',tlTabHabits:'habit',tlTabReview:'review',tlTabSettings:'settings'})){const el=$(id);if(!el)continue;const mark=document.createElement('span');mark.className='tlIcon';mark.innerHTML=tlIcon(key);el.replaceChildren(mark,...(id.startsWith('tlTab')?[Object.assign(document.createElement('span'),{textContent:{tlTabTimeline:'タイムライン',tlTabHabits:'習慣',tlTabReview:'振り返り',tlTabSettings:'設定'}[id]})]:[]));}}\\n function tlDone(item){return !!timeline.completed?.[item.id]}\\n function tlToggleDone(id){tlMutate(()=>{timeline.completed={...(timeline.completed||{}),[id]:!timeline.completed?.[id]}})}\\n const clone=x=>JSON.parse(JSON.stringify(x));\\n function tlMutate(fn){if(saving)return;undoStack.push(clone(timeline));if(undoStack.length>30)undoStack.shift();fn();timelineDirty=true;savedVerified=false;renderTimeline();}\\n function tlRows(){const source=state.native?state.native.items:state.items;return [...TL.instances(timeline,state.selected),...TL.fixed(source,timeline.fixedBuffers||{})].map(x=>TL.clip(x,state.selected)).filter(Boolean)}\\n function tlMove(item,start,duration=item.duration){if(item.fixed||saving)return;tlMutate(()=>{timeline.overrides[item.id]={start:Math.max(0,Math.min(1439,Math.round(start/5)*5)),duration};});}\\n function tlEdit(item){$('tlDrawer').close();$('tlError').textContent='';if(item.fixed){const v=prompt('固定予定の時刻は変更できません。この前に必要な移動時間（分、0〜240）だけ計画に設定します。',String(item.transfer||0));if(v!==null&&/^\\\\d+$/.test(v)&&Number(v)<=240)tlMutate(()=>{timeline.fixedBuffers={...(timeline.fixedBuffers||{}),[item.id]:Number(v)}});return}const base=timeline.events.find(x=>x.id===item.baseId);if(!base)return;tlEditingOccurrence=item.id;$('tlComplete').hidden=false;$('tlDelete').hidden=false;$('tlComplete').textContent=tlDone(item)?'この回を未実施に戻す（この端末）':'この回を実施済みにする（この端末）';$('tlId').value=base.id;$('tlSourceRef').value=base.sourceRef||'';$('tlTitle').value=base.title;$('tlDate').value=item.occurrenceDate;$('tlTime').value=TL.clock(item.startAbs-TL.minute(item.occurrenceDate));$('tlDuration').value=item.duration;$('tlKind').value=base.kind;$('tlRepeat').value=base.repeat;$('tlTransfer').value=base.transfer;$('tlScope').hidden=false;$('tlScope').value='instance';$('tlEditor').showModal();}\\n function tlImpact(rows,before=null){const notes=TL.impact(rows);if(before)for(const n of before.filter(n=>n.sign==='+'&&!notes.some(x=>x.sign==='+'&&x.ids.join('|')===n.ids.join('|'))))notes.push({sign:'−',text:'以前の連結から離れます（段取りの変化。健康影響は未判定）：'+n.ids.map(id=>rows.find(x=>x.id===id)?.title||id).join(' → '),ids:n.ids});$('tlPlaced').replaceChildren();for(const x of rows){const p=document.createElement('button');p.textContent=(x.fixed?'固定 · ':'')+x.title+' '+TL.clock(x.start)+' / '+(x.endAbs===null?'終了不明':x.duration?x.duration+'分':Math.round(x.endAbs-x.startAbs)+'分');p.addEventListener('click',()=>tlEdit(x));$('tlPlaced').append(p)}\\n $('tlNotes').replaceChildren();for(const n of notes){const p=document.createElement('p');p.className='tlNote '+({'!':'red','+':'green','−':'amber','?':'neutral'}[n.sign]);const unchanged=before&&before.some(x=>x.sign===n.sign&&x.text===n.text);p.textContent=(before&&!unchanged?'変更後 · ':'')+n.sign+' '+n.text;$('tlNotes').append(p)}if(before){for(const n of before.filter(n=>n.sign==='!'&&!notes.some(x=>x.sign===n.sign&&x.text===n.text))){const p=document.createElement('p');p.className='tlNote green';p.textContent='+ 解消候補：'+n.text;$('tlNotes').append(p)}}for(const b of $('tlGrid').querySelectorAll('.tlBlock')){const related=notes.filter(n=>n.ids.includes(b.dataset.eventId));b.classList.toggle('conflict',related.some(n=>n.sign==='!'));b.classList.toggle('linked',related.some(n=>n.sign==='+'));b.classList.toggle('separated',related.some(n=>n.sign==='−'));b.dataset.impact=related.some(n=>n.sign==='!')?'!':related.some(n=>n.sign==='−')?'−':related.some(n=>n.sign==='+')?'+':related.some(n=>n.sign==='?')?'?':'';}return notes;}\\n function renderTimeline(){\\n if(!window.YOSTimeline||!$('tlGrid'))return;\\n $('tlHomeTitle').textContent=state.selected===today?'今日のタイムライン':'1日のタイムライン';\\n $('tlDay').value=state.selected;\\n const dayDate=new Date(state.selected+'T12:00:00+09:00');\\n $('tlDateTitle').textContent=new Intl.DateTimeFormat('ja-JP',{timeZone:tz,month:'long',day:'numeric',weekday:'short'}).format(dayDate);\\n const inRange=state.native&&state.selected>=state.native.range.start&&state.selected<=state.native.range.end;\\n $('tlDayLabel').textContent=state.native?(inRange?(state.native.sources?.apple?.status==='ok'&&state.native.sources?.tasks?.status==='ok'?'取得分を表示':'取得分のみ・未取得あり'):'取得範囲外・未確認'):'元予定未接続';\\n $('tlSourceDot').setAttribute('aria-label',state.native?'元データ受信・詳細は記録と連携':'元データ未接続');\\n $('tlSourceDot').style.opacity=state.native?'1':'.45';\\n $('tlHabitStatus').textContent=habitSource?.status==='ok'?'既存の生活導線ファイルを読み取り済み':habitSource?.status==='error'?'既存の生活導線ファイルを確認できませんでした（元ファイルは変更していません）':'既存の生活導線ファイルは未接続・未確認';\\n const grid=$('tlGrid');grid.replaceChildren();for(let h=0;h<=24;h++){const line=document.createElement('div');line.className='tlHour';line.style.top=h*60*TL.PX+'px';line.textContent=String(h).padStart(2,'0')+':00';grid.append(line)}\\n const rows=tlRows(),notes=TL.impact(rows),conflicts=new Set(notes.filter(n=>n.sign==='!').flatMap(n=>n.ids));\\n // Overlapping blocks occupy separate columns so each title remains reachable.\\n const lanes=[];for(const item of rows.slice().sort((a,b)=>a.start-b.start)){let lane=lanes.findIndex(end=>end<=item.start);if(lane<0)lane=lanes.length;lanes[lane]=item.end;item.lane=lane}const columns=Math.max(1,lanes.length);\\n for(const item of rows){const b=document.createElement('button');b.dataset.eventId=item.id;b.type='button';b.className='tlBlock'+(item.fixed?' fixed':'')+(conflicts.has(item.id)?' conflict':'');b.style.top=item.top+'px';b.style.height=Math.max(item.height,4)+'px';b.style.left='calc(58px + (100% - 110px) * '+item.lane+'/'+columns+')';b.style.width='calc((100% - 110px) / '+columns+' - 4px)';const time=TL.clock(item.start)+'–'+(item.endAbs===null?'終了不明':TL.clock(item.end));b.textContent=(item.fixed?'固定 · ':'')+item.title+' '+time+(item.continuesBefore?' ←前日':'')+(item.continuesAfter?' 翌日→':'');b.setAttribute('aria-label',b.textContent+'。'+(item.fixed?'元データは変更不可':'押すと時刻編集。長押しで移動。矢印キーで5分移動'));b.title=b.textContent;b.dataset.kind=item.kind;b.classList.toggle('completed',tlDone(item));const label=b.textContent;b.replaceChildren();const icon=document.createElement('span');icon.className='tlCardIcon';icon.innerHTML=tlIcon(tlDone(item)?'check':item.kind);const words=document.createElement('span');words.className='tlCardWords';const title=document.createElement('strong');title.textContent=(item.fixed?'固定 · ':'')+item.title;const meta=document.createElement('span');meta.textContent=time+(tlDone(item)?' · 実施済み':'')+(item.continuesBefore?' · 前日から':'')+(item.continuesAfter?' · 翌日へ':'');words.append(title,meta);b.append(icon,words);b.addEventListener('click',()=>{if(!b._dragged)tlEdit(item);b._dragged=false});\\n if(!item.fixed){b.addEventListener('keydown',e=>{if(['ArrowUp','ArrowDown'].includes(e.key)){e.preventDefault();tlMove(item,item.startAbs-TL.minute(item.occurrenceDate)+(e.key==='ArrowUp'?-5:5))}});const handle=document.createElement('button');handle.type='button';handle.className='tlDrag';handle.textContent='↕';handle.style.top=item.top+'px';handle.setAttribute('aria-label',item.title+'を長押しで移動');grid.append(handle);let timer=null,active=false,startY=0,startMinute=0,lastY=0;const cancel=()=>{clearTimeout(timer);timer=null};handle.addEventListener('pointerdown',e=>{if(saving)return;startY=lastY=e.clientY;startMinute=item.startAbs-TL.minute(item.occurrenceDate);b._dragged=false;timer=setTimeout(()=>{active=true;handle.setPointerCapture(e.pointerId);b.classList.add('dragging');},450)});handle.addEventListener('pointermove',e=>{lastY=e.clientY;if(!active){if(Math.abs(lastY-startY)>8)cancel();return}e.preventDefault();b._dragged=true;const shift=Math.round((lastY-startY)/TL.PX/5)*5;b.style.transform='translateY('+(shift*TL.PX)+'px)';const m=Math.max(0,Math.min(1439,startMinute+shift)),delta=TL.minute(item.occurrenceDate)+m-item.startAbs;const candidate=rows.map(r=>r.id===item.id?{...r,startAbs:r.startAbs+delta,endAbs:r.endAbs+delta}:r);const effects=tlImpact(candidate,notes);const sorted=candidate.slice().sort((a,b)=>a.startAbs-b.startAbs),i=sorted.findIndex(r=>r.id===item.id);$('tlStatus').textContent='仮移動 '+TL.clock(m)+' · 前：'+(sorted[i-1]?.title||'なし')+'／後：'+(sorted[i+1]?.title||'なし')+' · 離すと配置';const impact=effects.filter(n=>n.ids.includes(item.id)).sort((a,b)=>['!','−','+','?'].indexOf(a.sign)-['!','−','+','?'].indexOf(b.sign))[0];$('tlFeedback').textContent=TL.clock(m)+' · 前：'+(sorted[i-1]?.title||'なし')+'／後：'+(sorted[i+1]?.title||'なし')+'\\\\n'+(impact?impact.sign+' '+impact.text:'配置の影響は確認できていません')+' · 離すと配置';$('tlFeedback').hidden=false;});handle.addEventListener('pointerup',()=>{cancel();$('tlFeedback').hidden=true;if(active){active=false;b._dragged=true;tlMove(item,startMinute+(lastY-startY)/TL.PX)}});handle.addEventListener('pointercancel',()=>{cancel();$('tlFeedback').hidden=true;active=false;b.style.transform='';tlImpact(rows);});}grid.append(b)}\\n if(state.selected===today){const parts=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(new Date()).split(':');const minute=Number(parts[0])*60+Number(parts[1]);const now=document.createElement('div');now.className='tlNow';now.textContent='現在';now.style.top=minute*TL.PX+'px';now.setAttribute('aria-label','現在 '+TL.clock(minute));grid.append(now);if(tlLastScrolledDay!==state.selected){$('tlViewport').scrollTop=Math.max(0,(minute-45)*TL.PX)}}else if(tlLastScrolledDay!==state.selected){$('tlViewport').scrollTop=0}tlLastScrolledDay=state.selected;\\n tlImpact(rows);\\n $('tlUnplaced').replaceChildren();const fixedIds=new Set(rows.filter(x=>x.fixed).map(x=>x.id));const source=[...(state.native?state.native.items:state.items),...tlHabitRows()];const seen=new Set();for(const x of source.filter(x=>x.date===state.selected&&['task','habit','schedule'].includes(x.type))){const id=x.source+':'+x.id;if(!x.id||seen.has(id)||fixedIds.has(id)||timeline.events.some(e=>e.sourceRef===id&&TL.occurs(e,state.selected)))continue;seen.add(id);const b=document.createElement('button');b.textContent=(x.potentialMirror?'重複の可能性・要照合 · ':'')+(x.type==='habit'?'習慣':x.type==='schedule'?'予定':'タスク')+' · '+x.title+(x.subtitle==='終日'?'（終日・固定）':'（時刻／所要時間未設定）');b.addEventListener('click',()=>{if(x.type==='schedule'||x.fixedTime){$('tlStatus').textContent='終日・時刻確定の元予定は固定です。元の予定を確認してください。';return}tlNew();$('tlTitle').value=x.title;$('tlSourceRef').value=id;$('tlKind').value=x.type==='habit'?'habit':'task';$('tlRepeat').value=x.repeat||'none'});$('tlUnplaced').append(b)}if(!$('tlUnplaced').children.length)$('tlUnplaced').textContent='取得範囲の未配置データなし。未取得＝予定なしではありません。';\\n $('tlUnplacedCount').textContent=String(seen.size);tlRenderAgenda(rows);tlRenderTabs(rows);tlApplyView();\\n $('tlUndo').disabled=!undoStack.length||saving;$('tlSave').disabled=!nativeSave||saving;$('tlSave').textContent=saving?'保存中…':'保存';$('tlState').textContent=saving?'保存確認中':timelineDirty?'変更あり・未保存':savedVerified?'端末保存・読み戻し確認済み':'仮配置／端末保存は未確認';\\n }\\n function tlNew(){tlEditingOccurrence=null;$('tlComplete').hidden=true;$('tlDelete').hidden=true;$('tlHabitsDialog').close();$('tlDrawer').close();$('tlError').textContent='';$('tlForm').reset();$('tlId').value='';$('tlSourceRef').value='';$('tlDate').value=state.selected;$('tlTime').value='09:00';$('tlDuration').value=30;$('tlTransfer').value=0;$('tlScope').hidden=true;$('tlEditor').showModal()}\\n $('tlComplete').addEventListener('click',()=>{if(tlEditingOccurrence){tlToggleDone(tlEditingOccurrence);$('tlEditor').close()}});\\n $('tlDelete').addEventListener('click',()=>{const id=$('tlId').value;if(!id||saving)return;if(!confirm('この端末の配置から外します。繰り返しがある場合は全体が対象です。保存前は「戻す」で取り消せます。元データは変更しません。'))return;tlMutate(()=>{timeline.events=timeline.events.filter(e=>e.id!==id);for(const store of ['overrides','completed'])for(const key of Object.keys(timeline[store]||{}))if(key.startsWith(id+'@'))delete timeline[store][key]});$('tlEditor').close()});\\n $('tlAdd').addEventListener('click',tlNew);$('tlCancel').addEventListener('click',()=>$('tlEditor').close());$('tlUndo').addEventListener('click',()=>{if(saving||!undoStack.length)return;timeline=undoStack.pop();timelineDirty=true;renderTimeline()});\\n $('tlForm').addEventListener('submit',e=>{e.preventDefault();if(saving)return;const id=$('tlId').value||'local:'+Date.now().toString(36)+':'+Math.random().toString(36).slice(2,10),d=$('tlDate').value,t=$('tlTime').value;const record={id,title:$('tlTitle').value.trim(),date:d,start:Number(t.slice(0,2))*60+Number(t.slice(3)),duration:Number($('tlDuration').value),kind:$('tlKind').value,repeat:$('tlRepeat').value,transfer:Number($('tlTransfer').value),...($('tlSourceRef').value?{sourceRef:$('tlSourceRef').value}:{})};if(!TL.validEvent(record)){$('tlError').textContent='日付・時刻・所要時間を確認してください';return}tlMutate(()=>{const i=timeline.events.findIndex(x=>x.id===id);if(i>=0&&$('tlScope').value==='instance'){timeline.overrides[id+'@'+d]={start:record.start,duration:record.duration};}else{if(i>=0){timeline.events[i]=record;for(const k of Object.keys(timeline.overrides))if(k.startsWith(id+'@'))delete timeline.overrides[k];for(const k of Object.keys(timeline.completed||{}))if(k.startsWith(id+'@')&&!TL.occurs(record,k.slice(-10)))delete timeline.completed[k]}else timeline.events.push(record)}});$('tlEditor').close()});\\n $('tlDay').addEventListener('change',()=>{if(TL.day($('tlDay').value))setDay($('tlDay').value)});for(const [id,delta] of [['tlPrev',-1],['tlNext',1]])$(id).addEventListener('click',()=>{const k=TL.plus(state.selected,delta);setDay(k)});\\n $('tlWallpaper').addEventListener('change',()=>{$('tlPanel').dataset.wallpaper=$('tlWallpaper').value;$('tlFrame').dataset.wallpaper=$('tlWallpaper').value});$('tlTheme').addEventListener('change',()=>{$('tlPanel').dataset.theme=$('tlTheme').value;$('tlFrame').dataset.theme=$('tlTheme').value});\\n $('tlSettings').addEventListener('click',()=>$('tlSettingsDialog').showModal());$('tlCloseSettings').addEventListener('click',()=>$('tlSettingsDialog').close());$('tlOpenTray').addEventListener('click',()=>$('tlDrawer').showModal());$('tlCloseTray').addEventListener('click',()=>$('tlDrawer').close());$('tlDateButton').addEventListener('click',()=>$('openMonth').click());\\n \\n const oldImport=window.YOS_DAYSTREAM_PLAN_IMPORT,oldExport=window.YOS_DAYSTREAM_PLAN_EXPORT;\\n window.YOS_DAYSTREAM_PLAN_IMPORT=function(v){if(v.timeline&&!TL.valid(v.timeline))return false;const ok=oldImport(v);if(ok){timeline=v.timeline?clone(v.timeline):{version:1,events:[],overrides:{}};timelineDirty=false;savedVerified=true;renderTimeline()}return ok};\\n window.YOS_DAYSTREAM_PLAN_EXPORT=function(){return {...oldExport(),timeline:clone(timeline),completedKeys:[]}};\\n window.YOS_DAYSTREAM_ATTACH_SAVE=function(fn){nativeSave=fn;renderTimeline();return true};\\n window.YOS_TIMELINE_SAVED=function(ok){saving=false;if(ok){timelineDirty=false;savedVerified=true;$('tlStatus').textContent='計画と端末内の実施記録の保存・読み戻しを確認しました。Apple／Notionへは反映していません。'}else $('tlStatus').textContent='保存未確認。画面の変更は残っています。既存ファイルを確認してください。';renderTimeline();return true};\\n $('tlSave').addEventListener('click',()=>{if(!nativeSave||saving)return;if(!confirm('計画と端末内の実施記録を保存します。Apple・Notionは変更しません。保存しますか？'))return;saving=true;renderTimeline();nativeSave(window.YOS_DAYSTREAM_PLAN_EXPORT())});\\n window.YOS_TIMELINE_DEBUG={getData:()=>clone(timeline),rows:tlRows,render:renderTimeline};\\n\\n function tlRenderTabs(rows){\\n const list=$('tlHabitList');list.replaceChildren();const habits=tlHabitRows();for(const h of habits){const sourceRef=h.source+':'+h.id,placed=rows.filter(r=>r.sourceRef===sourceRef&&r.occurrenceDate===state.selected);const card=document.createElement('div');card.className='tlHabitCard';const title=document.createElement('strong');title.textContent=h.title;const meta=document.createElement('p');meta.textContent=placed.length?'配置済み · '+placed.map(x=>TL.clock(x.start)).join(' / '):'選択日は未配置';const button=document.createElement('button');button.textContent=placed.length?'配置を開く':'時刻を決めて配置';button.addEventListener('click',()=>{if(placed.length){$('tlHabitsDialog').close();tlEdit(placed[0])}else{tlNew();$('tlTitle').value=h.title;$('tlSourceRef').value=sourceRef;$('tlKind').value='habit';$('tlRepeat').value=h.repeat||'none'}});card.append(title,meta,button);list.append(card)}if(!habits.length){const p=document.createElement('p');p.textContent=habitSource?.status==='ok'?'選択日に該当する既存習慣はありません。':$('tlHabitStatus').textContent;list.append(p)}\\n const local=rows.filter(r=>!r.fixed&&r.occurrenceDate===state.selected);$('tlReviewSummary').textContent=state.selected+' · 計画 '+local.length+'件 / 実施チェック '+local.filter(tlDone).length+'件'+(timelineDirty?' · 未保存の変更あり':'');$('tlReviewList').replaceChildren();for(const r of local){const b=document.createElement('button');b.className='tlReviewItem';b.textContent=(tlDone(r)?'実施済み · ':'未実施 · ')+r.title+' '+TL.clock(r.start);b.setAttribute('aria-pressed',String(tlDone(r)));b.disabled=saving;b.addEventListener('click',()=>tlToggleDone(r.id));$('tlReviewList').append(b)}if(!local.length)$('tlReviewList').textContent='この日の端末内の計画はありません。元予定の実施状況は判定していません。';\\n }\\n for(const [id,dialog] of [['tlTabHabits','tlHabitsDialog'],['tlTabReview','tlReviewDialog'],['tlTabSettings','tlSettingsDialog']])$(id).addEventListener('click',()=>$(dialog).showModal());\\n for(const [id,dialog] of [['tlCloseHabits','tlHabitsDialog'],['tlCloseReview','tlReviewDialog']])$(id).addEventListener('click',()=>$(dialog).close());\\n $('tlTabTimeline').addEventListener('click',()=>{for(const id of ['tlHabitsDialog','tlReviewDialog','tlSettingsDialog'])$(id).close();$('tlViewport').focus?.()});tlDecorate();\\n\\n function tlPeriodView(mode){const root=$('tlPeriodList');root.replaceChildren();const y=Number(state.selected.slice(0,4));$('tlPeriodTitle').textContent=mode==='week'?'選択日から7日間':y+'年';if(mode==='week'){for(let i=0;i<7;i++){const day=TL.plus(state.selected,i);const local=TL.instances(timeline,day).map(x=>TL.clip(x,day)).filter(Boolean),fixed=TL.fixed(state.native?.items||[],timeline.fixedBuffers||{}).map(x=>TL.clip(x,day)).filter(Boolean);const known=state.native&&day>=state.native.range.start&&day<=state.native.range.end&&state.native.sources?.apple?.status==='ok'&&state.native.sources?.tasks?.status==='ok';const b=document.createElement('button');b.textContent=day+' · 端末の配置 '+local.length+'件 · '+(known?'取得した元予定 '+fixed.length+'件':'元予定 未確認（取得分 '+fixed.length+'件）');b.addEventListener('click',()=>{setDay(day);$('tlPeriodDialog').close()});root.append(b)}}else{for(let m=1;m<=12;m++){const month=y+'-'+String(m).padStart(2,'0');const b=document.createElement('button');b.textContent=m+'月';b.addEventListener('click',()=>{state.month=month;renderMonth();$('tlPeriodDialog').close();$('monthDialog').showModal()});root.append(b)}}$('tlPeriodDialog').showModal()}\\n $('tlPeriodWeek').addEventListener('click',()=>tlPeriodView('week'));$('tlPeriodYear').addEventListener('click',()=>tlPeriodView('year'));$('tlPeriodMonth').addEventListener('click',()=>{state.month=state.selected.slice(0,7);$('openMonth').click()});$('tlPeriodDay').addEventListener('click',()=>{$('tlPeriodDialog').close();$('monthDialog').close()});$('tlClosePeriod').addEventListener('click',()=>$('tlPeriodDialog').close());\\n\\n function tlApplyView(){const edit=tlView==='edit';$('tlFrame').dataset.view=tlView;$('tlFrame').dataset.skin=tlSkin;$('tlHomeTitle').textContent=tlSkin==='glass'?'1日のタイムライン':state.selected===today?'今日のタイムライン':'1日のタイムライン';$('tlEnterEdit').textContent=timelineDirty?'編集 · 未保存':'編集';$('tlGrid').hidden=!edit;$('tlAgenda').hidden=edit;$('tlEditHeader').hidden=!edit;$('tlScaleLabel').textContent=edit?'0–24時 · 1分＝2px':'実行順';$('tlViewport').setAttribute('aria-label',edit?'0時から24時のタイムライン・1分2px':'選択日の実行順の一覧');}\\n function tlSetView(view){if(view===tlView)return;const scroll=$('tlViewport').scrollTop; if(tlView==='home')tlHomeScroll=scroll;else tlEditScroll=scroll;tlView=view;tlApplyView();$('tlViewport').scrollTop=view==='home'?tlHomeScroll:tlEditScroll;}\\n let tlHomeScroll=0,tlEditScroll=0;\\n function tlRenderAgenda(rows){const root=$('tlAgenda');root.replaceChildren();const rules=TL.impact(rows);$('tlLegendRecommended').hidden=!rules.some(n=>n.sign==='+');const ordered=rows.slice().sort((a,b)=>a.start-b.start||a.id.localeCompare(b.id));let homeBottom=-1;for(const item of ordered){const row=document.createElement('div');row.className='tlAgendaRow';row.dataset.kind=item.kind;const time=document.createElement('time');time.className='tlAgendaTime';time.textContent=TL.clock(item.start);const dot=document.createElement('span');dot.className='tlAgendaDot';dot.setAttribute('aria-hidden','true');const b=document.createElement('button');b.type='button';b.className='tlAgendaCard';b.dataset.kind=item.kind;b.dataset.eventId=item.id;b.classList.toggle('completed',tlDone(item));if(item.fixed)b.classList.add('fixed');const icon=document.createElement('span');icon.className='tlCardIcon';icon.innerHTML=tlIcon(tlDone(item)?'check':item.kind);const title=document.createElement('strong');title.textContent=item.title;const duration=document.createElement('span');duration.className='tlAgendaDuration';duration.textContent=item.endAbs===null?'終了不明':Math.round(item.endAbs-item.startAbs)+'分';b.setAttribute('aria-label',TL.clock(item.start)+' '+item.title+' '+duration.textContent+(item.fixed?'・固定予定':'・押すと編集')+(tlDone(item)?'・この端末で実施済み':''));b.addEventListener('click',()=>tlEdit(item));const actualTime=document.createElement('span');actualTime.className='tlAgendaActualTime';actualTime.textContent=TL.clock(item.start)+'–'+(item.endAbs===null?'終了不明':TL.clock(item.end))+(item.continuesBefore?' · 前日から':'')+(item.continuesAfter?' · 翌日へ':'');b.append(icon,title,duration,actualTime);const rule=rules.find(n=>n.ids.includes(item.id)&&n.sign==='!')||rules.find(n=>n.ids.includes(item.id)&&n.sign==='+');if(rule){const brief=document.createElement('span');brief.className='tlAgendaRule '+(rule.sign==='!'?'red':'green');brief.textContent=rule.sign==='!'?'! '+rule.text:'+ 習慣をつなぐ配置（設定ルール）';b.append(brief);if(rule.sign==='+')b.classList.add('tlRuleCandidate')}row.append(time,dot,b);if(tlSkin==='glass'){const exact=Math.round(item.start*.8),height=Math.max(60,Math.round((item.end-item.start)*.8)),top=Math.max(exact,homeBottom+8);row.style.top=top+'px';row.style.height=height+'px';row.dataset.railShift=top>exact?'overlap':'none';homeBottom=top+height;}root.append(row)}root.style.height=tlSkin==='glass'?Math.max(1196,homeBottom+60)+'px':'';if(!ordered.length){const empty=document.createElement('div');empty.className='tlAgendaEmpty';const title=document.createElement('strong');title.textContent='この日の配置はまだありません';const p=document.createElement('p');p.textContent='＋から行動を追加できます。取得していない元予定は表示されません。';empty.append(title,p);root.append(empty)}if(tlHomeScrolledDay!==state.selected){tlHomeScroll=tlSkin==='glass'&&state.selected===today?288:0;tlEditScroll=$('tlViewport').scrollTop;if(tlView==='home')$('tlViewport').scrollTop=tlHomeScroll;tlHomeScrolledDay=state.selected}}\\n $('tlEnterEdit').addEventListener('click',()=>tlSetView('edit'));$('tlExitEdit').addEventListener('click',()=>tlSetView('home'));\\n\\n $('tlSkin').addEventListener('change',()=>{tlSkin=$('tlSkin').value==='compact'?'compact':'glass';tlHomeScrolledDay=null;renderTimeline()});$('tlCalendar').addEventListener('click',()=>{state.month=state.selected.slice(0,7);$('openMonth').click()});\\n\\n load(false);\\n})();\\n</script>\\n</body></html>\";\n// Compatibility marker for the already-installed iPhone launcher; actual HTML integrity is checked against HTML_SHA256.\nconst INSTALLED_LAUNCHER_MARKER = 'b31ebae6e68de7f8d718cb28bd849e808efb147aedaa78b7e7b0c1b491655e90';\nfunction sha256Hex(input){\n  const K=[\n    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\n  ];\n  const H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];\n  const bytes=Array.from(unescape(encodeURIComponent(input)),c=>c.charCodeAt(0));\n  const bitLength=bytes.length*8;\n  if(bitLength>=0x20000000000000)throw Error('sha256 payload too long');\n  bytes.push(0x80);while(bytes.length%64!==56)bytes.push(0);\n  const high=Math.floor(bitLength/0x100000000),low=bitLength>>>0;\n  for(let i=3;i>=0;i--)bytes.push((high>>>i*8)&255);\n  for(let i=3;i>=0;i--)bytes.push((low>>>i*8)&255);\n  const rr=(x,n)=>(x>>>n)|(x<<(32-n));\n  for(let at=0;at<bytes.length;at+=64){\n    const w=new Array(64).fill(0);\n    for(let i=0;i<16;i++)w[i]=(bytes[at+i*4]<<24)|(bytes[at+i*4+1]<<16)|(bytes[at+i*4+2]<<8)|bytes[at+i*4+3];\n    for(let i=16;i<64;i++){\n      const a=w[i-15],b=w[i-2],s0=rr(a,7)^rr(a,18)^(a>>>3),s1=rr(b,17)^rr(b,19)^(b>>>10);\n      w[i]=(w[i-16]+s0+w[i-7]+s1)>>>0;\n    }\n    let [a,b,c,d,e,f,g,h]=H;\n    for(let i=0;i<64;i++){\n      const s1=rr(e,6)^rr(e,11)^rr(e,25),ch=(e&f)^((~e)&g),t1=(h+s1+ch+K[i]+w[i])>>>0;\n      const s0=rr(a,2)^rr(a,13)^rr(a,22),maj=(a&b)^(a&c)^(b&c),t2=(s0+maj)>>>0;\n      h=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b;b=a;a=(t1+t2)>>>0;\n    }\n    for(const [i,x] of [a,b,c,d,e,f,g,h].entries())H[i]=(H[i]+x)>>>0;\n  }\n  return H.map(v=>v.toString(16).padStart(8,'0')).join('');\n}\n\nconst NOTION_KEY = 'YOS_NOTION_INTEGRATION_TOKEN'; // existing Scriptable key: never shared with WebView\nconst TASK_SOURCE = '965c6086-32c1-463d-93b4-87a9cb69b3ad'; // existing YOS Tasks\nconst MONEY_SOURCE = '95b30d16-7530-40c6-a320-dab99acad55d'; // existing 家計イベント・入出金予定\nconst TZ='Asia/Tokyo';\nconst dateKey=d=>new Intl.DateTimeFormat('sv-SE',{timeZone:TZ,year:'numeric',month:'2-digit',day:'2-digit'}).format(d);\nconst addDays=(date,n)=>{const d=new Date(date.getFullYear(),date.getMonth(),date.getDate()+n,12);return d};\nconst clean=(value,limit=120)=>String(value??'').replace(/[\\u0000-\\u001F\\u007F]/g,' ').trim().slice(0,limit);\nconst rich=(value,type)=>Array.isArray(value?.[type])?clean(value[type].map(x=>x.plain_text||x.text?.content||'').join(''),120):'';\nconst select=x=>clean(x?.select?.name,30);\nconst dateVal=x=>{const raw=x?.date?.start;if(typeof raw!=='string')return '';if(/^\\d{4}-\\d{2}-\\d{2}$/.test(raw))return raw;const d=new Date(raw);return Number.isFinite(d.getTime())?dateKey(d):'';};\nconst validDay=k=>/^\\d{4}-\\d{2}-\\d{2}$/.test(k);\n\nasync function queryNotion(source,field,start,end,token){\n  const result=[],filter={and:[\n    {property:field,date:{on_or_after:start}},\n    {property:field,date:{on_or_before:end}}\n  ]};\n  let cursor=null;\n  for(let page=0;page<4;page++){\n    const req=new Request('https://api.notion.com/v1/data_sources/'+source+'/query');\n    req.method='POST';req.headers={\n      Authorization:'Bearer '+token,'Content-Type':'application/json',\n      'Notion-Version':'2026-03-11',Accept:'application/json'\n    };\n    req.timeoutInterval=8;\n    req.body=JSON.stringify({page_size:100,filter,...(cursor?{start_cursor:cursor}:{})});\n    const res=await req.loadJSON();\n    if(req.response?.statusCode!==200 || !res || !Array.isArray(res.results))throw Error('Notion query unavailable');\n    result.push(...res.results);\n    if(res.has_more!==true)return {rows:result,complete:true};\n    if(typeof res.next_cursor!=='string'||!res.next_cursor)throw Error('Notion cursor missing');\n    cursor=res.next_cursor;\n  }\n  return {rows:result,complete:false};\n}\nfunction parseTask(row){\n  const p=row?.properties;if(!p)return null;\n  const title=rich(p['やること'],'title'),date=dateVal(p['期限']),status=select(p['状態']);\n  if(!title||!validDay(date)||['中止','完了','キャンセル','取り消し'].includes(status))return null;\n  const nextAction=rich(p['次の一手'],'rich_text'),completion=rich(p['完了条件'],'rich_text'),blocker=rich(p['ブロッカー'],'rich_text');\n  const provenance=rich(p['正本・根拠'],'rich_text'),syncKey=rich(p['同期キー'],'rich_text');\n  // Only calendar-origin copies may be hidden. Never infer a mirror from title alone.\n  const calendarMirror=provenance==='Apple Calendar'||syncKey.startsWith('calendar:');\n  // A human-added action or blocker remains independently actionable, even with a matching event.\n  const explicitAction=Boolean(nextAction.trim()||completion.trim()||blocker.trim());\n  const priority=select(p['優先度']),order=p['実行順']?.number;\n  const rawStart=p['期限']?.date?.start,ts=typeof rawStart==='string'&&rawStart.includes('T')?new Date(rawStart):null;\n  const fixedTime=ts&&Number.isFinite(ts.getTime())?new Intl.DateTimeFormat('ja-JP',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).format(ts):'';\n  return {type:'task',date,title,subtitle:status||'状態未確認',nextAction,completion,blocker,done:false,source:'Notion Tasks',id:clean(row.id||'',70),startISO:ts&&Number.isFinite(ts.getTime())?ts.toISOString():'',endISO:p['期限']?.date?.end&&Number.isFinite(Date.parse(p['期限'].date.end))?new Date(p['期限'].date.end).toISOString():'',calendarMirror,explicitAction,syncKey,\n    priority:['P0','P1','P2','P3'].includes(priority)?priority:'',order:Number.isFinite(order)?order:null,fixedTime};\n}\nfunction parseMoney(row){\n  const p=row?.properties;if(!p)return null;\n  const title=rich(p['項目'],'title'),date=dateVal(p['日付']),amount=p['金額']?.number;\n  const category=select(p['区分']),status=select(p['状態']),verification=select(p['確度']);\n  if(!title||!validDay(date)||!Number.isFinite(amount)||amount<0||amount>1000000000||status==='取消')return null;\n  const kind=category==='収入'?'income':category==='支出'?'expense':null;\n  if(!kind)return null; // Exclude transfers, avoiding double counting.\n  const complete=status==='実績'&&verification==='確認済';\n  const reviewRequired=status==='実績'&&!complete;\n  const subtitle=complete?'実績（確認済）':status==='実績'?'実績報告（要照合）':verification==='確認済'?'予定（確認済）':'予定・未確認';\n  return {type:'money',date,title,subtitle,amount:Math.round(amount),moneyKind:kind,complete,reviewRequired,source:'Notion家計',id:clean(row.id||title,70)};\n}\nasync function readApple(start,end){\n  try{\n    const from=new Date(start+'T00:00:00+09:00'),to=new Date(end+'T00:00:00+09:00');\n    to.setDate(to.getDate()+1);\n    const events=await CalendarEvent.between(from,to);\n    // Remove reference-only taxi-demand entries before applying the display cap.\n    // Otherwise 250 reference events can crowd out genuine appointments.\n    const eligible=(Array.isArray(events)?events:[]).filter(x=>\n      x?.title&&!/^[\\s　]*[［\\[【]\\s*タクシー需要/.test(x.title)&&\n      !/タクシー需要/.test(x.calendar?.title||'')\n    );\n    // Deduplicate visually identical all-day events (e.g. holidays imported\n    // from multiple calendars). Timed appointments and source data stay intact.\n    const seen=new Set();const unique=eligible.filter(x=>{if(!x.identifier)return true;const id=String(x.identifier)+'|'+String(x.startDate);if(seen.has(id))return false;seen.add(id);return true});\n    const rows=unique.slice(0,170).flatMap((x,i)=>{\n      const begin=new Date(x.startDate);if(!Number.isFinite(begin.getTime()))return [];\n      const date=dateKey(begin);\n      if(date>end)return [];\n      const endDate=x.endDate?new Date(x.endDate):null;\n      if(date<start&&(!endDate||dateKey(endDate)<start))return [];\n      const time=x.isAllDay?'終日':new Intl.DateTimeFormat('ja-JP',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).format(begin);\n      return [{type:'schedule',date,title:clean(x.title,100),subtitle:time,source:'Appleカレンダー',id:clean(x.identifier||'missing-id:'+i,70),startISO:x.isAllDay?'':begin.toISOString(),endISO:!x.isAllDay&&endDate&&Number.isFinite(+endDate)?endDate.toISOString():'',allDay:!!x.isAllDay}];\n    });\n    return {status:unique.length>170?'partial':'ok',rows};\n  }catch{return {status:'error',rows:[]}};\n}\nasync function readNotion(source,field,parse,start,end,token){\n  if(!token)return {status:'unavailable',rows:[]};\n  try{\n    const result=await queryNotion(source,field,start,end,token);\n    const parsed=result.rows.map(parse).filter(Boolean);\n    return {status:result.complete&&parsed.length<=165?'ok':'partial',rows:parsed.slice(0,165)};\n  }catch{return {status:'error',rows:[]}};\n}\nasync function readPreview(){const html=HTML_BUNDLE;if(sha256Hex(html)!==HTML_SHA256)throw Error('Offline DAYSTREAM HTML integrity mismatch');return html;}\n// Native-only status transition for user-confirmed, already-loaded Notion Tasks.\n// No access token, page mutation, or FileManager state ever crosses to WebView.\nconst PLAN_FILE='YOS_DAYSTREAM_TIMELINE_REVIEW_v1.json';\nconst TASK_ID=/^[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}$/i;\nconst EDITABLE_STATES=new Set(['次にやる','実行中','本人操作']);\nfunction normalizePlanFile(value){\n  if(!value||value.schema!=='yos-daystream-plan-v1'||!value.days||\n    typeof value.days!=='object'||Array.isArray(value.days))return null;\n  if(Object.keys(value.days).length>30)return null;\n  const days={};\n  for(const [day,d] of Object.entries(value.days)){\n    if(!validDay(day)||!d||typeof d!=='object'||Array.isArray(d))return null;\n    if(!Array.isArray(d.order)||d.order.length>300||!d.done||typeof d.done!=='object'||Array.isArray(d.done))return null;\n    const order=[];\n    for(const key of d.order){if(typeof key!=='string'||key.length>180)return null;order.push(key)}\n    const done={},entries=Object.entries(d.done);\n    if(entries.length>300)return null;\n    for(const [key,val] of entries){if(key.length>180||val!==true)return null;done[key]=true}\n    days[day]={order,done};\n  }\n  if(value.timeline&&!YOSTimeline.valid(value.timeline))return null;\n  return {schema:'yos-daystream-plan-v1',days,...(value.timeline?{timeline:value.timeline}:{})};\n}\nfunction planStore(){\n  if(typeof FileManager==='undefined'||typeof FileManager.local!=='function')return null;\n  const fm=FileManager.local();return {fm,path:fm.joinPath(fm.documentsDirectory(),PLAN_FILE)};\n}\nfunction readLocalPlan(store){\n  if(!store||!store.fm.fileExists(store.path))return {value:null,blocked:false};\n  try{\n    const raw=store.fm.readString(store.path);\n    if(typeof raw!=='string'||raw.length>100000)return {value:null,blocked:true};\n    const parsed=normalizePlanFile(JSON.parse(raw));\n    return parsed?{value:parsed,blocked:false}:{value:null,blocked:true};\n  }catch{return {value:null,blocked:true}}\n}\nfunction saveLocalPlan(store,data){\n  if(!store)return false;\n  const cleanData=normalizePlanFile(data);if(!cleanData)return false;\n  const payload=JSON.stringify(cleanData);\n  if(payload.length>100000)return false;\n  let before=null;\n  try{before=store.fm.fileExists(store.path)?store.fm.readString(store.path):null;if(before!==null)store.fm.writeString(store.path+'.previous',before);store.fm.writeString(store.path,payload);if(store.fm.readString(store.path)===payload)return true;}catch{}\n  try{if(before!==null){store.fm.writeString(store.path,before);if(store.fm.readString(store.path)!==before)return false;}else if(store.fm.fileExists(store.path)&&typeof store.fm.remove==='function')store.fm.remove(store.path);}catch{}\n  return false;\n}\n\nfunction readHabitSource(){\n try{const fm=FileManager.local(),p=fm.joinPath(fm.documentsDirectory(),'YOS_HABIT_FLOW_v1.json');if(!fm.fileExists(p))return {status:'unavailable',lists:{daily:[],weekly:[],monthly:[],yearly:[]}};const raw=fm.readString(p);if(typeof raw!=='string'||raw.length>=65000)return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};const v=JSON.parse(raw);if(v.schema!=='yos-habit-flow-v1'||v.version!==1||!v.lists)return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};const seen=new Set();let count=0;for(const period of ['daily','weekly','monthly','yearly']){const xs=v.lists[period];if(!Array.isArray(xs)||xs.length>40)return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};for(const x of xs){if(!x||! /^[a-zA-Z0-9_-]{1,60}$/.test(x.id)||seen.has(x.id)||typeof x.title!=='string'||!x.title||x.title.length>65||!['anchor','habit'].includes(x.kind))return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};seen.add(x.id);if(++count>100)return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};for(const k of ['anchor','benefit','timing','pair','caution'])if(typeof x[k]!=='string'||x[k].length>210)return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};if(period==='weekly'&&(!Array.isArray(x.weekdays)||!x.weekdays.length||x.weekdays.some(n=>!Number.isInteger(n)||n<0||n>6)))return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};if(period==='monthly'&&(!Number.isInteger(x.dayOfMonth)||x.dayOfMonth<1||x.dayOfMonth>31))return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};if(period==='yearly'&&(!/^\\d{2}-\\d{2}$/.test(x.monthDay)||!YOSTimeline.day('2024-'+x.monthDay)))return {status:\"error\",lists:{daily:[],weekly:[],monthly:[],yearly:[]}};}}return {...v,status:'ok'};}catch{return {status:'error',lists:{daily:[],weekly:[],monthly:[],yearly:[]}}}\n}\n\nasync function main(){\n  const start='2026-10-16',end='2027-01-13';\n  let token='';try{if(Keychain.contains(NOTION_KEY))token=Keychain.get(NOTION_KEY)||''}catch{}\n  const [apple,tasks,money,html]=await Promise.all([\n    readApple(start,end),\n    readNotion(TASK_SOURCE,'期限',parseTask,start,end,token),\n    readNotion(MONEY_SOURCE,'日付',parseMoney,start,end,token),\n    readPreview()\n  ]);\n  const uniqueApple=apple.rows;\n  // Stable source IDs only: do not collapse independent same-title appointments or Tasks.\n  const uniqueTasks=tasks.rows.filter(t=>!(t.calendarMirror&&!t.explicitAction&&uniqueApple.some(a=>t.syncKey==='calendar:'+a.id)));\n  // Don't send mirror metadata to WebView, only fields needed for the view.\n  const taskEntries=uniqueTasks.map(({calendarMirror,explicitAction,syncKey,...viewItem})=>viewItem);\n  const allEntries=[...uniqueApple,...taskEntries,...money.rows];\n  const entries=allEntries.slice(0,500);\n  // The UI accepts at most 500 items. Never report a complete source when\n  // the combined cap silently excludes records from the visible calendar.\n  if(allEntries.length>500){\n    if(apple.status==='ok')apple.status='partial';\n    if(tasks.status==='ok')tasks.status='partial';\n    if(money.status==='ok')money.status='partial';\n  }\n  const snapshot={schema:'yos-daystream-native-v1',generatedAt:new Date().toISOString(),\n    range:{start,end},sources:{apple:{status:apple.status},tasks:{status:tasks.status},money:{status:money.status}},items:entries};\n  const web=new WebView();\n  await web.loadHTML(html);\n  // Never include Notion API tokens, credentials or internal notes in this payload.\n  const ok=await web.evaluateJavaScript('window.YOS_DAYSTREAM_NATIVE_V1('+JSON.stringify(snapshot)+')',false);\n  if(ok!==true)throw Error('Native bridge was not accepted by calendar');\n  const store=planStore();let prior=readLocalPlan(store);if(!prior.value&&!prior.blocked&&store){const legacy={fm:store.fm,path:store.fm.joinPath(store.fm.documentsDirectory(),'YOS_DAYSTREAM_PLAN_STATE_v1.json')};prior=readLocalPlan(legacy);}\n  if(prior.value){\n    try{await web.evaluateJavaScript('window.YOS_DAYSTREAM_PLAN_IMPORT('+JSON.stringify(prior.value)+')',false)}catch{}\n  }\n  let expectedRaw=store&&store.fm.fileExists(store.path)?store.fm.readString(store.path):null;\n  const habits=readHabitSource();\n  await web.evaluateJavaScript('window.YOS_TIMELINE_HABITS('+JSON.stringify(habits)+')',false);\n  let closedFlag=false;\n  // Start callback capture before presentation. Every deliberate Save has its own callback.\n  const capture=()=>web.evaluateJavaScript(\"(function(){window.YOS_DAYSTREAM_ATTACH_SAVE(function(value){completion(value);});})()\",true).then(value=>({kind:'save',value}),()=>({kind:'error'}));\n  let pending=capture();\n  const closed=web.present(true).then(()=>{closedFlag=true;return {kind:'closed'}});\n  while(!closedFlag){\n    const next=await Promise.race([pending,closed]);if(next.kind!=='save')break;\n    let currentRaw;try{currentRaw=store&&store.fm.fileExists(store.path)?store.fm.readString(store.path):null}catch{currentRaw=undefined}\n    const ok=!prior.blocked&&currentRaw===expectedRaw&&saveLocalPlan(store,next.value);\n    if(ok)expectedRaw=store.fm.readString(store.path);\n    if(!closedFlag)await web.evaluateJavaScript('window.YOS_TIMELINE_SAVED('+JSON.stringify(ok)+')',false);\n    if(!closedFlag)pending=capture();\n  }\n  await closed;\n}\ntry {await main();} catch(error){\n  const alert=new Alert();alert.title='DAYSTREAMプレビューを表示できません';\n  alert.message='接続・読み取りを確認できませんでした。既存のカレンダーやNotionは変更していません。';\n  alert.addAction('閉じる');await alert.presentAlert();\n} finally {Script.complete();}\n",
  "share_sheet_inputs": []
}
