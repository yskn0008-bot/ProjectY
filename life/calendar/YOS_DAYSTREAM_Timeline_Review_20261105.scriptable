rid;grid-template-columns:40px minmax(0,1fr);grid-template-rows:auto auto;align-content:center;column-gap:12px;row-gap:3px;min-height:88px;padding:13px 14px;border:1px solid #ffffffec;border-radius:20px;background:linear-gradient(120deg,#e6f2ffe0,#c5ddfbd4);box-shadow:0 5px 13px #647fa31a,inset 0 0 0 1px #8bbdeb4d;backdrop-filter:blur(18px)}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard .tlCardIcon{grid-column:1;grid-row:1/3;width:40px;align-self:center;color:#206ca8}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard .tlCardIcon svg{width:34px;height:34px;filter:drop-shadow(0 2px 2px #226a9b1a)}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard strong{grid-column:2;grid-row:1;font-size:17px;font-weight:700;line-height:1.35;white-space:normal;overflow-wrap:anywhere}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaDuration{display:none}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaActualTime{display:block;grid-column:2;grid-row:2;font-size:14px;line-height:1.4;color:#3a5272}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaRule{display:block;grid-column:2;grid-row:3;font-size:12px;line-height:1.4;margin-top:3px}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=sleep]{background:linear-gradient(120deg,#eee8ffdf,#ddd4f7d6);box-shadow:0 5px 13px #7764a21a,inset 0 0 0 1px #b6a2de73}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=habit],.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=walk],.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=wash],.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=moisturizer]{background:linear-gradient(120deg,#e4f8e8e6,#cef0dfce);box-shadow:0 5px 13px #467a6017,inset 0 0 0 1px #83c7a86b}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard[data-kind=meal]{background:linear-gradient(120deg,#fff1e4e6,#ffe1cad1);box-shadow:0 5px 13px #9b795b17,inset 0 0 0 1px #e9b99466}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard.tlRuleCandidate{outline:1px solid #a577d28c;outline-offset:1px}\\n.tlFrame[data-skin=glass][data-view=home] .tlTabs{margin-inline:-20px;border-radius:25px 25px 0 0;background:#ffffff8c;border:1px solid #fff;backdrop-filter:blur(22px);padding-top:8px;box-shadow:0 -5px 24px #6d80ad16}\\n.tlFrame[data-skin=glass][data-view=home] .tlTabs button{min-height:59px;font-size:12px}\\n.tlFrame[data-skin=glass][data-view=home] .tlTabs .tlIcon svg{width:24px;height:24px}\\n.tlFrame[data-skin=glass][data-view=home] #tlAdd{width:54px;height:54px;border-radius:50%;bottom:90px;background:linear-gradient(135deg,#22bb8e,#078762);border:2px solid #ffffffc7;box-shadow:0 7px 23px #198f6b36}\\n.tlFrame[data-skin=compact][data-view=home] .tlAgendaRule,.tlFrame[data-skin=compact][data-view=home] .tlAgendaActualTime{display:none}\\n@media(max-width:360px){.tlFrame[data-skin=glass][data-view=home]{padding-inline:14px}.tlFrame[data-skin=glass][data-view=home] .tlHeader h1{font-size:26px}.tlFrame[data-skin=glass][data-view=home] #tlDateButton{font-size:18px}.tlFrame[data-skin=glass][data-view=home] .tlAgendaRow{grid-template-columns:38px 10px minmax(0,1fr);gap:5px}.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard{grid-template-columns:30px minmax(0,1fr);column-gap:8px;padding-inline:12px}.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard .tlCardIcon{width:30px}.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard strong{font-size:16px}}\\n\\n#tlFrame[data-skin=glass][data-theme=dark]{background-color:#17283e;background-blend-mode:multiply}#tlFrame[data-skin=glass][data-theme=dark] .tlIdentity span,#tlFrame[data-skin=glass][data-theme=dark] .tlAgendaTime{color:#c3d2e7}\\n@media(prefers-color-scheme:dark){#tlFrame[data-skin=glass][data-theme=auto]{background-color:#17283e;background-blend-mode:multiply}#tlFrame[data-skin=glass][data-theme=auto] .tlIdentity span,#tlFrame[data-skin=glass][data-theme=auto] .tlAgendaTime{color:#c3d2e7}}\\n\\n#tlPanel[data-wallpaper=A]{background-image:url(\\\"data:image/webp;base64,\\\");background-size:cover;box-shadow:inset 0 0 0 99999px var(--veil,#f7f6f2f5)}\\n\\n#tlPanel[data-wallpaper=B]{background-image:url(\\\"data:image/webp;base64,\\\");background-size:cover;box-shadow:inset 0 0 0 99999px var(--veil,#f7f6f2f5)}\\n\\n#tlPanel[data-wallpaper=C]{background-image:url(\\\"data:image/webp;base64,\\\");background-size:cover;box-shadow:inset 0 0 0 99999px var(--veil,#f7f6f2f5)}\\n\\n#tlPanel[data-theme=dark]{--veil:#202323f5}@media(prefers-color-scheme:dark){#tlPanel[data-theme=auto]{--veil:#202323f5}}\\n\\n#tlFrame[data-wallpaper=pearl]{background-image:url(\\\"data:image/webp;base64,\\\");background-size:cover;background-position:center}\\n#tlFrame[data-wallpaper=plain]{background-image:none;background-color:#f5f7fc}\\n#tlFrame[data-theme=dark][data-wallpaper=plain]{background-color:#17283e}\\n@media(prefers-color-scheme:dark){#tlFrame[data-theme=auto][data-wallpaper=plain]{background-color:#17283e}}\\n\\n\\n/* YOS_APPROVED_GLASS_TIME_RAIL_V1 */\\n/* HOME uses a time-proportional 00:00–24:00 rail. EDIT retains the existing 2px/min grid. */\\n.tlFrame[data-skin=glass][data-view=home] #tlAgenda{\\n position:relative;min-height:1196px;padding:0;margin:0 0 20px;\\n background-image:linear-gradient(90deg,transparent 0 51px,#72bed0 51px 53px,transparent 53px);\\n background-position:top left;background-size:100% 1152px;background-repeat:no-repeat;\\n}\\n.tlFrame[data-skin=glass][data-view=home] #tlAgenda::before{\\n content:\\\"00:00\\\\A 02:00\\\\A 04:00\\\\A 06:00\\\\A 08:00\\\\A 10:00\\\\A 12:00\\\\A 14:00\\\\A 16:00\\\\A 18:00\\\\A 20:00\\\\A 22:00\\\\A 24:00\\\";\\n position:absolute;left:0;top:-8px;white-space:pre;line-height:96px;\\n font-size:12px;letter-spacing:-.02em;font-variant-numeric:tabular-nums;\\n color:#31475e;pointer-events:none;\\n}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaRow{\\n position:absolute;left:0;right:0;display:grid;grid-template-columns:42px 13px minmax(0,1fr);\\n gap:7px;align-items:stretch;min-height:0;margin:0;padding:0;\\n}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaTime{visibility:hidden}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaDot{height:auto}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaDot::after{display:none}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaDot::before{top:13px;left:1px;width:10px;height:10px;box-shadow:0 0 0 2px #f8fbffe3}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaCard{\\n height:100%;min-height:0;margin:0;padding:8px 10px;overflow:hidden;border-radius:18px;\\n}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaEmpty{\\n position:absolute;top:320px;left:65px;right:6px;margin:0;padding:16px;\\n background:#ffffffb8;border:1px solid #fff;border-radius:18px;\\n}\\n.tlFrame[data-skin=glass][data-view=home] .tlAgendaRow[data-rail-shift=overlap] .tlAgendaDot::before{\\n outline:2px dashed #e48b40;\\n}\\n\\n</style>\\n</head>\\n<body>\\n<div class=\\\"frame tlFrame\\\" id=\\\"tlFrame\\\" data-theme=\\\"light\\\" data-view=\\\"home\\\" data-skin=\\\"glass\\\" data-wallpaper=\\\"pearl\\\"><header class=\\\"tlHeader\\\"><div class=\\\"tlIdentity\\\">YOS <span>LIFE FLOW</span></div><div class=\\\"tlHomeHeading\\\"><h1 id=\\\"tlHomeTitle\\\">今日のタイムライン</h1><button id=\\\"tlEnterEdit\\\">編集</button></div><div class=\\\"tlDateRow\\\"><button id=\\\"tlPrev\\\" aria-label=\\\"前日\\\"></button><button id=\\\"tlDateButton\\\" aria-label=\\\"月カレンダーを開く\\\"><span id=\\\"tlDateTitle\\\">今日</span></button><button id=\\\"tlNext\\\" aria-label=\\\"翌日\\\"></button><button id=\\\"tlSettings\\\" aria-label=\\\"記録・連携と表示設定\\\"></button><button id=\\\"tlCalendar\\\" aria-label=\\\"月カレンダーを開く\\\"></button><span id=\\\"tlSourceDot\\\" aria-label=\\\"元データ未接続\\\"></span></div><div class=\\\"tlEditHeader\\\" hidden id=\\\"tlEditHeader\\\"><button id=\\\"tlExitEdit\\\" aria-label=\\\"タイムラインへ戻る\\\"></button><h2>タイムラインを編集</h2><button id=\\\"tlSave\\\" disabled>保存</button></div></header><nav class=\\\"week\\\" aria-label=\\\"日付を選択\\\" id=\\\"week\\\"></nav><section id=\\\"tlPanel\\\" data-theme=\\\"light\\\" data-wallpaper=\\\"pearl\\\" aria-label=\\\"YOS 24時間タイムライン\\\">\\n<div id=\\\"tlLegend\\\" class=\\\"tlLegend\\\"><span class=\\\"tlLegendFixed\\\">固定予定</span><span class=\\\"tlLegendHabit\\\">習慣</span><span id=\\\"tlLegendRecommended\\\" class=\\\"tlLegendRecommended\\\" hidden>おすすめ</span></div><nav class=\\\"tlPeriods\\\" aria-label=\\\"表示期間\\\"><button id=\\\"tlPeriodDay\\\" aria-current=\\\"page\\\">24時間</button><button id=\\\"tlPeriodWeek\\\">週</button><button id=\\\"tlPeriodMonth\\\">月</button><button id=\\\"tlPeriodYear\\\">年</button></nav><div class=\\\"tlCanvasLabel\\\"><span id=\\\"tlScaleLabel\\\">実行順</span><span id=\\\"tlDayLabel\\\"></span></div>\\n<div id=\\\"tlViewport\\\" tabindex=\\\"0\\\" aria-label=\\\"選択日のタイムライン\\\"><div id=\\\"tlAgenda\\\" aria-label=\\\"実行順の一覧\\\"></div><div id=\\\"tlGrid\\\" hidden></div></div><div id=\\\"tlFeedback\\\" role=\\\"status\\\" aria-live=\\\"polite\\\" hidden></div>\\n<div class=\\\"tlTray\\\"><button id=\\\"tlOpenTray\\\">未配置 <span id=\\\"tlUnplacedCount\\\">0</span> <span aria-hidden=\\\"true\\\">↑</span></button><span id=\\\"tlState\\\">仮配置／未保存</span></div>\\n<div class=\\\"tlBottom\\\"><button id=\\\"tlUndo\\\" disabled>戻す</button><span>長押しして移動 · 1分＝2px</span></div><button id=\\\"tlAdd\\\" aria-label=\\\"配置を追加\\\"></button>\\n<nav class=\\\"tlTabs\\\" aria-label=\\\"メイン\\\"><button id=\\\"tlTabTimeline\\\" aria-current=\\\"page\\\">タイムライン</button><button id=\\\"tlTabHabits\\\">習慣</button><button id=\\\"tlTabReview\\\">振り返り</button><button id=\\\"tlTabSettings\\\">設定</button></nav></section>\\n<dialog id=\\\"tlPeriodDialog\\\" class=\\\"dialog\\\"><div class=\\\"sheet-head\\\"><h2 id=\\\"tlPeriodTitle\\\">期間</h2><button id=\\\"tlClosePeriod\\\" class=\\\"sheet-close\\\" aria-label=\\\"閉じる\\\">×</button></div><p>件数は端末内の配置と取得済みの時刻付き元予定です。元データの未取得は予定なしを意味しません。</p><div id=\\\"tlPeriodList\\\"></div></dialog>\\n<dialog id=\\\"tlHabitsDialog\\\" class=\\\"dialog\\\"><div class=\\\"sheet-head\\\"><h2>習慣</h2><button id=\\\"tlCloseHabits\\\" class=\\\"sheet-close\\\" aria-label=\\\"閉じる\\\">×</button></div><p>選択日の既存習慣を表示します。配置を押すと時刻を指定できます。</p><div id=\\\"tlHabitList\\\"></div></dialog>\\n<dialog id=\\\"tlReviewDialog\\\" class=\\\"dialog\\\"><div class=\\\"sheet-head\\\"><h2>振り返り</h2><button id=\\\"tlCloseReview\\\" class=\\\"sheet-close\\\" aria-label=\\\"閉じる\\\">×</button></div><p id=\\\"tlReviewSummary\\\"></p><div id=\\\"tlReviewList\\\"></div><p>実施チェックはこの端末内の記録です。Apple・Notionへは反映しません。保存ボタンで端末に保存します。</p></dialog>\\n<dialog id=\\\"tlDrawer\\\" class=\\\"dialog\\\"><div class=\\\"sheet-head\\\"><h2>未配置と配置の確認</h2><button id=\\\"tlCloseTray\\\" class=\\\"sheet-close\\\" aria-label=\\\"閉じる\\\">×</button></div><p id=\\\"tlHabitStatus\\\" class=\\\"tlHint\\\"></p><div id=\\\"tlUnplaced\\\"></div><details><summary>配置一覧・時刻編集</summary><div id=\\\"tlPlaced\\\"></div></details><details><summary>配置の影響 <span class=\\\"green\\\">＋</span> <span class=\\\"amber\\\">−</span> <span class=\\\"red\\\">!</span> <span class=\\\"neutral\\\">?</span></summary><div id=\\\"tlNotes\\\" aria-live=\\\"polite\\\"></div></details></dialog>\\n<dialog id=\\\"tlEditor\\\" class=\\\"dialog\\\"><form id=\\\"tlForm\\\"><h2>配置を編集</h2><p>所要時間・移動時間は計画値。元の予定は変更しません。</p><input id=\\\"tlId\\\" type=\\\"hidden\\\"><input id=\\\"tlSourceRef\\\" type=\\\"hidden\\\"><label>名前 <input id=\\\"tlTitle\\\" maxlength=\\\"120\\\" required></label><label>日付 <input id=\\\"tlDate\\\" type=\\\"date\\\" required></label><label>開始 <input id=\\\"tlTime\\\" type=\\\"time\\\" required></label><label>所要時間（分・翌日へ継続可）<input id=\\\"tlDuration\\\" type=\\\"number\\\" min=\\\"1\\\" max=\\\"1440\\\" required></label><label>行動 <select id=\\\"tlKind\\\"><option value=\\\"other\\\">その他</option><option value=\\\"task\\\">タスク</option><option value=\\\"habit\\\">習慣</option><option value=\\\"sleep\\\">睡眠</option><option value=\\\"meal\\\">食事</option><option value=\\\"walk\\\">歩行</option><option value=\\\"wash\\\">洗顔・洗浄</option><option value=\\\"moisturizer\\\">保湿</option><option value=\\\"travel\\\">移動</option></select></label><label>この前に必要な移動時間（分）<input id=\\\"tlTransfer\\\" type=\\\"number\\\" min=\\\"0\\\" max=\\\"240\\\" required></label><label>繰り返し <select id=\\\"tlRepeat\\\"><option value=\\\"none\\\">この日だけ</option><option value=\\\"daily\\\">毎日</option><option value=\\\"weekly\\\">毎週</option><option value=\\\"monthly\\\">毎月（月末で調整）</option><option value=\\\"yearly\\\">毎年（月末で調整）</option></select></label><label>変更範囲 <select id=\\\"tlScope\\\" hidden><option value=\\\"instance\\\">この回の時刻・所要時間だけ</option><option value=\\\"series\\\">全体を更新（例外時刻もリセット）</option></select></label><p id=\\\"tlError\\\" role=\\\"alert\\\"></p><div class=\\\"tlTools\\\"><button type=\\\"button\\\" id=\\\"tlComplete\\\">この回を実施済みにする</button><button type=\\\"button\\\" id=\\\"tlDelete\\\">配置から外す</button></div><div class=\\\"tlTools\\\"><button type=\\\"submit\\\">仮配置へ反映</button><button type=\\\"button\\\" id=\\\"tlCancel\\\">キャンセル</button></div></form></dialog>\\n</div><dialog id=\\\"tlSettingsDialog\\\" class=\\\"dialog\\\"><div class=\\\"sheet-head\\\"><h2>記録・連携</h2><button id=\\\"tlCloseSettings\\\" class=\\\"sheet-close\\\" aria-label=\\\"閉じる\\\">×</button></div><p id=\\\"tlStatus\\\" role=\\\"status\\\" aria-live=\\\"polite\\\">Scriptableで端末へ保存できます。</p><details><summary>表示設定</summary><div class=\\\"tlTools\\\"><label>デザイン <select id=\\\"tlSkin\\\"><option value=\\\"glass\\\" selected>ガラス</option><option value=\\\"compact\\\">コンパクト</option></select></label><label>表示 <select id=\\\"tlTheme\\\"><option value=\\\"light\\\" selected>明るい</option><option value=\\\"dark\\\">暗い</option><option value=\\\"auto\\\">端末に合わせる</option></select></label><label>背景 <select id=\\\"tlWallpaper\\\"><option value=\\\"pearl\\\" selected>パール</option><option value=\\\"plain\\\">無地</option><option value=\\\"A\\\">Mineral</option><option value=\\\"B\\\">Graphite</option><option value=\\\"C\\\">Matte</option></select></label></div><p class=\\\"tlHint\\\">表示設定はこの画面を閉じるまで有効です。</p></details><details><summary>日付を指定</summary><div class=\\\"tlTools\\\"><input type=\\\"date\\\" id=\\\"tlDay\\\" aria-label=\\\"表示する日付\\\"></div></details><details><summary>使い方・保存について</summary><p>カードをタップして時刻を編集。右端の↕を450ms長押しして上下へ移動できます。1分＝2px、移動は5分単位です。小さな予定は「未配置と配置の確認 → 配置一覧」から選べます。</p><p>＋ 習慣効率の候補 ／ − 配置の改善候補 ／ ! 重複・移動不足 ／ ? 未確認</p><p>元データと仮配置は別です。保存しても実施済みにはなりません。Apple・Notion・習慣正本は変更しません。</p></details><details class=\\\"tlLegacy\\\"><summary>既存の記録・接続状況</summary>\\n  <header class=\\\"header\\\"><div class=\\\"identity\\\"><strong>YOS</strong><em>CALENDAR / DAYSTREAM</em></div><div class=\\\"header-tools\\\"><button class=\\\"iconbutton\\\" id=\\\"refresh\\\" aria-label=\\\"この画面の保存済み記録を再表示。Apple・Notionの最新取得は画面を閉じて再起動\\\" title=\\\"Apple・Notionは再起動で再取得\\\">↻</button><span class=\\\"tiny-circ\\\" aria-hidden=\\\"true\\\">Y</span></div></header>\\n  <div class=\\\"demo-banner\\\" id=\\\"demoBanner\\\" hidden><span>DESIGN PREVIEW · 表示内容と金額は架空です</span><button id=\\\"useReal\\\">保存済みデータ</button></div>\\n  <section class=\\\"hero\\\"><div><div class=\\\"eyebrow\\\" id=\\\"heroEyebrow\\\">NOVEMBER · 2026</div><div class=\\\"date-line\\\"><span class=\\\"big-date\\\" id=\\\"bigDate\\\">01</span><div class=\\\"day-meta\\\"><strong id=\\\"heroDay\\\">SUNDAY</strong><span id=\\\"heroShort\\\">11月1日</span></div></div></div><div class=\\\"hero-right\\\"><div class=\\\"status-pill\\\"><b id=\\\"stateDot\\\"></b><span id=\\\"stateLabel\\\">接続状態</span></div><button id=\\\"openMonth\\\">月カレンダー <span aria-hidden=\\\"true\\\">↗</span></button></div></section>\\n  <div class=\\\"week-title\\\"><span id=\\\"weekLabel\\\">WEEK 44</span><div class=\\\"week-nav\\\"><button id=\\\"weekBack\\\" aria-label=\\\"前の週\\\">‹</button><button id=\\\"weekNext\\\" aria-label=\\\"次の週\\\">›</button></div></div>\\n  \\n  <aside class=\\\"insight\\\"><svg width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"#2761d8\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M12 2.5v3M4.6 5l2.1 2.1M2.6 12h3M19.4 12h2M17.3 7.1l2.1-2.1M9 17h6M10 20h4\\\"/><path d=\\\"M8.2 14.5C6.5 12 7 8.6 9.7 7c2-1.2 5-.7 6.5 1.1 1.7 2 1.7 4.6.2 6.4-.7.9-1.3 1.5-1.4 2.5h-6c0-1-.2-1.7-.8-2.5z\\\"/></svg><p><b>YOS</b> <span id=\\\"advice\\\">確認できた情報をもとに、次の行動を整理します。</span></p></aside>\\n  <section class=\\\"dayplan\\\" aria-label=\\\"起床から就寝までの一日\\\">\\n<div class=\\\"planhead\\\"><h2>起床から就寝まで</h2><span id=\\\"planProgress\\\">—</span></div>\\n<div class=\\\"plan-actions\\\"><button type=\\\"button\\\" id=\\\"planCommit\\\" disabled aria-label=\\\"実行リストを端末へ保存し、Notionへの反映確認へ進む\\\">旧リスト（この版では保存対象外）</button><span id=\\\"planCommitHint\\\">開発確認版：保存機能の接続待ち</span></div>\\n<p class=\\\"planintro\\\" id=\\\"planIntro\\\">固定予定と未指定タスクをYOSが仮配置します。</p>\\n<div id=\\\"planList\\\" role=\\\"list\\\"></div>\\n<p class=\\\"planfooter\\\" id=\\\"planFooter\\\">チェック・順番は端末内の仮記録。この確認版ではNotionへ完了反映しません。</p>\\n</section>\\n<details class=\\\"sourcelist\\\"><summary>元データを確認（予定・タスク・家計）</summary>\\n  <section class=\\\"streamhead\\\"><h2><span id=\\\"flowHeading\\\">今日の流れ</span><span id=\\\"selectedSuffix\\\" style=\\\"font-weight:500;color:#8c9197;font-size:12px;margin-left:7px\\\"></span></h2><small id=\\\"eventCount\\\">—</small></section>\\n  <nav class=\\\"filter-row\\\" aria-label=\\\"情報の種類を絞り込む\\\" id=\\\"filterRow\\\"><button class=\\\"filter\\\" data-filter=\\\"all\\\" aria-pressed=\\\"true\\\"><span>すべて</span></button><button class=\\\"filter\\\" data-filter=\\\"schedule\\\" style=\\\"--c:var(--schedule)\\\" aria-pressed=\\\"true\\\"><i></i><span>予定</span></button><button class=\\\"filter\\\" data-filter=\\\"task\\\" style=\\\"--c:var(--task)\\\" aria-pressed=\\\"true\\\"><i></i><span>タスク</span></button><button class=\\\"filter\\\" data-filter=\\\"money\\\" style=\\\"--c:var(--money)\\\" aria-pressed=\\\"true\\\"><i></i><span>お金</span></button><button class=\\\"filter\\\" data-filter=\\\"habit\\\" style=\\\"--c:var(--habit)\\\" aria-pressed=\\\"true\\\"><i></i><span>習慣</span></button></nav>\\n  <div class=\\\"stream\\\" id=\\\"stream\\\" tabindex=\\\"0\\\" aria-live=\\\"polite\\\"></div></details>\\n  <aside class=\\\"brief\\\" aria-label=\\\"当日サマリー\\\"><div><small>DAY MONEY / 当日の入出金</small><strong class=\\\"money-num\\\" id=\\\"moneyValue\\\">—</strong><p id=\\\"moneyCaption\\\">未接続</p></div><div class=\\\"separator\\\" aria-hidden=\\\"true\\\"></div><div><small>HABIT / 習慣の記録</small><strong class=\\\"hab-num\\\" id=\\\"habitValue\\\">未確認</strong><p id=\\\"habitCaption\\\">未記録＝未実施ではありません</p></div></aside>\\n  <footer class=\\\"meta-footer\\\"><span id=\\\"freshness\\\">MY LIFE / Money 読み取り中</span><button id=\\\"infoButton\\\">接続状況 · 詳細 ↗</button></footer>\\n</details></dialog>\\n<dialog class=\\\"dialog\\\" id=\\\"monthDialog\\\"><div class=\\\"sheet-head\\\"><h2 id=\\\"monthTitle\\\">2026年11月</h2><button class=\\\"sheet-close\\\" id=\\\"closeMonth\\\" aria-label=\\\"閉じる\\\">×</button></div><p class=\\\"sheet-sub\\\">日付を選ぶと、生活タイムラインが切り替わります。</p><div class=\\\"month-grid\\\" id=\\\"monthGrid\\\"></div><div class=\\\"month-actions\\\"><button id=\\\"previousMonth\\\">← 前の月</button><button id=\\\"monthToday\\\">今日</button><button id=\\\"followingMonth\\\">次の月 →</button></div></dialog>\\n<dialog class=\\\"dialog\\\" id=\\\"infoDialog\\\"><div class=\\\"sheet-head\\\"><h2 id=\\\"infoTitle\\\">接続状況</h2><button class=\\\"sheet-close\\\" id=\\\"closeInfo\\\" aria-label=\\\"閉じる\\\">×</button></div><p class=\\\"sheet-sub\\\" id=\\\"infoSub\\\">この画面で実際に読めたデータの範囲を表示します。</p><div id=\\\"infoBody\\\"></div></dialog>\\n<script>\\n/* Local deterministic timeline engine. No network, credentials, or source mutations. */\\n(function(root){\\n'use strict';\\nconst MIN='2026-10-16',MAX='2027-01-13',PX=2;\\nfunction day(k){if(typeof k!=='string'||!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(k))return false;const d=new Date(k+'T00:00:00Z');return Number.isFinite(+d)&&d.toISOString().slice(0,10)===k}\\nconst date=k=>new Date(k+'T00:00:00Z');\\nconst key=d=>d.toISOString().slice(0,10);\\nconst plus=(k,n)=>key(new Date(+date(k)+n*86400000));\\nconst minute=k=>+date(k)/60000;\\nconst clock=n=>String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');\\nconst at=(k,t)=>minute(k)+Number(t.slice(0,2))*60+Number(t.slice(3));\\nfunction validEvent(e){return e&&typeof e.id==='string'&&e.id.length<180&&typeof e.title==='string'&&e.title.length>0&&e.title.length<=120&&day(e.date)&&Number.isInteger(e.start)&&e.start>=0&&e.start<1440&&Number.isInteger(e.duration)&&e.duration>=1&&e.duration<=1440&&['none','daily','weekly','monthly','yearly'].includes(e.repeat)&&['task','habit','sleep','meal','walk','wash','moisturizer','travel','other'].includes(e.kind)&&Number.isInteger(e.transfer)&&e.transfer>=0&&e.transfer<=240}\\nfunction valid(data){return data&&Array.isArray(data.events)&&data.events.every(validEvent)&&(!data.completed||(typeof data.completed==='object'&&!Array.isArray(data.completed)&&Object.keys(data.completed).length<=1000&&Object.entries(data.completed).every(([k,v])=>/^.+@\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(k)&&k.length<220&&day(k.slice(-10))&&typeof v==='boolean'&&data.events.some(e=>k.slice(0,-11)===e.id&&occurs(e,k.slice(-10))))))&&(!data.fixedBuffers||(typeof data.fixedBuffers==='object'&&!Array.isArray(data.fixedBuffers)&&Object.keys(data.fixedBuffers).length<=500&&Object.entries(data.fixedBuffers).every(([k,v])=>k.length<200&&Number.isInteger(v)&&v>=0&&v<=240)))&&data.version===1&&Array.isArray(data.events)&&data.events.length<=300&&data.events.every(validEvent)&&new Set(data.events.map(x=>x.id)).size===data.events.length&&data.overrides&&typeof data.overrides==='object'&&!Array.isArray(data.overrides)&&Object.keys(data.overrides).length<=1000&&Object.entries(data.overrides).every(([k,v])=>k.length<220&&/^.+@\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(k)&&v&&Number.isInteger(v.start)&&v.start>=0&&v.start<1440&&Number.isInteger(v.duration)&&v.duration>=1&&v.duration<=1440)}\\nfunction occurs(e,k){if(k<e.date)return false;const a=date(e.date),b=date(k);switch(e.repeat){case'none':return k===e.date;case'daily':return true;case'weekly':return (+b-+a)%604800000===0;case'monthly':return b.getUTCDate()===Math.min(a.getUTCDate(),new Date(Date.UTC(b.getUTCFullYear(),b.getUTCMonth()+1,0)).getUTCDate());case'yearly':return b.getUTCMonth()===a.getUTCMonth()&&b.getUTCDate()===Math.min(a.getUTCDate(),new Date(Date.UTC(b.getUTCFullYear(),a.getUTCMonth()+1,0)).getUTCDate());default:return false}}\\nfunction instances(data,k){const rows=[];for(const d of [plus(k,-1),k])for(const e of data.events){if(!occurs(e,d))continue;const id=e.id+'@'+d,o=data.overrides[id]||{},s=minute(d)+(o.start??e.start),duration=o.duration??e.duration;rows.push({...e,...o,id,baseId:e.id,occurrenceDate:d,startAbs:s,endAbs:s+duration,fixed:false,source:'端末内の計画'});}return rows}\\nfunction fixed(items,buffers={}){const out=[],seen=new Set();for(const e of items){if(!e.id||!e.source||!['schedule','task'].includes(e.type))continue;const id=e.source+':'+e.id;if(seen.has(id))continue;seen.add(id);const raw=e.startISO||(e.fixedTime?e.date+'T'+e.fixedTime+':00+09:00':null);if(!raw||!Number.isFinite(Date.parse(raw)))continue;const startAbs=Date.parse(raw)/60000+540,endAbs=e.endISO&&Number.isFinite(Date.parse(e.endISO))?Date.parse(e.endISO)/60000+540:null;out.push({id,title:e.title,startAbs,endAbs:endAbs>startAbs?endAbs:null,fixed:true,kind:'fixed',transfer:buffers[id]||0,source:e.source});}return out}\\nfunction clip(row,k){const lo=minute(k),hi=lo+1440;if(row.startAbs>=hi||(row.endAbs??row.startAbs+1)<=lo)return null;const start=Math.max(row.startAbs,lo)-lo,end=Math.min(row.endAbs??row.startAbs+1,hi)-lo;return {...row,start,end,top:start*PX,height:(end-start)*PX,continuesBefore:row.startAbs<lo,continuesAfter:row.endAbs>hi}}\\nfunction impact(rows){const notes=[],sorted=rows.filter(x=>x.endAbs!==null).slice().sort((a,b)=>a.startAbs-b.startAbs);for(let i=0;i<sorted.length;i++){const a=sorted[i];for(let j=i+1;j<sorted.length;j++){const b=sorted[j];if(b.startAbs<a.endAbs)notes.push({sign:'!',text:a.title+' と '+b.title+' が重複',ids:[a.id,b.id]});else if(j===i+1&&b.startAbs-a.endAbs<(b.transfer||0))notes.push({sign:'!',text:b.title+' 前の移動時間が不足（必要 '+b.transfer+'分）',ids:[b.id]});}if(a.kind==='meal'||a.kind==='wash'){const kind=a.kind==='meal'?'walk':'moisturizer',next=sorted.find(b=>b.kind===kind&&b.startAbs>=a.endAbs&&b.startAbs-a.endAbs<=30);notes.push(next?{sign:'+',text:a.title+' → '+next.title+'：習慣のつなぎやすさ（設定ルール）',ids:[a.id,next.id]}:{sign:'?',text:a.title+' の後の '+(kind==='walk'?'歩行':'保湿')+'：任意の連結候補（30分は仮ルール）',ids:[a.id]});}}\\nnotes.push({sign:'?',text:'健康効果・最適な間隔は未検証。ここでの評価は習慣配置ルールで、科学的効果の判定ではありません。',ids:[]});return notes}\\nconst api={MIN,MAX,PX,day,plus,minute,clock,at,valid,validEvent,occurs,instances,fixed,clip,impact};root.YOSTimeline=api;if(typeof module!=='undefined')module.exports=api;\\n})(typeof window==='undefined'?globalThis:window);\\n\\n\\n'use strict';\\n(()=>{\\n const $=id=>document.getElementById(id),tz='Asia/Tokyo',fmt=new Intl.DateTimeFormat('sv-SE',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}),today=fmt.format(new Date());\\n const dateKey=d=>fmt.format(d),parseDate=k=>new Date(k+'T12:00:00+09:00'),addDays=(key,n)=>{let d=parseDate(key);d.setUTCDate(d.getUTCDate()+n);return dateKey(d)};\\n const state={selected:today,month:today.slice(0,7),demo:false,items:[],native:null,lifeRead:false,lifeSynced:null,moneyRead:false,moneyPrivate:false,moneySynced:null,loadedAt:null,filters:new Set(['schedule','task','money','habit'])};\\n const str=(x,max=140)=>String(x??'').replace(/[\\\\u0000-\\\\u001F]/g,' ').trim().slice(0,max),title=(x,fallback)=>str(x,100)||fallback;\\n const isValidKey=k=>/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(String(k||''))&&dateKey(parseDate(k))===k;\\n const cash=n=>'¥'+Math.abs(n).toLocaleString('ja-JP');\\n const safeSynced=value=>{const d=typeof value==='string'?new Date(value):null;return d&&Number.isFinite(d.getTime())&&d.getTime()<=Date.now()+300000?d:null};\\n const readLocal=key=>{try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):null}catch{return null}};\\n const names={schedule:'予定',task:'タスク',money:'お金',habit:'習慣'},weekEn=['SUN','MON','TUE','WED','THU','FRI','SAT'];\\n   function normalizeLife(){const data=readLocal('yos-life-v1');const out=[];state.lifeRead=Boolean(data&&data.days&&typeof data.days==='object');state.lifeSynced=null;if(!state.lifeRead)return out;\\n    state.lifeSynced=Object.values(data.days).map(day=>safeSynced(day?.lastSync)).filter(Boolean).sort((a,b)=>b-a)[0]||null;\\n    for(const [day,source] of Object.entries(data.days)){if(!isValidKey(day)||!source||typeof source!=='object')continue;\\n      for(const e of Array.isArray(source.schedule)?source.schedule:[]){if(!e||typeof e!=='object'||!title(e.title,''))continue;const eday=isValidKey(e.date)?e.date:day;out.push({type:'schedule',date:eday,title:title(e.title,''),subtitle:e.isAllDay?'終日':e.start?String(e.start).slice(11,16):'日時未確認',source:'MY LIFE',id:'life:event:'+day+':'+str(e.id||e.title,95)});}\\n      for(const [i,t] of (Array.isArray(source.tasks)?source.tasks:[]).entries()){if(!t?.text||!str(t.text))continue;out.push({type:'task',date:day,title:title(t.text,''),subtitle:t.done===true?'完了':'未完了',done:t.done===true,source:'MY LIFE',id:'life:task:'+day+':'+str(t.id||i,80)});}\\n      if(source.routines&&typeof source.routines==='object'){\\n        const rows=Object.values(source.routines).flatMap(x=>Array.isArray(x)?x:[]).filter(x=>x&&typeof x==='object');\\n        const done=rows.filter(x=>x.done===true).length;\\n        if(done)out.push({type:'habit',date:day,title:'生活ルーティン',subtitle:`記録済み ${done}件`,source:'MY LIFE',id:'life:habit:'+day});\\n      }\\n    }\\n    return out;\\n  }\\n  function normalizeMoney(){const data=readLocal('yos-money-v2');state.moneySynced=safeSynced(data?.updatedAt);state.moneyPrivate=Boolean(data?.privacy);state.moneyRead=Boolean(data&&Array.isArray(data.transactions)&&!state.moneyPrivate);if(!state.moneyRead)return [];\\n    return data.transactions.flatMap((tx,i)=>{if(!tx||!isValidKey(str(tx.date,10)))return[];const amount=Number(tx.amount),kind=tx.type==='income'?'income':(['expense','debt','saving','investment'].includes(tx.type)?'expense':null);if(!kind||!Number.isFinite(amount)||amount<0)return[];const complete=tx.completed===true||tx.paid===true||tx.received===true||['done','paid','completed','received'].includes(str(tx.status,24).toLowerCase());return[{type:'money',date:tx.date,title:title(tx.label,'入出金'),subtitle:complete?'実績':'予定',amount:Math.round(amount),moneyKind:kind,complete,source:'Money',id:'money:tx:'+str(tx.id||i,80)}]});\\n  }\\n  function createDemo(){const base=parseDate(today),month=base.getMonth();const d=n=>{const x=new Date(base.getFullYear(),month,n,12);return dateKey(x)},current=base.getDate();\\n    const at=(offset)=>addDays(today,offset);\\n    const pairs=[{type:'schedule',date:at(0),title:'カフェで打ち合わせ',subtitle:'10:30 – 11:30'},{type:'task',date:at(0),title:'見積もりの確認',subtitle:'未完了'},{type:'habit',date:at(0),title:'食後の散歩',subtitle:'記録済み（サンプル）'},{type:'money',date:at(0),title:'日用品の購入',subtitle:'実績',amount:1680,moneyKind:'expense',complete:true},{type:'schedule',date:at(2),title:'美容室の予約',subtitle:'14:00 – 15:00'},{type:'task',date:at(2),title:'応募書類を送る',subtitle:'未完了'},{type:'money',date:at(4),title:'固定費の支払い',subtitle:'予定',amount:15800,moneyKind:'expense',complete:false},{type:'money',date:at(6),title:'入金予定',subtitle:'予定',amount:48500,moneyKind:'income',complete:false},{type:'schedule',date:at(-3),title:'友人との約束',subtitle:'18:00'},{type:'habit',date:at(-3),title:'ストレッチ',subtitle:'記録済み（サンプル）'},{type:'task',date:d(15),title:'部屋の整頓',subtitle:'未完了'},{type:'money',date:d(19),title:'予定支出',subtitle:'予定',amount:3400,moneyKind:'expense',complete:false}];\\n    return pairs.map((x,i)=>({...x,id:'demo:'+i,source:'表示例'}));\\n  }\\n\\n  const nativeTypes=new Set(['schedule','task','money','habit']);\\n  const allowedNativeSources={schedule:'Appleカレンダー',task:'Notion Tasks',money:'Notion家計',habit:'YOS 日記'};\\n  function nativeItems(snapshot){\\n    if(!snapshot||snapshot.schema!=='yos-daystream-native-v1'||!Array.isArray(snapshot.items))return [];\\n    return snapshot.items.slice(0,500).flatMap((it,i)=>{\\n      if(!it||!nativeTypes.has(it.type)||!isValidKey(it.date)||it.source!==allowedNativeSources[it.type])return [];\\n      const item={type:it.type,date:it.date,title:str(it.title,100),subtitle:str(it.subtitle,100),source:it.source,id:'native:'+i+':'+str(it.id,70)};\\n      if(!item.title)return [];\\n      if(it.type==='task'){item.done=it.done===true;item.priority=['P0','P1','P2','P3'].includes(it.priority)?it.priority:'';item.order=Number.isFinite(it.order)?it.order:null;item.fixedTime=/^\\\\d{2}:\\\\d{2}$/.test(it.fixedTime||'')?it.fixedTime:'';}\\n      if(it.type==='money'){\\n        if(state.moneyPrivate || !Number.isFinite(it.amount) || it.amount<0 || it.amount>1000000000 || !['income','expense'].includes(it.moneyKind))return [];\\n        item.amount=Math.round(it.amount);item.moneyKind=it.moneyKind;item.complete=it.complete===true;item.reviewRequired=it.reviewRequired===true;\\n      }\\n      return [item];\\n    });\\n  }\\n  function mergeRecords(records){\\n    const seen=new Set();const deduped=[];\\n    for(const x of records){\\n      // IDs represent distinct records even when title/date/amount match. Do not\\n      // collapse two real purchases based on similar display text.\\n      const key=[x.source,x.type,x.id].join('|');\\n      // Collapse visually identical tasks on the same day without deleting\\n      // or merging their underlying Notion records. Never dedupe money.\\n      const visualTaskKey=x.type==='task'?[x.type,x.date,String(x.title||'').trim().normalize('NFKC'),Boolean(x.done)].join('|'):null;\\n      if(seen.has(key))continue;\\n      seen.add(key);if(visualTaskKey)seen.add('display:'+visualTaskKey);deduped.push(x);\\n    }\\n    return deduped;\\n  }\\n  function load(preferDemo){const life=normalizeLife(),money=normalizeMoney(),native=nativeItems(state.native);\\n    state.demo=Boolean(preferDemo??(location.protocol==='file:'&&!life.length&&!money.length&&!native.length));\\n    if(state.moneyPrivate || state.native)state.demo=false;\\n    // Notion 家計 is authoritative in native mode. If it fails, show unavailable:\\n    // never silently replace it with outdated browser Money transactions.\\n    const joined=state.native?[...native,...life]:[...life,...money];\\n    state.items=state.demo?createDemo():mergeRecords(joined);state.loadedAt=new Date();$('demoBanner').hidden=!state.demo;render();\\n  }\\n  // Scriptable invokes this after loading the existing DAYSTREAM design. Only minimum\\n  // display fields cross the native-to-WebView boundary. Never accept an API token.\\n  window.YOS_DAYSTREAM_NATIVE_V1=function(payload){\\n    if(!payload||payload.schema!=='yos-daystream-native-v1'||!Array.isArray(payload.items)||payload.items.length>500||\\n      !payload.range||!isValidKey(payload.range.start)||!isValidKey(payload.range.end)||payload.range.start>payload.range.end||\\n      (parseDate(payload.range.end)-parseDate(payload.range.start))>93*86400000||\\n      !payload.sources||typeof payload.sources!=='object'||\\n      typeof payload.generatedAt!=='string'||!safeSynced(payload.generatedAt))return false;\\n    const statuses=['ok','partial','unavailable','error'];\\n    const sources={};for(const name of ['apple','tasks','money']){\\n      const value=payload.sources[name];\\n      sources[name]={status:statuses.includes(value?.status)?value.status:'unavailable'};\\n    }\\n    state.native={schema:payload.schema,generatedAt:payload.generatedAt,range:{start:payload.range.start,end:payload.range.end},sources,items:payload.items};\\n    load(false);return true;\\n  };\\n function listDay(key=state.selected){return state.items.filter(x=>x.date===key&&state.filters.has(x.type))}\\n const dayDate=k=>{const d=parseDate(k);return {day:d.getDate(),weekday:d.getDay(),month:d.getMonth()+1,year:d.getFullYear()}};\\n function nativeSourceLabel(){const statuses=Object.values(state.native.sources).map(s=>s.status);const age=Date.now()-new Date(state.native.generatedAt).getTime();if(age>30*60*1000)return '再取得が必要';const complete=statuses.filter(s=>s==='ok').length;return complete===3?'3種類取得済み':complete||statuses.includes('partial')?'一部取得':'取得を確認できず';}\\n  function renderHeader(){const d=dayDate(state.selected);$('heroEyebrow').textContent=new Intl.DateTimeFormat('en-US',{timeZone:tz,month:'long',year:'numeric'}).format(parseDate(state.selected)).toUpperCase();$('bigDate').textContent=String(d.day).padStart(2,'0');$('heroDay').textContent=weekEn[d.weekday];$('heroShort').textContent=d.month+'月'+d.day+'日';$('stateLabel').textContent=state.demo?'デザイン見本':state.native?nativeSourceLabel():(state.lifeRead||state.moneyRead)?'保存済み記録':'未接続';$('stateDot').style.background=state.demo?'#b47d13':state.native?(nativeSourceLabel()==='3種類取得済み'?'#137c5b':'#b47d13'):state.lifeRead||state.moneyRead?'#137c5b':'#98a0a7';$('weekLabel').textContent=d.year+' / '+d.month+'月 · 日付を選ぶ';$('selectedSuffix').textContent=state.selected===today?'TODAY':'';$('flowHeading').textContent=state.selected===today?'今日の流れ':'この日の流れ';}\\n function color(t){return `var(--${t})`}\\n function countsFor(date){return [...new Set(state.items.filter(x=>x.date===date).map(x=>x.type))]}\\n function renderWeek(){const root=$('week');root.replaceChildren();const first=addDays(state.selected,-dayDate(state.selected).weekday);for(let i=0;i<7;i++){const k=addDays(first,i),d=dayDate(k),b=document.createElement('button');b.type='button';b.className='daybtn'+(state.selected===k?' selected':'')+(today===k?' today':'');b.setAttribute('aria-pressed',String(state.selected===k));b.setAttribute('aria-label',`${d.month}月${d.day}日を表示`);const w=document.createElement('span');w.className='wd';w.textContent='日月火水木金土'[d.weekday];const num=document.createElement('span');num.className='num';num.textContent=d.day;const dots=document.createElement('span');dots.className='dots';for(const t of countsFor(k)){const dot=document.createElement('i');dot.style.background=color(t);dots.append(dot)}b.append(w,num,dots);b.addEventListener('click',()=>setDay(k));root.append(b)}}\\n function eventTime(e){if(e.type!=='schedule')return '';const t=String(e.subtitle||'').match(/\\\\b(\\\\d{2}):(\\\\d{2})\\\\b/);return t?t[0]:'終日'}\\n function sortedEntries(){return listDay().sort((a,b)=>{const rank=x=>x.type==='schedule'?(eventTime(x)==='終日'?-1:0):x.type==='money'?2:x.type==='task'?3:4;let r=rank(a)-rank(b);return r||((a.type==='schedule'&&b.type==='schedule')?eventTime(a).localeCompare(eventTime(b)):0)})}\\n // DAYPLAN-BEGIN: the YOS draft plan is separate from source-of-truth records.\\n const PLAN_KEY='yos-daystream-plan-v1';\\n const routine=(id,title,subtitle)=>({id:'habit:'+id,type:'habit',title,subtitle,movable:true,checkable:true,planned:true});\\n const anchor=(id,title,subtitle)=>({id:'anchor:'+id,type:'schedule',title,subtitle,movable:false,checkable:false,planned:true});\\n function planForDay(date,records){\\n   const rows=records.filter(x=>x.date===date),scheduled=rows.filter(x=>x.type==='schedule'||(x.type==='task'&&x.fixedTime));\\n   const sortTime=x=>/^\\\\d{2}:\\\\d{2}$/.test(x.fixedTime||x.subtitle||'')?Number((x.fixedTime||x.subtitle).slice(0,2)):12;\\n   scheduled.sort((a,b)=>sortTime(a)-sortTime(b));\\n   const priorities={P0:0,P1:1,P2:2,P3:3};\\n   const tasks=rows.filter(x=>x.type==='task'&&!x.done&&!x.fixedTime).sort((a,b)=>\\n     (priorities[a.priority]??4)-(priorities[b.priority]??4)||\\n     (Number.isFinite(a.order)?a.order:9999)-(Number.isFinite(b.order)?b.order:9999)||\\n     a.title.localeCompare(b.title,'ja')).map((x,i)=>({...x,id:'task:'+x.source+':'+String(x.id).replace(/^native:\\\\d+:/,'native:'),\\n       subtitle:'YOS仮配置 · '+(i<2?'優先候補':'空き時間候補')+(x.priority?' · '+x.priority:''),\\n       movable:true,checkable:true}));\\n   const appointments=scheduled.map(x=>({...x,id:'event:'+x.source+':'+String(x.id).replace(/^native:\\\\d+:/,'native:'),movable:false,checkable:x.type==='task'}));\\n   const bills=rows.filter(x=>x.type==='money').map(x=>({...x,id:'money:'+x.source+':'+x.id,movable:false,checkable:false}));\\n   const morning=appointments.filter(x=>sortTime(x)<11),afternoon=appointments.filter(x=>sortTime(x)>=11&&sortTime(x)<18),night=appointments.filter(x=>sortTime(x)>=18);\\n   const split=Math.ceil(tasks.length/2);\\n   return [\\n     anchor('wake','起床','時刻未取得'),\\n     routine('water','水を飲む','起床後'),\\n     routine('stretch-am','朝のストレッチ','短時間'),\\n     routine('ready','身支度','起床後'),\\n     ...morning,\\n     routine('breakfast','朝食・食事を記録','Clarityで記録／献立分析はデータ接続後'),\\n     routine('walk','食後のウォーキング','5分／難しい日は1分'),\\n     ...tasks.slice(0,split),...afternoon,...bills,...tasks.slice(split),...night,\\n     routine('diary','日記・振り返り','夜／既存YOS日記'),\\n     routine('stretch-pm','夜のストレッチ','短時間'),\\n     anchor('sleep','就寝','睡眠記録と翌日の予定からの提案は未接続')\\n   ];\\n }\\n function applyPlanOrder(rows,requested) {\\n   if(!Array.isArray(requested)||requested.length>300)return rows;\\n   const mov=rows.filter(x=>x.movable),known=new Map(mov.map(x=>[x.id,x])),used=new Set(),sorted=[];\\n   for(const id of requested){if(typeof id==='string'&&known.has(id)&&!used.has(id)){sorted.push(known.get(id));used.add(id)}}\\n   for(const x of mov)if(!used.has(x.id))sorted.push(x);\\n   let i=0;return rows.map(x=>x.movable?sorted[i++]:x);\\n }\\n // DAYPLAN-END\\n let planSaved={};let planWriteStatus='端末内保存は未確認';const planTouched=new Set();\\n try{const raw=localStorage.getItem(PLAN_KEY),parsed=raw&&JSON.parse(raw);if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed))planSaved=parsed}catch{}\\n const dayDraft=()=>{const d=planSaved[state.selected];return d&&typeof d==='object'?d:{order:[],done:{}}};\\n function writePlan(entry){\\n   planSaved[state.selected]={order:Array.isArray(entry.order)?entry.order.slice(0,300):[],done:entry.done||{}};\\n   const keys=Object.keys(planSaved).filter(isValidKey).sort().slice(-30),data={};for(const k of keys)data[k]=planSaved[k];\\n   planSaved=data;\\n   try{const encoded=JSON.stringify(data);localStorage.setItem(PLAN_KEY,encoded);\\n     planWriteStatus=localStorage.getItem(PLAN_KEY)===encoded?'端末内の仮記録を保存':'保存を確認できず';\\n   }catch{planWriteStatus='保存不可（開いている間だけ）'}\\n }\\n const orderedPlan=()=>applyPlanOrder(planForDay(state.selected,state.items),dayDraft().order);\\n function changeCheck(id){\\n   if(state.demo)return;const row=orderedPlan().find(x=>x.id===id);if(!row?.checkable)return;\\n   const d=dayDraft(),done={...(d.done||{})};if(done[id])delete done[id];else done[id]=true;\\n   if(row.type==='task'){if(done[id])planTouched.add(id);else planTouched.delete(id)}\\n   writePlan({order:d.order,done});renderPlan();\\n }\\n function changeOrder(id,delta){\\n   if(state.demo)return;const current=orderedPlan(),flex=current.filter(x=>x.movable),idx=flex.findIndex(x=>x.id===id),other=idx+delta;\\n   if(idx<0||other<0||other>=flex.length)return;\\n   [flex[idx],flex[other]]=[flex[other],flex[idx]];\\n   writePlan({order:flex.map(x=>x.id),done:dayDraft().done});renderPlan();\\n }\\n function renderPlan(){\\n   const rows=orderedPlan(),done=dayDraft().done||{},root=$('planList');root.replaceChildren();\\n   const total=rows.filter(x=>x.checkable).length,completed=rows.filter(x=>x.checkable&&done[x.id]).length;\\n   $('planProgress').textContent=completed+' / '+total+' 仮チェック';\\n   $('planIntro').textContent='時刻確定の予定は動かしません。時間未指定のタスクは優先度から仮配置します。';\\n   $('planFooter').textContent=(state.demo?'デザイン見本':planWriteStatus)+\\n     ' · チェックだけではNotion／Appleは変わりません。この確認版ではNotionへの完了反映は実装していません。';\\n   const flex=rows.filter(x=>x.movable);\\n   for(const item of rows){\\n     const line=document.createElement('div');line.className='planrow'+(done[item.id]?' checked':'');line.setAttribute('role','listitem');\\n     const clock=document.createElement('span');clock.className='planclock';\\n     clock.textContent=item.type==='schedule'&&item.subtitle==='終日'?'終日':\\n       /^\\\\d{2}:\\\\d{2}$/.test(item.fixedTime||item.subtitle||'')?(item.fixedTime||item.subtitle):'順番';\\n     const tick=document.createElement('button');tick.className='plancheck'+(done[item.id]?' checked':'');tick.type='button';\\n     tick.disabled=!item.checkable||state.demo;tick.textContent=item.checkable?(done[item.id]?'✓':'○'):'•';\\n     tick.setAttribute('aria-label',item.title+'の仮チェック');if(item.checkable)tick.addEventListener('click',()=>changeCheck(item.id));\\n     const copy=document.createElement('span');copy.className='plancopy';const name=document.createElement('strong');name.textContent=item.title;\\n     const hint=document.createElement('small');hint.textContent=(item.planned?'朝夜の習慣候補':names[item.type]||'予定')+' · '+String(item.subtitle||'');\\n     copy.append(name,hint);\\n     const controls=document.createElement('span');controls.className='planmove';\\n     if(item.movable){for(const [delta,symbol] of [[-1,'↑'],[1,'↓']]){\\n       const btn=document.createElement('button');btn.type='button';btn.textContent=symbol;btn.disabled=state.demo||\\n       (delta<0?flex[0].id===item.id:flex[flex.length-1].id===item.id);\\n       btn.setAttribute('aria-label',item.title+'を'+(delta<0?'上':'下')+'へ');\\n       btn.addEventListener('click',()=>changeOrder(item.id,delta));controls.append(btn);\\n     }}else{controls.className='planlocked';controls.textContent='固定'}\\n     line.append(clock,tick,copy,controls);root.append(line);\\n   }\\n }\\n // Native Scriptable is the sole owner of a persistable file and Notion credentials.\\n // These methods expose a bounded plan snapshot; they never send tokens or auto-write Notion.\\n window.YOS_DAYSTREAM_PLAN_IMPORT=function(value){\\n   if(!value||value.schema!=='yos-daystream-plan-v1'||!value.days||\\n     typeof value.days!=='object'||Array.isArray(value.days))return false;\\n   const valid={};\\n   for(const [day,d] of Object.entries(value.days).slice(-30)){\\n     if(!isValidKey(day)||!d||typeof d!=='object')continue;\\n     const order=Array.isArray(d.order)?d.order.filter(k=>typeof k==='string'&&k.length<180).slice(0,300):[];\\n     const done={};for(const [k,v] of Object.entries(d.done||{}).slice(0,300))\\n       if(typeof k==='string'&&k.length<180&&v===true)done[k]=true;\\n     valid[day]={order,done};\\n   }\\n   planSaved=valid;planWriteStatus='Scriptable端末内ファイルから復元';\\n   renderPlan();return true;\\n };\\n window.YOS_DAYSTREAM_PLAN_EXPORT=function(){\\n   const days={};\\n   for(const [day,d] of Object.entries(planSaved).slice(-30)){\\n     if(!isValidKey(day)||!d||typeof d!=='object')continue;\\n     const order=Array.isArray(d.order)?d.order.filter(x=>typeof x==='string'&&x.length<180).slice(0,300):[];\\n     const done={};for(const [k,v] of Object.entries(d.done||{}).slice(0,300))\\n       if(typeof k==='string'&&k.length<180&&v===true)done[k]=true;\\n     days[day]={order,done};\\n   }\\n   return {schema:'yos-daystream-plan-v1',days,completedKeys:[...planTouched].slice(0,30)};\\n };\\n // Signal to native Scriptable only when the user explicitly presses Save.\\n // Native evaluateJavaScript(useCallback=true) registers this handler before presenting.\\n window.YOS_DAYSTREAM_ATTACH_SAVE=function(callback){\\n   const button=$('planCommit'),hint=$('planCommitHint');\\n   if(typeof callback!=='function'||!button||!hint)return false;\\n   button.disabled=state.demo;\\n   hint.textContent='チェック・順番を保存するには押してください。押した後、この画面を閉じると確認へ進みます。';\\n   button.addEventListener('click',()=>{\\n     if(button.disabled||state.demo)return;\\n     const plan=window.YOS_DAYSTREAM_PLAN_EXPORT();\\n     button.disabled=true;button.textContent='保存データを送信済み';\\n     hint.textContent='画面を閉じて保存結果を確認してください。Notionの更新には別途承認が必要です。';\\n     callback(plan);\\n   },{once:true});\\n   return true;\\n };\\n function renderStream(){const entries=sortedEntries(),root=$('stream');root.replaceChildren();$('eventCount').textContent=entries.length+'件の記録';if(!entries.length){const node=document.createElement('div');node.className='nothing';const b=document.createElement('b');b.textContent=state.demo?'この日のサンプルはありません':'この日の記録は未確認';const t=document.createElement('span');t.textContent=state.native&&(state.selected<state.native.range.start||state.selected>state.native.range.end)?'この日付はiPhoneで取得した期間の外です。再起動しても取得範囲外の場合は未確認です。':'未接続の情報は含まれません。記録なし＝予定や習慣がない、ではありません。';node.append(b,t);root.append(node);return}for(const e of entries){const row=document.createElement('button');row.type='button';row.className='stream-item '+e.type;row.style.setProperty('--color',color(e.type));const time=document.createElement('span');time.className='time'+(e.type==='schedule'?'':' unset');time.textContent=e.type==='schedule'?eventTime(e):e.type==='money'?'¥':e.type==='task'?'TODO':'LOG';const spine=document.createElement('span');spine.className='stream-spine';spine.append(document.createElement('i'));const copy=document.createElement('span');copy.className='content';const strong=document.createElement('strong');strong.textContent=e.title;const small=document.createElement('small');small.textContent=`${names[e.type]} · ${e.subtitle}${state.demo?' · サンプル':''}`;copy.append(strong,small);const end=document.createElement('span');end.className=e.type==='money'?'amount':'stream-arrow';end.textContent=e.type==='money'?(e.moneyKind==='income'?'+':'−')+cash(e.amount):'›';row.append(time,spine,copy,end);row.addEventListener('click',()=>showRecord(e));root.append(row)}}\\n function renderBrief(){const day=state.items.filter(x=>x.date===state.selected),money=day.filter(x=>x.type==='money'),hab=day.filter(x=>x.type==='habit'),can=!state.moneyPrivate&&(state.demo||(state.native?['ok','partial'].includes(state.native.sources.money.status):state.moneyRead)),moneyPartial=state.native?.sources?.money?.status==='partial';const actual=money.filter(x=>x.complete);const incoming=actual.filter(x=>x.moneyKind==='income').reduce((a,x)=>a+x.amount,0);const outgoing=actual.filter(x=>x.moneyKind==='expense').reduce((a,x)=>a+x.amount,0);const plan=money.filter(x=>!x.complete&&!x.reviewRequired),review=money.filter(x=>x.reviewRequired);$('moneyValue').textContent=(!can||moneyPartial)?'—':!money.length?'記録なし':(incoming-outgoing<0?'−':'+')+cash(incoming-outgoing);$('moneyCaption').textContent=!can?(state.moneyPrivate?'Money：非表示':'Notion家計：未接続'):moneyPartial?'Notion家計は一部取得。日別合計は未確定（明細は参考）':!money.length?'表示範囲内の入出金記録なし（取得漏れは未確認）':`確認済み実績：入金${cash(incoming)} / 支出${cash(outgoing)} · 予定${plan.length}件${review.length?' · 要照合'+review.length+'件':''}`;$('habitValue').textContent=hab.length?hab.length+'件の報告':'未確認';$('habitCaption').textContent=hab.length?'MY LIFEの保存済み実施報告':'未記録＝未実施ではありません';const next=state.items.filter(x=>x.type==='money'&&x.moneyKind==='expense'&&!x.complete&&!x.reviewRequired&&x.date>=state.selected).sort((a,b)=>a.date.localeCompare(b.date))[0];const current=day.filter(x=>x.type==='schedule'),open=day.filter(x=>x.type==='task'&&!x.done);let advice='確認できた情報から、今日の一手を整理します。';if(next&&next.date<=today&&state.selected===today)advice='支払い予定の期限を確認。完了・残高はMoneyで照合。';else if(current.length&&open.length)advice='まず時間が決まった予定を確保。その前後でタスクを1件。';else if(open.length)advice='未完了のタスクから、取りかかる1件を決めよう。';else if(next)advice='今後の支払い予定がある。残高はMoneyで確認。';else if(current.length)advice='予定を先に確保し、空いた時間は余白として残そう。';$('advice').textContent=(state.demo?'サンプル：':'')+advice;const life=state.lifeRead?'MY LIFE 保存あり':'MY LIFE 未接続',fin=state.moneyPrivate?'Money 非表示':state.moneyRead?'Money 保存あり':'Money 未接続',na=state.native,ns=na?' · Apple '+na.sources.apple.status+' / Notion Tasks '+na.sources.tasks.status+' / 家計 '+na.sources.money.status:'';const old=s=>!s||(Date.now()-s.getTime()>86400000);$('freshness').textContent=state.demo?'すべて架空の表示例':`${life}${state.lifeRead&&old(state.lifeSynced)?'（時刻未確認・古い可能性）':''} · ${fin}${state.moneyRead&&old(state.moneySynced)?'（時刻未確認・古い可能性）':''}${ns}${na?' · iPhone起動時 '+new Date(na.generatedAt).toLocaleTimeString('ja-JP')+'取得（再起動で更新）':''}`;}\\n function renderFilters(){for(const b of document.querySelectorAll('.filter')){const t=b.dataset.filter,active=t==='all'?state.filters.size===4:state.filters.has(t);b.classList.toggle('off',!active);b.setAttribute('aria-pressed',String(active))}}\\n function render(){renderTimeline();renderHeader();renderWeek();renderFilters();renderPlan();renderStream();renderBrief()}\\n function setDay(k){if(!isValidKey(k))return;state.selected=k;state.month=k.slice(0,7);render();$('stream').scrollTop=0}\\n function openDialog(id){$(id).showModal()}function closeDialog(id){$(id).close()}\\n function renderMonth(){const [yr,mon]=state.month.split('-').map(Number),first=dateKey(new Date(yr,mon-1,1,12)),firstDay=parseDate(first).getDay(),days=new Date(yr,mon,0).getDate(),total=Math.ceil((firstDay+days)/7)*7;const root=$('monthGrid');root.replaceChildren();$('monthTitle').textContent=`${yr}年${mon}月`;for(const w of '日月火水木金土'){const sp=document.createElement('span');sp.className='mwd';sp.textContent=w;root.append(sp)}for(let i=0;i<total;i++){const k=addDays(first,i-firstDay),d=dayDate(k),b=document.createElement('button');b.className='mday'+(k===state.selected?' sel':'')+(d.month!==mon?' out':'');b.textContent=String(d.day);const dots=document.createElement('span');dots.className='mdots';for(const t of countsFor(k).slice(0,4)){const x=document.createElement('i');x.style.background=color(t);dots.append(x)}b.append(dots);b.setAttribute('aria-label',`${d.month}月${d.day}日を表示`);b.addEventListener('click',()=>{setDay(k);closeDialog('monthDialog')});root.append(b)}}\\n function showRecord(e){$('infoTitle').textContent=e.title;$('infoSub').textContent=`${e.date} · ${names[e.type]}${state.demo?' · 架空サンプル':''}`;const body=$('infoBody');body.replaceChildren();const div=document.createElement('div');div.className='detail-line';const name=document.createElement('b');name.textContent='記録の状態';const stateSpan=document.createElement('span');stateSpan.textContent=e.subtitle;div.append(name,stateSpan);body.append(div);if(e.type==='money'){const b=document.createElement('div');b.className='detail-line';const st=document.createElement('b');st.textContent='金額（'+(e.complete?'確認済み実績':e.subtitle)+'）';const v=document.createElement('span');v.textContent=cash(e.amount);b.append(st,v);body.append(b)}const origin=document.createElement('div');origin.className='detail-line';const o=document.createElement('b');o.textContent='情報源';const v=document.createElement('span');v.textContent=e.source||'表示例';origin.append(o,v);body.append(origin);if(e.type==='task'){for(const [label,value] of [['次の一手',e.nextAction],['完了条件',e.completion],['ブロッカー',e.blocker]]){if(typeof value!=='string'||!value.trim())continue;const line=document.createElement('div');line.className='detail-line';const key=document.createElement('b');key.textContent=label;const content=document.createElement('span');content.textContent=value;content.style.whiteSpace='pre-wrap';content.style.overflowWrap='anywhere';line.append(key,content);body.append(line)}}if(e.type==='task'&&!e.nextAction&&!e.completion&&!e.blocker){const hint=document.createElement('p');hint.className='sheet-sub';hint.textContent='詳しい作業内容は、この画面に取得されていません。';body.append(hint)}openDialog('infoDialog')}\\n function showSources(){$('infoTitle').textContent='データの接続状態';$('infoSub').textContent=state.native?'iPhoneのApple予定・Notionは起動時に取得。Web画面の更新だけでは再取得されません。最新情報が必要なら閉じて再起動してください。':'開いた時点で保存済み情報を再取得します。銀行・Notion・Appleのリアルタイム同期は未接続です。';const root=$('infoBody');root.replaceChildren();for(const [name,read,stamp] of [['MY LIFE',state.lifeRead,state.lifeSynced],['Money',state.moneyPrivate?'非表示':state.moneyRead,state.moneySynced],['Notion / Apple',state.native?'起動時の取得結果を下に表示':'未接続',null]]){const div=document.createElement('div');div.className='detail-line';const t=document.createElement('b');t.textContent=name;const text=document.createElement('span');text.textContent=typeof read==='string'?read:read?'このブラウザの保存済みデータを読み取り':'未接続';if(stamp)text.textContent+=' · 元データ更新 '+stamp.toLocaleString('ja-JP');div.append(t,text);root.append(div)}if(state.native){\\n    for(const [name,code] of [['Appleカレンダー','apple'],['Notion Tasks','tasks'],['Notion家計','money']]){\\n      const div=document.createElement('div');div.className='detail-line';\\n      const bold=document.createElement('b');bold.textContent=name;\\n      const span=document.createElement('span');span.textContent=({ok:'取得済み',partial:'一部取得',unavailable:'未接続',error:'取得失敗'}[state.native.sources[code].status]||'未確認')+' · '+state.native.range.start+'〜'+state.native.range.end+' / 起動時取得 '+new Date(state.native.generatedAt).toLocaleTimeString('ja-JP');\\n      div.append(bold,span);root.append(div);\\n    }\\n  }\\n  const last=document.createElement('div');last.className='detail-line';const t=document.createElement('b');t.textContent='この画面の最終読み取り';const sp=document.createElement('span');sp.textContent=state.loadedAt?state.loadedAt.toLocaleTimeString('ja-JP'):'未確認';last.append(t,sp);root.append(last);openDialog('infoDialog')}\\n $('filterRow').addEventListener('click',e=>{const b=e.target.closest('button[data-filter]');if(!b)return;if(b.dataset.filter==='all'){state.filters=new Set(['schedule','task','money','habit'])}else{const t=b.dataset.filter;if(state.filters.has(t))state.filters.delete(t);else state.filters.add(t)}render()});\\n $('weekBack').addEventListener('click',()=>setDay(addDays(state.selected,-7)));$('weekNext').addEventListener('click',()=>setDay(addDays(state.selected,7)));\\n $('openMonth').addEventListener('click',()=>{renderMonth();openDialog('monthDialog')});$('closeMonth').addEventListener('click',()=>closeDialog('monthDialog'));\\n for(const [id,delta] of [['previousMonth',-1],['followingMonth',1]]){$(id).addEventListener('click',()=>{let [y,m]=state.month.split('-').map(Number);const d=new Date(y,m-1+delta,1,12);state.month=dateKey(d).slice(0,7);renderMonth()})}\\n $('monthToday').addEventListener('click',()=>{setDay(today);closeDialog('monthDialog')});$('infoButton').addEventListener('click',showSources);$('closeInfo').addEventListener('click',()=>closeDialog('infoDialog'));$('refresh').addEventListener('click',()=>load(false));$('useReal').addEventListener('click',()=>load(false));\\n window.addEventListener('pageshow',e=>{if(e.persisted&&!state.demo)load(false)});window.addEventListener('storage',e=>{if(!state.demo&&['yos-life-v1','yos-money-v2'].includes(e.key))load(false)});window.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&!state.demo)load(false)});window.addEventListener('focus',()=>{if(!state.demo&&state.loadedAt&&Date.now()-state.loadedAt.getTime()>10000)load(false)});\\n // Additive 24-hour editor; existing DAYSTREAM source list is retained below.\\n const TL=window.YOSTimeline;\\n let habitSource=null;window.YOS_TIMELINE_HABITS=function(v){habitSource=v;renderTimeline();return true};\\n function tlHabitRows(){if(!habitSource)return [];const d=new Date(state.selected+'T12:00:00Z'),dom=d.getUTCDate(),last=new Date(Date.UTC(d.getUTCFullYear(),d.getUTCMonth()+1,0)).getUTCDate();return ['daily','weekly','monthly','yearly'].flatMap(period=>(habitSource.lists[period]||[]).filter(x=>period==='daily'||period==='weekly'&&x.weekdays.includes(d.getUTCDay())||period==='monthly'&&Math.min(x.dayOfMonth,last)===dom||period==='yearly'&&Number(x.monthDay.slice(0,2))===d.getUTCMonth()+1&&Math.min(Number(x.monthDay.slice(3)),last)===dom).map(x=>({id:x.id,title:x.title,source:'YOS_HABIT_FLOW_v1',type:'habit',date:state.selected,repeat:period==='daily'?'daily':period==='weekly'?'weekly':period==='monthly'&&x.dayOfMonth===dom?'monthly':period==='yearly'&&Number(x.monthDay.slice(3))===dom?'yearly':'none'})));}\\n\\n let timeline={version:1,events:[],override