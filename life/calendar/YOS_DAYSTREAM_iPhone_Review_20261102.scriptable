{
  "always_run_in_app": true,
  "icon": {
    "color": "blue",
    "glyph": "calendar"
  },
  "name": "YOS DAYSTREAM 開発確認 20261102",
  "script": "// YOS DAYSTREAM iPhone review (development only, bundled HTML)\n// Existing Scriptable Keychain; read-only Notion / Apple Calendar. No new shortcuts or servers.\n// Requires the unchanged production Clarity / Notion Inbox setup only for credentials.\n'use strict';\nconst HTML_SHA256 = 'eb4f404fad19b0b1b1ede7910931e2382ca887cbdbe44f304182a9fd867b4898';\n// Compatibility marker for the already-installed iPhone launcher; actual HTML integrity is checked against HTML_SHA256.\nconst INSTALLED_LAUNCHER_MARKER = 'b31ebae6e68de7f8d718cb28bd849e808efb147aedaa78b7e7b0c1b491655e90';\nfunction sha256Hex(input){\n  const K=[\n    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\n    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\n    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\n    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\n    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\n    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\n    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\n    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\n  ];\n  const H=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19];\n  const bytes=Array.from(unescape(encodeURIComponent(input)),c=>c.charCodeAt(0));\n  const bitLength=bytes.length*8;\n  if(bitLength>=0x20000000000000)throw Error('sha256 payload too long');\n  bytes.push(0x80);while(bytes.length%64!==56)bytes.push(0);\n  const high=Math.floor(bitLength/0x100000000),low=bitLength>>>0;\n  for(let i=3;i>=0;i--)bytes.push((high>>>i*8)&255);\n  for(let i=3;i>=0;i--)bytes.push((low>>>i*8)&255);\n  const rr=(x,n)=>(x>>>n)|(x<<(32-n));\n  for(let at=0;at<bytes.length;at+=64){\n    const w=new Array(64).fill(0);\n    for(let i=0;i<16;i++)w[i]=(bytes[at+i*4]<<24)|(bytes[at+i*4+1]<<16)|(bytes[at+i*4+2]<<8)|bytes[at+i*4+3];\n    for(let i=16;i<64;i++){\n      const a=w[i-15],b=w[i-2],s0=rr(a,7)^rr(a,18)^(a>>>3),s1=rr(b,17)^rr(b,19)^(b>>>10);\n      w[i]=(w[i-16]+s0+w[i-7]+s1)>>>0;\n    }\n    let [a,b,c,d,e,f,g,h]=H;\n    for(let i=0;i<64;i++){\n      const s1=rr(e,6)^rr(e,11)^rr(e,25),ch=(e&f)^((~e)&g),t1=(h+s1+ch+K[i]+w[i])>>>0;\n      const s0=rr(a,2)^rr(a,13)^rr(a,22),maj=(a&b)^(a&c)^(b&c),t2=(s0+maj)>>>0;\n      h=g;g=f;f=e;e=(d+t1)>>>0;d=c;c=b;b=a;a=(t1+t2)>>>0;\n    }\n    for(const [i,x] of [a,b,c,d,e,f,g,h].entries())H[i]=(H[i]+x)>>>0;\n  }\n  return H.map(v=>v.toString(16).padStart(8,'0')).join('');\n}\n\nconst NOTION_KEY = 'YOS_NOTION_INTEGRATION_TOKEN'; // existing Scriptable key: never shared with WebView\nconst TASK_SOURCE = '965c6086-32c1-463d-93b4-87a9cb69b3ad'; // existing YOS Tasks\nconst MONEY_SOURCE = '95b30d16-7530-40c6-a320-dab99acad55d'; // existing 家計イベント・入出金予定\nconst TZ='Asia/Tokyo';\nconst dateKey=d=>new Intl.DateTimeFormat('sv-SE',{timeZone:TZ,year:'numeric',month:'2-digit',day:'2-digit'}).format(d);\nconst addDays=(date,n)=>{const d=new Date(date.getFullYear(),date.getMonth(),date.getDate()+n,12);return d};\nconst clean=(value,limit=120)=>String(value??'').replace(/[\\u0000-\\u001F\\u007F]/g,' ').trim().slice(0,limit);\nconst rich=(value,type)=>Array.isArray(value?.[type])?clean(value[type].map(x=>x.plain_text||x.text?.content||'').join(''),120):'';\nconst select=x=>clean(x?.select?.name,30);\nconst dateVal=x=>{const raw=x?.date?.start;if(typeof raw!=='string')return '';if(/^\\d{4}-\\d{2}-\\d{2}$/.test(raw))return raw;const d=new Date(raw);return Number.isFinite(d.getTime())?dateKey(d):'';};\nconst validDay=k=>/^\\d{4}-\\d{2}-\\d{2}$/.test(k);\n\nasync function queryNotion(source,field,start,end,token){\n  const result=[],filter={and:[\n    {property:field,date:{on_or_after:start}},\n    {property:field,date:{on_or_before:end}}\n  ]};\n  let cursor=null;\n  for(let page=0;page<4;page++){\n    const req=new Request('https://api.notion.com/v1/data_sources/'+source+'/query');\n    req.method='POST';req.headers={\n      Authorization:'Bearer '+token,'Content-Type':'application/json',\n      'Notion-Version':'2026-03-11',Accept:'application/json'\n    };\n    req.timeoutInterval=8;\n    req.body=JSON.stringify({page_size:100,filter,...(cursor?{start_cursor:cursor}:{})});\n    const res=await req.loadJSON();\n    if(req.response?.statusCode!==200 || !res || !Array.isArray(res.results))throw Error('Notion query unavailable');\n    result.push(...res.results);\n    if(res.has_more!==true)return {rows:result,complete:true};\n    if(typeof res.next_cursor!=='string'||!res.next_cursor)throw Error('Notion cursor missing');\n    cursor=res.next_cursor;\n  }\n  return {rows:result,complete:false};\n}\nfunction parseTask(row){\n  const p=row?.properties;if(!p)return null;\n  const title=rich(p['やること'],'title'),date=dateVal(p['期限']),status=select(p['状態']);\n  if(!title||!validDay(date)||['中止','完了','キャンセル','取り消し'].includes(status))return null;\n  const nextAction=rich(p['次の一手'],'rich_text'),completion=rich(p['完了条件'],'rich_text'),blocker=rich(p['ブロッカー'],'rich_text');\n  const provenance=rich(p['正本・根拠'],'rich_text'),syncKey=rich(p['同期キー'],'rich_text');\n  // Only calendar-origin copies may be hidden. Never infer a mirror from title alone.\n  const calendarMirror=provenance==='Apple Calendar'||syncKey.startsWith('calendar:');\n  // A human-added action or blocker remains independently actionable, even with a matching event.\n  const explicitAction=Boolean(nextAction.trim()||completion.trim()||blocker.trim());\n  const priority=select(p['優先度']),order=p['実行順']?.number;\n  const rawStart=p['期限']?.date?.start,ts=typeof rawStart==='string'&&rawStart.includes('T')?new Date(rawStart):null;\n  const fixedTime=ts&&Number.isFinite(ts.getTime())?new Intl.DateTimeFormat('ja-JP',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).format(ts):'';\n  return {type:'task',date,title,subtitle:status||'状態未確認',nextAction,completion,blocker,done:false,source:'Notion Tasks',id:clean(row.id||title,70),calendarMirror,explicitAction,\n    priority:['P0','P1','P2','P3'].includes(priority)?priority:'',order:Number.isFinite(order)?order:null,fixedTime};\n}\nfunction parseMoney(row){\n  const p=row?.properties;if(!p)return null;\n  const title=rich(p['項目'],'title'),date=dateVal(p['日付']),amount=p['金額']?.number;\n  const category=select(p['区分']),status=select(p['状態']),verification=select(p['確度']);\n  if(!title||!validDay(date)||!Number.isFinite(amount)||amount<0||amount>1000000000||status==='取消')return null;\n  const kind=category==='収入'?'income':category==='支出'?'expense':null;\n  if(!kind)return null; // Exclude transfers, avoiding double counting.\n  const complete=status==='実績'&&verification==='確認済';\n  const reviewRequired=status==='実績'&&!complete;\n  const subtitle=complete?'実績（確認済）':status==='実績'?'実績報告（要照合）':verification==='確認済'?'予定（確認済）':'予定・未確認';\n  return {type:'money',date,title,subtitle,amount:Math.round(amount),moneyKind:kind,complete,reviewRequired,source:'Notion家計',id:clean(row.id||title,70)};\n}\nasync function readApple(start,end){\n  try{\n    const from=new Date(start+'T00:00:00+09:00'),to=new Date(end+'T00:00:00+09:00');\n    to.setDate(to.getDate()+1);\n    const events=await CalendarEvent.between(from,to);\n    // Remove reference-only taxi-demand entries before applying the display cap.\n    // Otherwise 250 reference events can crowd out genuine appointments.\n    const eligible=(Array.isArray(events)?events:[]).filter(x=>\n      x?.title&&!/^[\\s　]*[［\\[【]\\s*タクシー需要/.test(x.title)&&\n      !/タクシー需要/.test(x.calendar?.title||'')\n    );\n    // Deduplicate visually identical all-day events (e.g. holidays imported\n    // from multiple calendars). Timed appointments and source data stay intact.\n    const seenAllDay=new Map();\n    const duplicates=[];\n    const unique=eligible.filter(x=>{\n      if(!x.isAllDay)return true;\n      const begin=new Date(x.startDate);\n      if(!Number.isFinite(begin.getTime()))return true;\n      const key=dateKey(begin)+'|'+clean(x.title,100).normalize('NFKC').trim();\n      if(seenAllDay.has(key)){\n        const first=seenAllDay.get(key);\n        duplicates.push({date:dateKey(begin),title:clean(x.title,100),\n          firstCalendar:clean(first.calendar?.title||'不明',80),\n          duplicateCalendar:clean(x.calendar?.title||'不明',80),\n          sameIdentifier:String(first.identifier||'')===String(x.identifier||'')});\n        return false;\n      }\n      seenAllDay.set(key,x);return true;\n    });\n    // Diagnostics stay in Scriptable's local console. No calendar changes,\n    // no remote uploads, and no additional UI prompts.\n    if(duplicates.length){\n      console.log('[DAYSTREAM] Apple終日予定の重複 '+duplicates.length+'件: '+JSON.stringify(duplicates.slice(0,30)));\n    }\n    const rows=unique.slice(0,170).flatMap((x,i)=>{\n      const begin=new Date(x.startDate);if(!Number.isFinite(begin.getTime()))return [];\n      const date=dateKey(begin);\n      if(date<start||date>end)return [];\n      const time=x.isAllDay?'終日':new Intl.DateTimeFormat('ja-JP',{timeZone:TZ,hour:'2-digit',minute:'2-digit',hour12:false}).format(begin);\n      return [{type:'schedule',date,title:clean(x.title,100),subtitle:time,source:'Appleカレンダー',id:clean(x.identifier||i,70)}];\n    });\n    return {status:unique.length>170?'partial':'ok',rows};\n  }catch{return {status:'error',rows:[]}};\n}\nasync function readNotion(source,field,parse,start,end,token){\n  if(!token)return {status:'unavailable',rows:[]};\n  try{\n    const result=await queryNotion(source,field,start,end,token);\n    const parsed=result.rows.map(parse).filter(Boolean);\n    return {status:result.complete&&parsed.length<=165?'ok':'partial',rows:parsed.slice(0,165)};\n  }catch{return {status:'error',rows:[]}};\n}\nconst HTML_BUNDLE=\"<!doctype html>\\n<html lang=\\\"ja\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1, viewport-fit=cover\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#fbfbf9\\\">\\n<meta name=\\\"apple-mobile-web-app-capable\\\" content=\\\"yes\\\">\\n<meta name=\\\"apple-mobile-web-app-title\\\" content=\\\"YOS Calendar\\\">\\n<title>YOS Calendar — DAYSTREAM concept</title>\\n<style>\\n:root{color-scheme:light;--paper:#fbfbf9;--ink:#151718;--muted:#74787e;--line:#e9e9e6;--schedule:#279BFA;--task:#A77BFA;--habit:#42CDA3;--money:#F5B942;--danger:#FF7485;--accent:#279BFA}\\n[hidden]{display:none!important}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--paper);font-family:-apple-system,BlinkMacSystemFont,'Hiragino Kaku Gothic ProN','Hiragino Sans',sans-serif;-webkit-font-smoothing:antialiased;color:var(--ink)}\\nbutton{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:3px solid var(--accent);outline-offset:3px}\\nbutton:disabled{opacity:.4;cursor:default} .frame{max-width:900px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 15px) 23px calc(env(safe-area-inset-bottom) + 20px);min-height:100dvh;display:flex;flex-direction:column;gap:0}\\n.header{height:44px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.identity{display:flex;gap:10px;align-items:baseline}.identity strong{font-size:18px;letter-spacing:-.095em;font-weight:950}.identity em{font-style:normal;font-weight:600;letter-spacing:.16em;color:#92969b;font-size:9px}.header-tools{display:flex;gap:10px;align-items:center}.iconbutton{border:0;background:transparent;color:#151718;width:37px;height:36px;display:grid;place-items:center;font-size:22px;border-radius:50%}.iconbutton:hover{background:#eceff6}.tiny-circ{height:25px;width:25px;border-radius:50%;background:#151718;color:white;display:grid;place-items:center;font-size:15px;font-weight:650}\\n.hero{display:grid;grid-template-columns:1fr auto;align-items:end;padding:10px 0 19px;border-bottom:1px solid var(--line);gap:8px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.17em;color:#8a9095}.date-line{display:flex;align-items:baseline;gap:12px;margin:0}.big-date{font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:clamp(75px,17vw,94px);font-weight:250;letter-spacing:-.095em;line-height:1.03;font-variant-numeric:tabular-nums}.day-meta{display:flex;flex-direction:column;gap:7px}.day-meta strong{font-size:17px;font-weight:800;letter-spacing:-.025em}.day-meta span{font-size:13px;color:#646b75}.hero-right{align-self:center;text-align:right;display:flex;flex-direction:column;gap:8px;align-items:end}.status-pill{display:flex;align-items:center;gap:6px;color:#62676e;font-size:10px;font-weight:700}.status-pill b{display:inline-block;width:7px;height:7px;border-radius:100%;background:#8d9497}.hero-right button{border:0;background:none;padding:5px;color:#235BEB;font-size:12px;font-weight:800}\\n.week-title{display:flex;justify-content:space-between;align-items:center;margin:18px 0 7px}.week-title span{font-size:11px;font-weight:800;letter-spacing:.09em;color:#646c75}.week-nav{display:flex;align-items:center;gap:7px}.week-nav button{width:30px;height:28px;border:0;background:transparent;color:#6c7178;font-size:21px}.weeknav-hint{font-size:10px;color:#8d9195}\\n.week{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:1px;align-items:center;padding-bottom:16px;border-bottom:1px solid var(--line)}.daybtn{border:0;background:transparent;min-width:0;height:64px;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:#646973}.daybtn .wd{font-size:10px;font-weight:700}.daybtn .num{font-size:22px;font-weight:470;font-variant-numeric:tabular-nums;letter-spacing:-.06em}.daybtn .dots{height:4px;display:flex;gap:2px}.dots i{height:4px;width:4px;border-radius:50%}.daybtn.selected{background:var(--ink);color:#fff}.daybtn.selected .dots i{background:#fff!important}.daybtn.today:not(.selected) .num{text-decoration:underline;text-decoration-color:#235BEB;text-decoration-thickness:2px;text-underline-offset:6px}\\n.streamhead{display:flex;align-items:baseline;justify-content:space-between;gap:8px;padding:18px 0 12px}.streamhead h2{font-size:25px;letter-spacing:-.06em;font-weight:830;margin:0}.streamhead small{font-size:11px;color:#84888e}.filter-row{display:flex;gap:8px;overflow:auto;scrollbar-width:none;margin-bottom:11px}.filter-row::-webkit-scrollbar{display:none}.filter{flex:none;background:transparent;border:1px solid #d9dbe0;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:720;color:#555d68;min-height:33px;display:flex;align-items:center;gap:6px}.filter i{width:7px;height:7px;border-radius:50%;background:var(--c)}.filter.off{opacity:.38}.filter:first-child{border-color:#151718;color:#151718}\\n.stream{min-height:180px;flex:1;max-height:calc(100dvh - 547px);overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#ced2d7 transparent}.stream:focus-visible{outline:2px solid var(--accent)}.stream-item{display:grid;grid-template-columns:48px 15px minmax(0,1fr) auto;align-items:center;gap:8px;min-height:62px;padding:3px 0 3px 0;border-bottom:1px solid #efefed;text-align:left;width:100%;background:transparent;border-left:0;border-top:0;border-right:0;color:inherit}.stream-item:last-child{border-bottom:0}.stream-item:active{background:#f3f5fb}.time{font-size:12px;font-variant-numeric:tabular-nums;color:#606773;letter-spacing:-.04em;text-align:left}.time.unset{font-size:10px;color:#a1a5a8}.stream-spine{position:relative;align-self:stretch;display:flex;justify-content:center;align-items:center}.stream-spine::before{content:\\\"\\\";position:absolute;top:0;bottom:0;width:1px;background:#e5e8ea;left:7px}.stream-spine i{height:10px;width:10px;position:relative;border-radius:3px;background:var(--color);display:block;transform:rotate(45deg);box-shadow:0 0 0 4px var(--paper)}.stream-item.money .stream-spine i{border-radius:50%;transform:none}.stream-item.habit .stream-spine i{border-radius:50%;height:8px;width:8px;transform:none}.content{min-width:0}.content strong{font-size:14px;line-height:1.35;font-weight:720;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.018em}.content small{font-size:11px;line-height:1.4;color:#82868d;display:block;margin-top:4px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.amount{font-size:13px;font-weight:800;color:var(--money);white-space:nowrap;font-variant-numeric:tabular-nums}.stream-arrow{font-size:18px;color:#b6b8ba}.nothing{padding:28px 3px 30px;font-size:13px;color:#7d838b;line-height:1.8}.nothing b{font-size:17px;display:block;color:var(--ink);margin-bottom:2px}.empty-sample{display:flex;align-items:center;gap:6px;font-size:11px}\\n.brief{margin-top:9px;border-top:1px solid #1e2226;padding:13px 0 5px;display:grid;grid-template-columns:minmax(0,1.05fr) 1px minmax(0,.95fr);gap:11px;align-items:start}.brief .separator{height:63px;background:#e1e3e4}.brief small{display:block;color:#8d9094;font-size:9px;letter-spacing:.13em;font-weight:800;margin-bottom:6px}.brief strong{display:block;font-size:18px;letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}.brief p{margin:5px 0 0;color:#848990;font-size:10px;line-height:1.45}.brief .money-num{color:var(--money)}.brief .hab-num{color:var(--habit)}\\n.insight{display:flex;align-items:center;gap:10px;margin-top:11px;padding:11px 0 3px;border-top:1px solid var(--line)}.insight svg{flex:none}.insight p{margin:0;font-size:12px;line-height:1.45;color:#51575f}.insight b{font-weight:850;color:#151718}.meta-footer{padding-top:9px;font-size:10px;color:#a0a4aa;display:flex;gap:8px;justify-content:space-between}.meta-footer button{background:none;border:0;color:#69737f;padding:0;font-size:10px;font-weight:700}.demo-banner{padding:8px 12px;background:#fff3d3;border-left:3px solid #b17a10;font-size:11px;line-height:1.4;color:#5c4208;display:flex;justify-content:space-between;align-items:center;gap:10px}.demo-banner button{background:none;border:0;color:#604507;text-decoration:underline;padding:3px;font-weight:700;flex-shrink:0;white-space:nowrap}.demo-banner span{flex:1;min-width:0}\\n.dialog{border:0;border-radius:23px 23px 0 0;padding:21px 20px 30px;box-shadow:0 -16px 60px #16191b21;background:#fff;width:min(100%,600px);max-height:min(76dvh,680px);min-height:0;overflow-y:auto;overscroll-behavior:contain;position:fixed;inset:auto 0 0 0;margin:auto;color:var(--ink)}.dialog#infoDialog{padding-bottom:max(20px,env(safe-area-inset-bottom));}.dialog::backdrop{background:#15171840;backdrop-filter:blur(1px)}.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:20px}.sheet-head h2{margin:0;font-size:clamp(19px,5.5vw,24px);letter-spacing:-.04em;line-height:1.35;overflow-wrap:anywhere}.sheet-close{border:0;background:#f0f1f2;border-radius:50%;height:36px;width:36px;font-size:23px}.sheet-sub{margin:8px 0 16px;color:#767c85;font-size:12px;line-height:1.5}.month-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}.mwd{text-align:center;color:#8a9097;font-size:11px;padding:6px 0}.mday{height:48px;border:0;background:transparent;border-radius:11px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;font-weight:700;color:#40454d}.mday.sel{background:var(--ink);color:white}.mday.out{opacity:.28}.mdots{height:4px;display:flex;gap:2px}.mdots i{height:4px;width:4px;border-radius:50%}.mday.sel .mdots i{background:white!important}.month-actions{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:12px}.month-actions button{border:1px solid #e3e4e5;background:#fff;border-radius:11px;padding:9px 13px;font-size:12px;font-weight:700}.detail-line{padding:12px 0;border-bottom:1px solid var(--line);font-size:13px;line-height:1.5}.detail-line b{display:block;margin-bottom:4px}.detail-line span{color:#72777f}.sheet-link{font-size:12px;color:#2660CF;word-break:break-all}\\n@media(max-width:520px) and (min-height:750px){\\n .frame{padding-top:calc(env(safe-area-inset-top) + 9px);padding-bottom:calc(env(safe-area-inset-bottom) + 10px)}\\n .header{height:33px}.demo-banner{padding:5px 9px;font-size:10px}\\n .hero{padding-top:4px;padding-bottom:9px}.eyebrow{font-size:9px}.big-date{font-size:76px}.day-meta{gap:5px}\\n .week-title{margin:8px 0 3px}.week{padding-bottom:7px}.daybtn{height:51px;gap:3px}.daybtn .num{font-size:19px}\\n .streamhead{padding:10px 0 7px}.streamhead h2{font-size:23px}.filter-row{margin-bottom:5px}\\n .stream-item{min-height:54px}.stream{min-height:140px;max-height:calc(100dvh - 450px)}\\n .brief{margin-top:6px;padding-top:9px}.brief .separator{height:48px}.brief small{margin-bottom:4px}.brief p{margin:3px 0 0}\\n .insight{margin-top:5px;padding:7px 0 0}.meta-footer{padding-top:5px}\\n}\\n@media(min-width:650px){.frame{padding-left:40px;padding-right:40px}.stream{max-height:440px}.brief{gap:22px}.hero{padding-top:30px}.daybtn{height:72px}}\\n@media(max-width:360px){.frame{padding-left:15px;padding-right:15px}.big-date{font-size:72px}.day-meta strong{font-size:15px}.filter{padding:7px 8px}.stream-item{grid-template-columns:42px 13px minmax(0,1fr) auto;gap:6px}.content strong{font-size:13px}}\\n@media(max-height:700px){.hero{padding-top:0;padding-bottom:9px}.big-date{font-size:64px}.week-title{margin-top:9px}.week{padding-bottom:5px}.daybtn{height:48px}.streamhead{padding:8px 0}.stream{max-height:calc(100dvh - 449px)}.brief{margin-top:6px}}\\n@media(prefers-reduced-motion:no-preference){.daybtn,.filter,.stream-item{transition:background .14s ease,opacity .14s ease}.dialog{animation:rise .22s cubic-bezier(.2,.7,.2,1)}@keyframes rise{from{transform:translateY(12px);opacity:.8}to{transform:translateY(0);opacity:1}}}\\n/* System UI audit 2026-11-02: readable labels, reliable tap targets, and actionable-first hierarchy. */\\n.identity em,.eyebrow,.week-title span,.weeknav-hint,.daybtn .wd,\\n.streamhead small,.filter,.content small,.time.unset,.brief small,.brief p,\\n.insight p,.meta-footer,.meta-footer button,.status-pill,.sheet-sub,\\n.mwd,.month-actions button,.detail-line,.demo-banner{font-size:12px;}\\n.identity em,.eyebrow,.week-title span,.weeknav-hint,.daybtn .wd,\\n.streamhead small,.filter,.content small,.time.unset,.brief small,.brief p,\\n.insight p,.meta-footer,.meta-footer button,.status-pill,.sheet-sub,\\n.mwd,.month-actions button,.detail-line,.demo-banner{line-height:1.4;}\\n.filter,.insight p,.detail-line{font-size:14px;line-height:1.45}\\n.meta-footer{flex-wrap:wrap}\\n.iconbutton,.hero-right button,.week-nav button,.filter,.sheet-close,\\n.month-actions button,.meta-footer button,.demo-banner button{min-height:44px;}\\n.iconbutton,.week-nav button,.sheet-close{min-width:44px;}\\n.daybtn{min-height:58px}.filter{padding:9px 11px}.stream-item{min-height:62px}\\n.brief strong{white-space:normal;overflow-wrap:anywhere}\\n.insight{margin-top:11px;padding:11px 0;background:#f4f7fa;border-top:0;border-radius:12px;padding-inline:12px}\\n.stream{max-height:clamp(180px,38dvh,430px)}\\n@media(max-width:360px){.frame{padding-inline:15px}.identity em{letter-spacing:0}.header{height:auto;min-height:44px}.week-nav{gap:0}.day-meta strong{font-size:15px}}\\n\\n/* YOS one-column dayplan; all state is local-only and never a Notion completion */\\n.dayplan{background:white;border:1px solid #dce6df;border-radius:18px;margin:14px 0 10px;padding:15px 12px}\\n.dayplan h2{margin:0;font-size:22px}.planhead{display:flex;align-items:center;justify-content:space-between;gap:9px}\\n.planhead span,.planintro,.planfooter{font-size:14px;color:#5b6c61;line-height:1.5}\\n.planintro{margin:8px 0 12px}.planfooter{padding-top:10px;border-top:1px solid #e7ebe7}\\n.planrow{display:grid;grid-template-columns:46px 44px minmax(0,1fr) 40px;gap:6px;min-height:64px;align-items:center;padding:8px 0;border-top:1px solid #edf0ed}\\n.planclock{font-size:13px;color:#5d6e63}.plancheck{height:44px;width:44px;border:1px solid #c0d2c7;background:white;border-radius:12px;font-size:24px}\\n.plancheck[disabled]{border:0;color:#a0afa4;background:#f0f2f0}.plancheck.checked{background:#dcf0e4;color:#146b43}\\n.plancopy{min-width:0;display:flex;flex-direction:column;gap:3px}.plancopy strong{font-size:16px;overflow-wrap:anywhere;line-height:1.4}\\n.plancopy small{font-size:14px;line-height:1.4;color:#596a60}.planrow.checked .plancopy strong{text-decoration:line-through;color:#8a978e}\\n.planmove{display:flex;flex-direction:column;gap:2px}.planmove button{border:0;background:#edf3ef;width:40px;min-height:28px;border-radius:8px;font-size:16px}.planmove button:disabled{opacity:.25}\\n.planlocked{font-size:12px;color:#7b8a80;text-align:center}\\n.sourcelist summary{min-height:44px;padding:12px 0;font-size:15px;font-weight:750;color:#47687d}\\n.sourcelist .stream{min-height:130px;max-height:260px}\\n@media(max-width:360px){.dayplan{padding:12px 8px}.planrow{grid-template-columns:36px 40px minmax(0,1fr) 36px;gap:4px}.plancheck{width:40px}.planmove button{width:36px}.planclock{font-size:12px}}\\n</style>\\n</head>\\n<body>\\n<div class=\\\"frame\\\">\\n  <header class=\\\"header\\\"><div class=\\\"identity\\\"><strong>YOS</strong><em>CALENDAR / DAYSTREAM</em></div><div class=\\\"header-tools\\\"><button class=\\\"iconbutton\\\" id=\\\"refresh\\\" aria-label=\\\"この画面の保存済み記録を再表示。Apple・Notionの最新取得は画面を閉じて再起動\\\" title=\\\"Apple・Notionは再起動で再取得\\\">↻</button><span class=\\\"tiny-circ\\\" aria-hidden=\\\"true\\\">Y</span></div></header>\\n  <div class=\\\"demo-banner\\\" id=\\\"demoBanner\\\" hidden><span>DESIGN PREVIEW · 表示内容と金額は架空です</span><button id=\\\"useReal\\\">保存済みデータ</button></div>\\n  <section class=\\\"hero\\\"><div><div class=\\\"eyebrow\\\" id=\\\"heroEyebrow\\\">NOVEMBER · 2026</div><div class=\\\"date-line\\\"><span class=\\\"big-date\\\" id=\\\"bigDate\\\">01</span><div class=\\\"day-meta\\\"><strong id=\\\"heroDay\\\">SUNDAY</strong><span id=\\\"heroShort\\\">11月1日</span></div></div></div><div class=\\\"hero-right\\\"><div class=\\\"status-pill\\\"><b id=\\\"stateDot\\\"></b><span id=\\\"stateLabel\\\">接続状態</span></div><button id=\\\"openMonth\\\">月カレンダー <span aria-hidden=\\\"true\\\">↗</span></button></div></section>\\n  <div class=\\\"week-title\\\"><span id=\\\"weekLabel\\\">WEEK 44</span><div class=\\\"week-nav\\\"><button id=\\\"weekBack\\\" aria-label=\\\"前の週\\\">‹</button><button id=\\\"weekNext\\\" aria-label=\\\"次の週\\\">›</button></div></div>\\n  <nav class=\\\"week\\\" aria-label=\\\"日付を選択\\\" id=\\\"week\\\"></nav>\\n  <aside class=\\\"insight\\\"><svg width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"#2761d8\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M12 2.5v3M4.6 5l2.1 2.1M2.6 12h3M19.4 12h2M17.3 7.1l2.1-2.1M9 17h6M10 20h4\\\"/><path d=\\\"M8.2 14.5C6.5 12 7 8.6 9.7 7c2-1.2 5-.7 6.5 1.1 1.7 2 1.7 4.6.2 6.4-.7.9-1.3 1.5-1.4 2.5h-6c0-1-.2-1.7-.8-2.5z\\\"/></svg><p><b>YOS</b> <span id=\\\"advice\\\">確認できた情報をもとに、次の行動を整理します。</span></p></aside>\\n  <section class=\\\"dayplan\\\" aria-label=\\\"起床から就寝までの一日\\\">\\n<div class=\\\"planhead\\\"><h2>起床から就寝まで</h2><span id=\\\"planProgress\\\">—</span></div>\\n<p class=\\\"planintro\\\" id=\\\"planIntro\\\">固定予定と未指定タスクをYOSが仮配置します。</p>\\n<div id=\\\"planList\\\" role=\\\"list\\\"></div>\\n<p class=\\\"planfooter\\\" id=\\\"planFooter\\\">チェック・順番は端末内の仮記録。NotionやAppleには未反映です。</p>\\n</section>\\n<details class=\\\"sourcelist\\\"><summary>元データを確認（予定・タスク・家計）</summary>\\n  <section class=\\\"streamhead\\\"><h2><span id=\\\"flowHeading\\\">今日の流れ</span><span id=\\\"selectedSuffix\\\" style=\\\"font-weight:500;color:#8c9197;font-size:12px;margin-left:7px\\\"></span></h2><small id=\\\"eventCount\\\">—</small></section>\\n  <nav class=\\\"filter-row\\\" aria-label=\\\"情報の種類を絞り込む\\\" id=\\\"filterRow\\\"><button class=\\\"filter\\\" data-filter=\\\"all\\\" aria-pressed=\\\"true\\\"><span>すべて</span></button><button class=\\\"filter\\\" data-filter=\\\"schedule\\\" style=\\\"--c:var(--schedule)\\\" aria-pressed=\\\"true\\\"><i></i><span>予定</span></button><button class=\\\"filter\\\" data-filter=\\\"task\\\" style=\\\"--c:var(--task)\\\" aria-pressed=\\\"true\\\"><i></i><span>タスク</span></button><button class=\\\"filter\\\" data-filter=\\\"money\\\" style=\\\"--c:var(--money)\\\" aria-pressed=\\\"true\\\"><i></i><span>お金</span></button><button class=\\\"filter\\\" data-filter=\\\"habit\\\" style=\\\"--c:var(--habit)\\\" aria-pressed=\\\"true\\\"><i></i><span>習慣</span></button></nav>\\n  <div class=\\\"stream\\\" id=\\\"stream\\\" tabindex=\\\"0\\\" aria-live=\\\"polite\\\"></div></details>\\n  <aside class=\\\"brief\\\" aria-label=\\\"当日サマリー\\\"><div><small>DAY MONEY / 当日の入出金</small><strong class=\\\"money-num\\\" id=\\\"moneyValue\\\">—</strong><p id=\\\"moneyCaption\\\">未接続</p></div><div class=\\\"separator\\\" aria-hidden=\\\"true\\\"></div><div><small>HABIT / 習慣の記録</small><strong class=\\\"hab-num\\\" id=\\\"habitValue\\\">未確認</strong><p id=\\\"habitCaption\\\">未記録＝未実施ではありません</p></div></aside>\\n  <footer class=\\\"meta-footer\\\"><span id=\\\"freshness\\\">MY LIFE / Money 読み取り中</span><button id=\\\"infoButton\\\">接続状況 · 詳細 ↗</button></footer>\\n</div>\\n<dialog class=\\\"dialog\\\" id=\\\"monthDialog\\\"><div class=\\\"sheet-head\\\"><h2 id=\\\"monthTitle\\\">2026年11月</h2><button class=\\\"sheet-close\\\" id=\\\"closeMonth\\\" aria-label=\\\"閉じる\\\">×</button></div><p class=\\\"sheet-sub\\\">日付を選ぶと、生活タイムラインが切り替わります。</p><div class=\\\"month-grid\\\" id=\\\"monthGrid\\\"></div><div class=\\\"month-actions\\\"><button id=\\\"previousMonth\\\">← 前の月</button><button id=\\\"monthToday\\\">今日</button><button id=\\\"followingMonth\\\">次の月 →</button></div></dialog>\\n<dialog class=\\\"dialog\\\" id=\\\"infoDialog\\\"><div class=\\\"sheet-head\\\"><h2 id=\\\"infoTitle\\\">接続状況</h2><button class=\\\"sheet-close\\\" id=\\\"closeInfo\\\" aria-label=\\\"閉じる\\\">×</button></div><p class=\\\"sheet-sub\\\" id=\\\"infoSub\\\">この画面で実際に読めたデータの範囲を表示します。</p><div id=\\\"infoBody\\\"></div></dialog>\\n<script>\\n'use strict';\\n(()=>{\\n const $=id=>document.getElementById(id),tz='Asia/Tokyo',fmt=new Intl.DateTimeFormat('sv-SE',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}),today=fmt.format(new Date());\\n const dateKey=d=>fmt.format(d),parseDate=k=>new Date(k+'T12:00:00+09:00'),addDays=(key,n)=>{let d=parseDate(key);d.setUTCDate(d.getUTCDate()+n);return dateKey(d)};\\n const state={selected:today,month:today.slice(0,7),demo:false,items:[],native:null,lifeRead:false,lifeSynced:null,moneyRead:false,moneyPrivate:false,moneySynced:null,loadedAt:null,filters:new Set(['schedule','task','money','habit'])};\\n const str=(x,max=140)=>String(x??'').replace(/[\\\\u0000-\\\\u001F]/g,' ').trim().slice(0,max),title=(x,fallback)=>str(x,100)||fallback;\\n const isValidKey=k=>/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(String(k||''))&&dateKey(parseDate(k))===k;\\n const cash=n=>'¥'+Math.abs(n).toLocaleString('ja-JP');\\n const safeSynced=value=>{const d=typeof value==='string'?new Date(value):null;return d&&Number.isFinite(d.getTime())&&d.getTime()<=Date.now()+300000?d:null};\\n const readLocal=key=>{try{const raw=localStorage.getItem(key);return raw?JSON.parse(raw):null}catch{return null}};\\n const names={schedule:'予定',task:'タスク',money:'お金',habit:'習慣'},weekEn=['SUN','MON','TUE','WED','THU','FRI','SAT'];\\n   function normalizeLife(){const data=readLocal('yos-life-v1');const out=[];state.lifeRead=Boolean(data&&data.days&&typeof data.days==='object');state.lifeSynced=null;if(!state.lifeRead)return out;\\n    state.lifeSynced=Object.values(data.days).map(day=>safeSynced(day?.lastSync)).filter(Boolean).sort((a,b)=>b-a)[0]||null;\\n    for(const [day,source] of Object.entries(data.days)){if(!isValidKey(day)||!source||typeof source!=='object')continue;\\n      for(const e of Array.isArray(source.schedule)?source.schedule:[]){if(!e||typeof e!=='object'||!title(e.title,''))continue;const eday=isValidKey(e.date)?e.date:day;out.push({type:'schedule',date:eday,title:title(e.title,''),subtitle:e.isAllDay?'終日':e.start?String(e.start).slice(11,16):'日時未確認',source:'MY LIFE',id:'life:event:'+day+':'+str(e.id||e.title,95)});}\\n      for(const [i,t] of (Array.isArray(source.tasks)?source.tasks:[]).entries()){if(!t?.text||!str(t.text))continue;out.push({type:'task',date:day,title:title(t.text,''),subtitle:t.done===true?'完了':'未完了',done:t.done===true,source:'MY LIFE',id:'life:task:'+day+':'+str(t.id||i,80)});}\\n      if(source.routines&&typeof source.routines==='object'){\\n        const rows=Object.values(source.routines).flatMap(x=>Array.isArray(x)?x:[]).filter(x=>x&&typeof x==='object');\\n        const done=rows.filter(x=>x.done===true).length;\\n        if(done)out.push({type:'habit',date:day,title:'生活ルーティン',subtitle:`記録済み ${done}件`,source:'MY LIFE',id:'life:habit:'+day});\\n      }\\n    }\\n    return out;\\n  }\\n  function normalizeMoney(){const data=readLocal('yos-money-v2');state.moneySynced=safeSynced(data?.updatedAt);state.moneyPrivate=Boolean(data?.privacy);state.moneyRead=Boolean(data&&Array.isArray(data.transactions)&&!state.moneyPrivate);if(!state.moneyRead)return [];\\n    return data.transactions.flatMap((tx,i)=>{if(!tx||!isValidKey(str(tx.date,10)))return[];const amount=Number(tx.amount),kind=tx.type==='income'?'income':(['expense','debt','saving','investment'].includes(tx.type)?'expense':null);if(!kind||!Number.isFinite(amount)||amount<0)return[];const complete=tx.completed===true||tx.paid===true||tx.received===true||['done','paid','completed','received'].includes(str(tx.status,24).toLowerCase());return[{type:'money',date:tx.date,title:title(tx.label,'入出金'),subtitle:complete?'実績':'予定',amount:Math.round(amount),moneyKind:kind,complete,source:'Money',id:'money:tx:'+str(tx.id||i,80)}]});\\n  }\\n  function createDemo(){const base=parseDate(today),month=base.getMonth();const d=n=>{const x=new Date(base.getFullYear(),month,n,12);return dateKey(x)},current=base.getDate();\\n    const at=(offset)=>addDays(today,offset);\\n    const pairs=[{type:'schedule',date:at(0),title:'カフェで打ち合わせ',subtitle:'10:30 – 11:30'},{type:'task',date:at(0),title:'見積もりの確認',subtitle:'未完了'},{type:'habit',date:at(0),title:'食後の散歩',subtitle:'記録済み（サンプル）'},{type:'money',date:at(0),title:'日用品の購入',subtitle:'実績',amount:1680,moneyKind:'expense',complete:true},{type:'schedule',date:at(2),title:'美容室の予約',subtitle:'14:00 – 15:00'},{type:'task',date:at(2),title:'応募書類を送る',subtitle:'未完了'},{type:'money',date:at(4),title:'固定費の支払い',subtitle:'予定',amount:15800,moneyKind:'expense',complete:false},{type:'money',date:at(6),title:'入金予定',subtitle:'予定',amount:48500,moneyKind:'income',complete:false},{type:'schedule',date:at(-3),title:'友人との約束',subtitle:'18:00'},{type:'habit',date:at(-3),title:'ストレッチ',subtitle:'記録済み（サンプル）'},{type:'task',date:d(15),title:'部屋の整頓',subtitle:'未完了'},{type:'money',date:d(19),title:'予定支出',subtitle:'予定',amount:3400,moneyKind:'expense',complete:false}];\\n    return pairs.map((x,i)=>({...x,id:'demo:'+i,source:'表示例'}));\\n  }\\n\\n  const nativeTypes=new Set(['schedule','task','money','habit']);\\n  const allowedNativeSources={schedule:'Appleカレンダー',task:'Notion Tasks',money:'Notion家計',habit:'YOS 日記'};\\n  function nativeItems(snapshot){\\n    if(!snapshot||snapshot.schema!=='yos-daystream-native-v1'||!Array.isArray(snapshot.items))return [];\\n    return snapshot.items.slice(0,500).flatMap((it,i)=>{\\n      if(!it||!nativeTypes.has(it.type)||!isValidKey(it.date)||it.source!==allowedNativeSources[it.type])return [];\\n      const item={type:it.type,date:it.date,title:str(it.title,100),subtitle:str(it.subtitle,100),source:it.source,id:'native:'+i+':'+str(it.id,70)};\\n      if(!item.title)return [];\\n      if(it.type==='task'){item.done=it.done===true;item.priority=['P0','P1','P2','P3'].includes(it.priority)?it.priority:'';item.order=Number.isFinite(it.order)?it.order:null;item.fixedTime=/^\\\\d{2}:\\\\d{2}$/.test(it.fixedTime||'')?it.fixedTime:'';}\\n      if(it.type==='money'){\\n        if(state.moneyPrivate || !Number.isFinite(it.amount) || it.amount<0 || it.amount>1000000000 || !['income','expense'].includes(it.moneyKind))return [];\\n        item.amount=Math.round(it.amount);item.moneyKind=it.moneyKind;item.complete=it.complete===true;item.reviewRequired=it.reviewRequired===true;\\n      }\\n      return [item];\\n    });\\n  }\\n  function mergeRecords(records){\\n    const seen=new Set();const deduped=[];\\n    for(const x of records){\\n      // IDs represent distinct records even when title/date/amount match. Do not\\n      // collapse two real purchases based on similar display text.\\n      const key=[x.source,x.type,x.id].join('|');\\n      // Collapse visually identical tasks on the same day without deleting\\n      // or merging their underlying Notion records. Never dedupe money.\\n      const visualTaskKey=x.type==='task'?[x.type,x.date,String(x.title||'').trim().normalize('NFKC'),Boolean(x.done)].join('|'):null;\\n      if(seen.has(key)||(visualTaskKey&&seen.has('display:'+visualTaskKey)))continue;\\n      seen.add(key);if(visualTaskKey)seen.add('display:'+visualTaskKey);deduped.push(x);\\n    }\\n    return deduped;\\n  }\\n  function load(preferDemo){const life=normalizeLife(),money=normalizeMoney(),native=nativeItems(state.native);\\n    state.demo=Boolean(preferDemo??(location.protocol==='file:'&&!life.length&&!money.length&&!native.length));\\n    if(state.moneyPrivate || state.native)state.demo=false;\\n    // Notion 家計 is authoritative in native mode. If it fails, show unavailable:\\n    // never silently replace it with outdated browser Money transactions.\\n    const joined=state.native?[...native,...life]:[...life,...money];\\n    state.items=state.demo?createDemo():mergeRecords(joined);state.loadedAt=new Date();$('demoBanner').hidden=!state.demo;render();\\n  }\\n  // Scriptable invokes this after loading the existing DAYSTREAM design. Only minimum\\n  // display fields cross the native-to-WebView boundary. Never accept an API token.\\n  window.YOS_DAYSTREAM_NATIVE_V1=function(payload){\\n    if(!payload||payload.schema!=='yos-daystream-native-v1'||!Array.isArray(payload.items)||payload.items.length>500||\\n      !payload.range||!isValidKey(payload.range.start)||!isValidKey(payload.range.end)||payload.range.start>payload.range.end||\\n      (parseDate(payload.range.end)-parseDate(payload.range.start))>93*86400000||\\n      !payload.sources||typeof payload.sources!=='object'||\\n      typeof payload.generatedAt!=='string'||!safeSynced(payload.generatedAt))return false;\\n    const statuses=['ok','partial','unavailable','error'];\\n    const sources={};for(const name of ['apple','tasks','money']){\\n      const value=payload.sources[name];\\n      sources[name]={status:statuses.includes(value?.status)?value.status:'unavailable'};\\n    }\\n    state.native={schema:payload.schema,generatedAt:payload.generatedAt,range:{start:payload.range.start,end:payload.range.end},sources,items:payload.items};\\n    load(false);return true;\\n  };\\n function listDay(key=state.selected){return state.items.filter(x=>x.date===key&&state.filters.has(x.type))}\\n const dayDate=k=>{const d=parseDate(k);return {day:d.getDate(),weekday:d.getDay(),month:d.getMonth()+1,year:d.getFullYear()}};\\n function nativeSourceLabel(){const statuses=Object.values(state.native.sources).map(s=>s.status);const age=Date.now()-new Date(state.native.generatedAt).getTime();if(age>30*60*1000)return '再取得が必要';const complete=statuses.filter(s=>s==='ok').length;return complete===3?'3種類取得済み':complete||statuses.includes('partial')?'一部取得':'取得を確認できず';}\\n  function renderHeader(){const d=dayDate(state.selected);$('heroEyebrow').textContent=new Intl.DateTimeFormat('en-US',{timeZone:tz,month:'long',year:'numeric'}).format(parseDate(state.selected)).toUpperCase();$('bigDate').textContent=String(d.day).padStart(2,'0');$('heroDay').textContent=weekEn[d.weekday];$('heroShort').textContent=d.month+'月'+d.day+'日';$('stateLabel').textContent=state.demo?'デザイン見本':state.native?nativeSourceLabel():(state.lifeRead||state.moneyRead)?'保存済み記録':'未接続';$('stateDot').style.background=state.demo?'#b47d13':state.native?(nativeSourceLabel()==='3種類取得済み'?'#137c5b':'#b47d13'):state.lifeRead||state.moneyRead?'#137c5b':'#98a0a7';$('weekLabel').textContent=d.year+' / '+d.month+'月 · 日付を選ぶ';$('selectedSuffix').textContent=state.selected===today?'TODAY':'';$('flowHeading').textContent=state.selected===today?'今日の流れ':'この日の流れ';}\\n function color(t){return `var(--${t})`}\\n function countsFor(date){return [...new Set(state.items.filter(x=>x.date===date).map(x=>x.type))]}\\n function renderWeek(){const root=$('week');root.replaceChildren();const first=addDays(state.selected,-dayDate(state.selected).weekday);for(let i=0;i<7;i++){const k=addDays(first,i),d=dayDate(k),b=document.createElement('button');b.type='button';b.className='daybtn'+(state.selected===k?' selected':'')+(today===k?' today':'');b.setAttribute('aria-pressed',String(state.selected===k));b.setAttribute('aria-label',`${d.month}月${d.day}日を表示`);const w=document.createElement('span');w.className='wd';w.textContent='日月火水木金土'[d.weekday];const num=document.createElement('span');num.className='num';num.textContent=d.day;const dots=document.createElement('span');dots.className='dots';for(const t of countsFor(k)){const dot=document.createElement('i');dot.style.background=color(t);dots.append(dot)}b.append(w,num,dots);b.addEventListener('click',()=>setDay(k));root.append(b)}}\\n function eventTime(e){if(e.type!=='schedule')return '';const t=String(e.subtitle||'').match(/\\\\b(\\\\d{2}):(\\\\d{2})\\\\b/);return t?t[0]:'終日'}\\n function sortedEntries(){return listDay().sort((a,b)=>{const rank=x=>x.type==='schedule'?(eventTime(x)==='終日'?-1:0):x.type==='money'?2:x.type==='task'?3:4;let r=rank(a)-rank(b);return r||((a.type==='schedule'&&b.type==='schedule')?eventTime(a).localeCompare(eventTime(b)):0)})}\\n // DAYPLAN-BEGIN: the YOS draft plan is separate from source-of-truth records.\\n const PLAN_KEY='yos-daystream-plan-v1';\\n const routine=(id,title,subtitle)=>({id:'habit:'+id,type:'habit',title,subtitle,movable:true,checkable:true,planned:true});\\n const anchor=(id,title,subtitle)=>({id:'anchor:'+id,type:'schedule',title,subtitle,movable:false,checkable:false,planned:true});\\n function planForDay(date,records){\\n   const rows=records.filter(x=>x.date===date),scheduled=rows.filter(x=>x.type==='schedule'||(x.type==='task'&&x.fixedTime));\\n   const sortTime=x=>/^\\\\d{2}:\\\\d{2}$/.test(x.fixedTime||x.subtitle||'')?Number((x.fixedTime||x.subtitle).slice(0,2)):12;\\n   scheduled.sort((a,b)=>sortTime(a)-sortTime(b));\\n   const priorities={P0:0,P1:1,P2:2,P3:3};\\n   const tasks=rows.filter(x=>x.type==='task'&&!x.done&&!x.fixedTime).sort((a,b)=>\\n     (priorities[a.priority]??4)-(priorities[b.priority]??4)||\\n     (Number.isFinite(a.order)?a.order:9999)-(Number.isFinite(b.order)?b.order:9999)||\\n     a.title.localeCompare(b.title,'ja')).map((x,i)=>({...x,id:'task:'+x.source+':'+String(x.id).replace(/^native:\\\\d+:/,'native:'),\\n       subtitle:'YOS仮配置 · '+(i<2?'優先候補':'空き時間候補')+(x.priority?' · '+x.priority:''),\\n       movable:true,checkable:true}));\\n   const appointments=scheduled.map(x=>({...x,id:'event:'+x.source+':'+String(x.id).replace(/^native:\\\\d+:/,'native:'),movable:false,checkable:x.type==='task'}));\\n   const bills=rows.filter(x=>x.type==='money').map(x=>({...x,id:'money:'+x.source+':'+x.id,movable:false,checkable:false}));\\n   const morning=appointments.filter(x=>sortTime(x)<11),afternoon=appointments.filter(x=>sortTime(x)>=11&&sortTime(x)<18),night=appointments.filter(x=>sortTime(x)>=18);\\n   const split=Math.ceil(tasks.length/2);\\n   return [\\n     anchor('wake','起床','時刻未取得'),\\n     routine('water','水を飲む','起床後'),\\n     routine('stretch-am','朝のストレッチ','短時間'),\\n     routine('ready','身支度','起床後'),\\n     ...morning,\\n     routine('breakfast','朝食・食事を記録','Clarityで記録／献立分析はデータ接続後'),\\n     routine('walk','食後のウォーキング','5分／難しい日は1分'),\\n     ...tasks.slice(0,split),...afternoon,...bills,...tasks.slice(split),...night,\\n     routine('diary','日記・振り返り','夜／既存YOS日記'),\\n     routine('stretch-pm','夜のストレッチ','短時間'),\\n     anchor('sleep','就寝','睡眠記録と翌日の予定からの提案は未接続')\\n   ];\\n }\\n function applyPlanOrder(rows,requested) {\\n   if(!Array.isArray(requested)||requested.length>300)return rows;\\n   const mov=rows.filter(x=>x.movable),known=new Map(mov.map(x=>[x.id,x])),used=new Set(),sorted=[];\\n   for(const id of requested){if(typeof id==='string'&&known.has(id)&&!used.has(id)){sorted.push(known.get(id));used.add(id)}}\\n   for(const x of mov)if(!used.has(x.id))sorted.push(x);\\n   let i=0;return rows.map(x=>x.movable?sorted[i++]:x);\\n }\\n // DAYPLAN-END\\n let planSaved={};let planWriteStatus='端末内保存は未確認';\\n try{const raw=localStorage.getItem(PLAN_KEY),parsed=raw&&JSON.parse(raw);if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed))planSaved=parsed}catch{}\\n const dayDraft=()=>{const d=planSaved[state.selected];return d&&typeof d==='object'?d:{order:[],done:{}}};\\n function writePlan(entry){\\n   planSaved[state.selected]={order:Array.isArray(entry.order)?entry.order.slice(0,300):[],done:entry.done||{}};\\n   const keys=Object.keys(planSaved).filter(isValidKey).sort().slice(-30),data={};for(const k of keys)data[k]=planSaved[k];\\n   planSaved=data;\\n   try{const encoded=JSON.stringify(data);localStorage.setItem(PLAN_KEY,encoded);\\n     planWriteStatus=localStorage.getItem(PLAN_KEY)===encoded?'端末内の仮記録を保存':'保存を確認できず';\\n   }catch{planWriteStatus='保存不可（開いている間だけ）'}\\n }\\n const orderedPlan=()=>applyPlanOrder(planForDay(state.selected,state.items),dayDraft().order);\\n function changeCheck(id){\\n   if(state.demo)return;const row=orderedPlan().find(x=>x.id===id);if(!row?.checkable)return;\\n   const d=dayDraft(),done={...(d.done||{})};if(done[id])delete done[id];else done[id]=true;\\n   writePlan({order:d.order,done});renderPlan();\\n }\\n function changeOrder(id,delta){\\n   if(state.demo)return;const current=orderedPlan(),flex=current.filter(x=>x.movable),idx=flex.findIndex(x=>x.id===id),other=idx+delta;\\n   if(idx<0||other<0||other>=flex.length)return;\\n   [flex[idx],flex[other]]=[flex[other],flex[idx]];\\n   writePlan({order:flex.map(x=>x.id),done:dayDraft().done});renderPlan();\\n }\\n function renderPlan(){\\n   const rows=orderedPlan(),done=dayDraft().done||{},root=$('planList');root.replaceChildren();\\n   const total=rows.filter(x=>x.checkable).length,completed=rows.filter(x=>x.checkable&&done[x.id]).length;\\n   $('planProgress').textContent=completed+' / '+total+' 仮チェック';\\n   $('planIntro').textContent='時刻確定の予定は動かしません。時間未指定のタスクは優先度から仮配置します。';\\n   $('planFooter').textContent=(state.demo?'デザイン見本':planWriteStatus)+\\n     ' · チェックと並び順は端末内の仮記録。Notion／Appleの完了状態は変わりません。';\\n   const flex=rows.filter(x=>x.movable);\\n   for(const item of rows){\\n     const line=document.createElement('div');line.className='planrow'+(done[item.id]?' checked':'');line.setAttribute('role','listitem');\\n     const clock=document.createElement('span');clock.className='planclock';\\n     clock.textContent=item.type==='schedule'&&item.subtitle==='終日'?'終日':\\n       /^\\\\d{2}:\\\\d{2}$/.test(item.fixedTime||item.subtitle||'')?(item.fixedTime||item.subtitle):'順番';\\n     const tick=document.createElement('button');tick.className='plancheck'+(done[item.id]?' checked':'');tick.type='button';\\n     tick.disabled=!item.checkable||state.demo;tick.textContent=item.checkable?(done[item.id]?'✓':'○'):'•';\\n     tick.setAttribute('aria-label',item.title+'の仮チェック');if(item.checkable)tick.addEventListener('click',()=>changeCheck(item.id));\\n     const copy=document.createElement('span');copy.className='plancopy';const name=document.createElement('strong');name.textContent=item.title;\\n     const hint=document.createElement('small');hint.textContent=(item.planned?'朝夜の習慣候補':names[item.type]||'予定')+' · '+String(item.subtitle||'');\\n     copy.append(name,hint);\\n     const controls=document.createElement('span');controls.className='planmove';\\n     if(item.movable){for(const [delta,symbol] of [[-1,'↑'],[1,'↓']]){\\n       const btn=document.createElement('button');btn.type='button';btn.textContent=symbol;btn.disabled=state.demo||\\n       (delta<0?flex[0].id===item.id:flex[flex.length-1].id===item.id);\\n       btn.setAttribute('aria-label',item.title+'を'+(delta<0?'上':'下')+'へ');\\n       btn.addEventListener('click',()=>changeOrder(item.id,delta));controls.append(btn);\\n     }}else{controls.className='planlocked';controls.textContent='固定'}\\n     line.append(clock,tick,copy,controls);root.append(line);\\n   }\\n }\\n function renderStream(){const entries=sortedEntries(),root=$('stream');root.replaceChildren();$('eventCount').textContent=entries.length+'件の記録';if(!entries.length){const node=document.createElement('div');node.className='nothing';const b=document.createElement('b');b.textContent=state.demo?'この日のサンプルはありません':'この日の記録は未確認';const t=document.createElement('span');t.textContent=state.native&&(state.selected<state.native.range.start||state.selected>state.native.range.end)?'この日付はiPhoneで取得した期間の外です。再起動しても取得範囲外の場合は未確認です。':'未接続の情報は含まれません。記録なし＝予定や習慣がない、ではありません。';node.append(b,t);root.append(node);return}for(const e of entries){const row=document.createElement('button');row.type='button';row.className='stream-item '+e.type;row.style.setProperty('--color',color(e.type));const time=document.createElement('span');time.className='time'+(e.type==='schedule'?'':' unset');time.textContent=e.type==='schedule'?eventTime(e):e.type==='money'?'¥':e.type==='task'?'TODO':'LOG';const spine=document.createElement('span');spine.className='stream-spine';spine.append(document.createElement('i'));const copy=document.createElement('span');copy.className='content';const strong=document.createElement('strong');strong.textContent=e.title;const small=document.createElement('small');small.textContent=`${names[e.type]} · ${e.subtitle}${state.demo?' · サンプル':''}`;copy.append(strong,small);const end=document.createElement('span');end.className=e.type==='money'?'amount':'stream-arrow';end.textContent=e.type==='money'?(e.moneyKind==='income'?'+':'−')+cash(e.amount):'›';row.append(time,spine,copy,end);row.addEventListener('click',()=>showRecord(e));root.append(row)}}\\n function renderBrief(){const day=state.items.filter(x=>x.date===state.selected),money=day.filter(x=>x.type==='money'),hab=day.filter(x=>x.type==='habit'),can=!state.moneyPrivate&&(state.demo||(state.native?['ok','partial'].includes(state.native.sources.money.status):state.moneyRead)),moneyPartial=state.native?.sources?.money?.status==='partial';const actual=money.filter(x=>x.complete);const incoming=actual.filter(x=>x.moneyKind==='income').reduce((a,x)=>a+x.amount,0);const outgoing=actual.filter(x=>x.moneyKind==='expense').reduce((a,x)=>a+x.amount,0);const plan=money.filter(x=>!x.complete&&!x.reviewRequired),review=money.filter(x=>x.reviewRequired);$('moneyValue').textContent=(!can||moneyPartial)?'—':!money.length?'記録なし':(incoming-outgoing<0?'−':'+')+cash(incoming-outgoing);$('moneyCaption').textContent=!can?(state.moneyPrivate?'Money：非表示':'Notion家計：未接続'):moneyPartial?'Notion家計は一部取得。日別合計は未確定（明細は参考）':!money.length?'表示範囲内の入出金記録なし（取得漏れは未確認）':`確認済み実績：入金${cash(incoming)} / 支出${cash(outgoing)} · 予定${plan.length}件${review.length?' · 要照合'+review.length+'件':''}`;$('habitValue').textContent=hab.length?hab.length+'件の報告':'未確認';$('habitCaption').textContent=hab.length?'MY LIFEの保存済み実施報告':'未記録＝未実施ではありません';const next=state.items.filter(x=>x.type==='money'&&x.moneyKind==='expense'&&!x.complete&&!x.reviewRequired&&x.date>=state.selected).sort((a,b)=>a.date.localeCompare(b.date))[0];const current=day.filter(x=>x.type==='schedule'),open=day.filter(x=>x.type==='task'&&!x.done);let advice='確認できた情報から、今日の一手を整理します。';if(next&&next.date<=today&&state.selected===today)advice='支払い予定の期限を確認。完了・残高はMoneyで照合。';else if(current.length&&open.length)advice='まず時間が決まった予定を確保。その前後でタスクを1件。';else if(open.length)advice='未完了のタスクから、取りかかる1件を決めよう。';else if(next)advice='今後の支払い予定がある。残高はMoneyで確認。';else if(current.length)advice='予定を先に確保し、空いた時間は余白として残そう。';$('advice').textContent=(state.demo?'サンプル：':'')+advice;const life=state.lifeRead?'MY LIFE 保存あり':'MY LIFE 未接続',fin=state.moneyPrivate?'Money 非表示':state.moneyRead?'Money 保存あり':'Money 未接続',na=state.native,ns=na?' · Apple '+na.sources.apple.status+' / Notion Tasks '+na.sources.tasks.status+' / 家計 '+na.sources.money.status:'';const old=s=>!s||(Date.now()-s.getTime()>86400000);$('freshness').textContent=state.demo?'すべて架空の表示例':`${life}${state.lifeRead&&old(state.lifeSynced)?'（時刻未確認・古い可能性）':''} · ${fin}${state.moneyRead&&old(state.moneySynced)?'（時刻未確認・古い可能性）':''}${ns}${na?' · iPhone起動時 '+new Date(na.generatedAt).toLocaleTimeString('ja-JP')+'取得（再起動で更新）':''}`;}\\n function renderFilters(){for(const b of document.querySelectorAll('.filter')){const t=b.dataset.filter,active=t==='all'?state.filters.size===4:state.filters.has(t);b.classList.toggle('off',!active);b.setAttribute('aria-pressed',String(active))}}\\n function render(){renderHeader();renderWeek();renderFilters();renderPlan();renderStream();renderBrief()}\\n function setDay(k){if(!isValidKey(k))return;state.selected=k;state.month=k.slice(0,7);render();$('stream').scrollTop=0}\\n function openDialog(id){$(id).showModal()}function closeDialog(id){$(id).close()}\\n function renderMonth(){const [yr,mon]=state.month.split('-').map(Number),first=dateKey(new Date(yr,mon-1,1,12)),firstDay=parseDate(first).getDay(),days=new Date(yr,mon,0).getDate(),total=Math.ceil((firstDay+days)/7)*7;const root=$('monthGrid');root.replaceChildren();$('monthTitle').textContent=`${yr}年${mon}月`;for(const w of '日月火水木金土'){const sp=document.createElement('span');sp.className='mwd';sp.textContent=w;root.append(sp)}for(let i=0;i<total;i++){const k=addDays(first,i-firstDay),d=dayDate(k),b=document.createElement('button');b.className='mday'+(k===state.selected?' sel':'')+(d.month!==mon?' out':'');b.textContent=String(d.day);const dots=document.createElement('span');dots.className='mdots';for(const t of countsFor(k).slice(0,4)){const x=document.createElement('i');x.style.background=color(t);dots.append(x)}b.append(dots);b.setAttribute('aria-label',`${d.month}月${d.day}日を表示`);b.addEventListener('click',()=>{setDay(k);closeDialog('monthDialog')});root.append(b)}}\\n function showRecord(e){$('infoTitle').textContent=e.title;$('infoSub').textContent=`${e.date} · ${names[e.type]}${state.demo?' · 架空サンプル':''}`;const body=$('infoBody');body.replaceChildren();const div=document.createElement('div');div.className='detail-line';const name=document.createElement('b');name.textContent='記録の状態';const stateSpan=document.createElement('span');stateSpan.textContent=e.subtitle;div.append(name,stateSpan);body.append(div);if(e.type==='money'){const b=document.createElement('div');b.className='detail-line';const st=document.createElement('b');st.textContent='金額（'+(e.complete?'確認済み実績':e.subtitle)+'）';const v=document.createElement('span');v.textContent=cash(e.amount);b.append(st,v);body.append(b)}const origin=document.createElement('div');origin.className='detail-line';const o=document.createElement('b');o.textContent='情報源';const v=document.createElement('span');v.textContent=e.source||'表示例';origin.append(o,v);body.append(origin);if(e.type==='task'){for(const [label,value] of [['次の一手',e.nextAction],['完了条件',e.completion],['ブロッカー',e.blocker]]){if(typeof value!=='string'||!value.trim())continue;const line=document.createElement('div');line.className='detail-line';const key=document.createElement('b');key.textContent=label;const content=document.createElement('span');content.textContent=value;content.style.whiteSpace='pre-wrap';content.style.overflowWrap='anywhere';line.append(key,content);body.append(line)}}if(e.type==='task'&&!e.nextAction&&!e.completion&&!e.blocker){const hint=document.createElement('p');hint.className='sheet-sub';hint.textContent='詳しい作業内容は、この画面に取得されていません。';body.append(hint)}openDialog('infoDialog')}\\n function showSources(){$('infoTitle').textContent='データの接続状態';$('infoSub').textContent=state.native?'iPhoneのApple予定・Notionは起動時に取得。Web画面の更新だけでは再取得されません。最新情報が必要なら閉じて再起動してください。':'開いた時点で保存済み情報を再取得します。銀行・Notion・Appleのリアルタイム同期は未接続です。';const root=$('infoBody');root.replaceChildren();for(const [name,read,stamp] of [['MY LIFE',state.lifeRead,state.lifeSynced],['Money',state.moneyPrivate?'非表示':state.moneyRead,state.moneySynced],['Notion / Apple',state.native?'起動時の取得結果を下に表示':'未接続',null]]){const div=document.createElement('div');div.className='detail-line';const t=document.createElement('b');t.textContent=name;const text=document.createElement('span');text.textContent=typeof read==='string'?read:read?'このブラウザの保存済みデータを読み取り':'未接続';if(stamp)text.textContent+=' · 元データ更新 '+stamp.toLocaleString('ja-JP');div.append(t,text);root.append(div)}if(state.native){\\n    for(const [name,code] of [['Appleカレンダー','apple'],['Notion Tasks','tasks'],['Notion家計','money']]){\\n      const div=document.createElement('div');div.className='detail-line';\\n      const bold=document.createElement('b');bold.textContent=name;\\n      const span=document.createElement('span');span.textContent=({ok:'取得済み',partial:'一部取得',unavailable:'未接続',error:'取得失敗'}[state.native.sources[code].status]||'未確認')+' · '+state.native.range.start+'〜'+state.native.range.end+' / 起動時取得 '+new Date(state.native.generatedAt).toLocaleTimeString('ja-JP');\\n      div.append(bold,span);root.append(div);\\n    }\\n  }\\n  const last=document.createElement('div');last.className='detail-line';const t=document.createElement('b');t.textContent='この画面の最終読み取り';const sp=document.createElement('span');sp.textContent=state.loadedAt?state.loadedAt.toLocaleTimeString('ja-JP'):'未確認';last.append(t,sp);root.append(last);openDialog('infoDialog')}\\n $('filterRow').addEventListener('click',e=>{const b=e.target.closest('button[data-filter]');if(!b)return;if(b.dataset.filter==='all'){state.filters=new Set(['schedule','task','money','habit'])}else{const t=b.dataset.filter;if(state.filters.has(t))state.filters.delete(t);else state.filters.add(t)}render()});\\n $('weekBack').addEventListener('click',()=>setDay(addDays(state.selected,-7)));$('weekNext').addEventListener('click',()=>setDay(addDays(state.selected,7)));\\n $('openMonth').addEventListener('click',()=>{renderMonth();openDialog('monthDialog')});$('closeMonth').addEventListener('click',()=>closeDialog('monthDialog'));\\n for(const [id,delta] of [['previousMonth',-1],['followingMonth',1]]){$(id).addEventListener('click',()=>{let [y,m]=state.month.split('-').map(Number);const d=new Date(y,m-1+delta,1,12);state.month=dateKey(d).slice(0,7);renderMonth()})}\\n $('monthToday').addEventListener('click',()=>{setDay(today);closeDialog('monthDialog')});$('infoButton').addEventListener('click',showSources);$('closeInfo').addEventListener('click',()=>closeDialog('infoDialog'));$('refresh').addEventListener('click',()=>load(false));$('useReal').addEventListener('click',()=>load(false));\\n window.addEventListener('pageshow',e=>{if(e.persisted&&!state.demo)load(false)});window.addEventListener('storage',e=>{if(!state.demo&&['yos-life-v1','yos-money-v2'].includes(e.key))load(false)});window.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&!state.demo)load(false)});window.addEventListener('focus',()=>{if(!state.demo&&state.loadedAt&&Date.now()-state.loadedAt.getTime()>10000)load(false)});\\n load(undefined);\\n})();\\n</script>\\n</body></html>\";\nasync function readPreview(){\n const localHTML=HTML_BUNDLE;\n if(sha256Hex(localHTML)!==HTML_SHA256 || !localHTML.startsWith('<!doctype html>') ||\n    !localHTML.includes('window.YOS_DAYSTREAM_NATIVE_V1=') || localHTML.includes('<script src=') ||\n    localHTML.includes('fetch(') || localHTML.includes('XMLHttpRequest') ||\n    !localHTML.includes(\"const PLAN_KEY='yos-daystream-plan-v1'\") ||\n    localHTML.split('localStorage.'+'setItem(').length!==2 ||\n    !localHTML.split('localStorage.'+'setItem(')[1].startsWith('PLAN_KEY,encoded)'))throw Error('Offline DAYSTREAM HTML integrity mismatch');\n return localHTML;\n}\nasync function main(){\n  const now=new Date(),start=dateKey(addDays(now,-14)),end=dateKey(addDays(now,46));\n  let token='';try{if(Keychain.contains(NOTION_KEY))token=Keychain.get(NOTION_KEY)||''}catch{}\n  const [apple,tasks,money,html]=await Promise.all([\n    readApple(start,end),\n    readNotion(TASK_SOURCE,'期限',parseTask,start,end,token),\n    readNotion(MONEY_SOURCE,'日付',parseMoney,start,end,token),\n    readPreview()\n  ]);\n  const seenAllDay=new Set();\n  const uniqueApple=apple.rows.filter(x=>{\n    if(x.type!=='schedule'||x.subtitle!=='終日')return true;\n    const key=x.date+'|'+String(x.title||'').normalize('NFKC').replace(/[\\\\s　]+/g,'').trim();\n    if(seenAllDay.has(key))return false;\n    seenAllDay.add(key);\n    return true;\n  });\n  // Each source has a reserved quota (170/165/165): one full calendar must not displace money or Tasks.\n  // Apple/Notion sometimes hold the same calendar event under separate IDs.\n  // Collapse only a proven calendar mirror with matching day+title. Notion rows remain intact.\n  const visibleKey=item=>item.date+'|'+clean(item.title,100).normalize('NFKC').split(/\\s+/).join(' ').trim().toLocaleLowerCase('ja-JP');\n  const appleTitles=new Set(uniqueApple.map(visibleKey));\n  const uniqueTasks=tasks.rows.filter(item=>!(\n    item.calendarMirror===true && item.explicitAction!==true &&\n    appleTitles.has(visibleKey(item))\n  ));\n  // Don't send mirror metadata to WebView, only fields needed for the view.\n  const taskEntries=uniqueTasks.map(({calendarMirror,explicitAction,...viewItem})=>viewItem);\n  const allEntries=[...uniqueApple,...taskEntries,...money.rows];\n  const entries=allEntries.slice(0,500);\n  // The UI accepts at most 500 items. Never report a complete source when\n  // the combined cap silently excludes records from the visible calendar.\n  if(allEntries.length>500){\n    if(apple.status==='ok')apple.status='partial';\n    if(tasks.status==='ok')tasks.status='partial';\n    if(money.status==='ok')money.status='partial';\n  }\n  const snapshot={schema:'yos-daystream-native-v1',generatedAt:new Date().toISOString(),\n    range:{start,end},sources:{apple:{status:apple.status},tasks:{status:tasks.status},money:{status:money.status}},items:entries};\n  const web=new WebView();\n  await web.loadHTML(html);\n  // Never include Notion API tokens, credentials or internal notes in this payload.\n  const ok=await web.evaluateJavaScript('window.YOS_DAYSTREAM_NATIVE_V1('+JSON.stringify(snapshot)+')',false);\n  if(ok!==true)throw Error('Native bridge was not accepted by calendar');\n  await web.present(true);\n}\ntry {await main();} catch(error){\n  const alert=new Alert();alert.title='DAYSTREAMプレビューを表示できません';\n  alert.message='接続・読み取りを確認できませんでした。既存のカレンダーやNotionは変更していません。';\n  alert.addAction('閉じる');await alert.presentAlert();\n} finally {Script.complete();}\n",
