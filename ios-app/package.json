{
  "name": "yos-ios-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:web": "node ./scripts/prepare-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "native:configure:bravia": "node ./scripts/configure-native-ios.mjs",
    "native:configure": "npm run native:configure:bravia && npm run native:configure:capture",
    "native:init": "npm run prepare:web && npx cap add ios --packagemanager SPM && npm run native:configure",
    "native:sync": "npm run prepare:web && npx cap sync ios && npm run native:configure",
    "native:open": "npx cap open ios",
    "native:configure:capture": "node ./scripts/configure-native.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@yos/secure-credentials": "file:plugins/yos-secure-credentials",
    "@yos/google-tv-remote": "file:plugins/yos-google-tv-remote",
    "@yos/capture": "file:plugins/yos-capture"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "typescript": "^5.9.0"
  }
}
