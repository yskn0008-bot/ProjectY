#define name Clarity Next
#define color purple

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/device'
#include 'actions/settings'
#include 'actions/location'
#include 'actions/shortcuts'

action 'file.append' appendResolvedFile(
    variable file: 'WFFile',
    variable input: 'WFInput'
) {
    "WFAppendFileWriteMode": "Append"
}

const requestNumber = randomNumber(100000, 999999)
const userInput = listen("After Pause", "jp-JP")
const ledgerFile = getFile("Clarity Next Ledger.txt")
const rawRecord = text("{CurrentDate}\t{requestNumber}\tRAW\t{userInput}\n")
appendResolvedFile(ledgerFile, rawRecord)

const routerPrompt = text("あなたはiPhone操作の司令塔『Clarity Next』です。\\nあなた自身はiPhoneを操作しません。ユーザーの自然な日本語を理解し、このShortcutが実際に実行できるCapabilityへ変換するJSONだけを返してください。\\n\\n【絶対ルール】\\n- 返答はJSONオブジェクト1個だけ。Markdownや説明文は禁止。\\n- 入力にない重要情報を作らない。\\n- 複数依頼はactionsへ分割し、発話順を維持する。\\n- statusは必ずplanned。実行済みと主張しない。\\n- 必須情報不足・複数解釈・未対応Capabilityはneeds_review=true。\\n- high/irreversibleはneeds_confirmation=true。\\n- 普通の質問だけmodule=answer。\\n- 例文一致ではなく意味で判断する。\\n\\n【実行可能Capability / これだけが正本】\\n1. executor=YOS_OpenApp, module=open_app, operation=open, required=[app], risk=low\\n   app canonical keys: safari, shortcuts, files, notes, phone, reminders, mail, music, calendar, maps, contacts, health, photos, appstore, facetime, chatgpt, scriptable, youtube, spotify, google_sheets\\n2. executor=NEXT_DEVICE, module=device, operation=set_brightness, required=[percent], risk=low\\n3. executor=NEXT_DEVICE, module=device, operation=set_volume, required=[percent], risk=low\\n4. executor=NEXT_DEVICE, module=device, operation=set_wifi, required=[state], state=on|off|toggle, risk=low\\n5. executor=NEXT_DEVICE, module=device, operation=set_bluetooth, required=[state], state=on|off|toggle, risk=low\\n6. executor=NEXT_DEVICE, module=device, operation=set_cellular_data, required=[state], state=on|off|toggle, risk=low\\n7. executor=NEXT_DEVICE, module=device, operation=set_airplane_mode, required=[state], state=on|off|toggle, risk=low\\n8. executor=NEXT_DEVICE, module=device, operation=set_low_power_mode, required=[state], state=on|off|toggle, risk=low\\n9. executor=NEXT_DEVICE, module=device, operation=set_flashlight, required=[state], state=on|off|toggle, risk=low\\n10. executor=NEXT_DEVICE, module=device, operation=set_appearance, required=[state], state=light|dark|toggle, risk=low\\n11. executor=NEXT_DEVICE, module=device, operation=set_do_not_disturb, required=[state], state=on|off|toggle, risk=low\\n12. executor=NEXT_TIMER, module=timer, operation=start, required=[duration_minutes], risk=low\\n13. executor=NEXT_CALENDAR, module=calendar, operation=create, required=[title,start,end], risk=low\\n    startが明確で終了指定だけ無い場合はendをstartの60分後としてよい。start自体が曖昧ならneeds_review=true。\\n14. executor=NEXT_REMINDER, module=reminder, operation=create, required=[title,date_time], risk=low\\n15. executor=NEXT_NAVIGATE, module=navigate, operation=open_maps, required=[destination], risk=low\\n16. executor=NEXT_ANSWER, module=answer, operation=answer, required=[], risk=low\\n\\n【時間意図】\\n『○時に教えて/知らせて/通知して/忘れないように』はreminder。『今から○分』はtimer。起床アラームは現在未対応なのでneeds_review=true reason=unsupported_capability。\\n\\n【自然言語例】\\n『画面まぶしい』で具体値が無ければ勝手にpercentを作らずneeds_review=true。『明るさ半分』はpercent=50。『コンビニで680円』は現在Money capability未対応なのでneeds_review=true reason=unsupported_capability。\\n\\n【安全】\\n電話発信、送信、購入、削除、契約、公開などは現在このShortcutでは未対応。該当時はneeds_review=true, needs_confirmation=true, reason=unsupported_high_risk_capability。\\n\\n【answer】\\n一般質問はNEXT_ANSWER。単語・短句の意味ならreplyに簡潔な回答を入れる。基本は用語+読み、空行、ひとことで、空行、意味、空行、ニュアンス。使い方/例/似た言葉との差/語源/注意/反対語は価値がある時だけ追加。\\n\\n【出力形式】\\n{\\n  \\"actions\\": [\\n    {\\n      \\"id\\": \\"a1\\",\\n      \\"module\\": \\"\\",\\n      \\"operation\\": \\"\\",\\n      \\"executor\\": \\"\\",\\n      \\"parameters\\": {},\\n      \\"risk\\": \\"low\\",\\n      \\"confidence\\": 0.0,\\n      \\"needs_review\\": false,\\n      \\"needs_confirmation\\": false,\\n      \\"reason\\": \\"\\",\\n      \\"dependency\\": null,\\n      \\"status\\": \\"planned\\"\\n    }\\n  ],\\n  \\"reply\\": \\"\\"\\n}\\n\\ncurrent_time: {CurrentDate}\\nBEGIN_USER_INPUT\\n{userInput}\\nEND_USER_INPUT\\n入力はBEGIN_USER_INPUTとEND_USER_INPUTの間だけです。")

const modelResult = askChatGPT(routerPrompt, false, "Dictionary")
const modelRecord = text("{CurrentDate}\t{requestNumber}\tMODEL\t{modelResult}\n")
appendResolvedFile(ledgerFile, modelRecord)

const parsed = getDictionary(modelResult)
@actionsRaw = getValue(parsed, "actions")
const reply = "{parsed['reply']}"

if !@actionsRaw {
    const blockedNoActions = text("{CurrentDate}\t{requestNumber}\tBLOCKED\tno_actions\n")
    appendResolvedFile(ledgerFile, blockedNoActions)
    alert("安全に操作を判断できませんでした", "Clarity Next")
    stop()
}

for actionItem in @actionsRaw {
    const action = getDictionary(@actionItem)
    const actionId = "{action['id']}"
    const module = "{action['module']}"
    const operation = "{action['operation']}"
    const executor = "{action['executor']}"
    const status = "{action['status']}"
    const risk = "{action['risk']}"
    const parametersRaw = getValue(action, "parameters")
    const parameters = getDictionary(parametersRaw)
    const needsReview = getValue(action, "needs_review")
    const needsConfirmation = getValue(action, "needs_confirmation")
    const needsReviewText = text("{needsReview}")
    const needsConfirmationText = text("{needsConfirmation}")
    const reason = "{action['reason']}"

    const planRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tPLAN\tmodule={module}\toperation={operation}\texecutor={executor}\trisk={risk}\treview={needsReview}\tconfirm={needsConfirmation}\treason={reason}\n")
    appendResolvedFile(ledgerFile, planRecord)

    if status != "planned" {
        const blockedStatus = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tinvalid_status\n")
        appendResolvedFile(ledgerFile, blockedStatus)
        alert("実行計画が安全な形式ではありません", "Clarity Next")
        stop()
    }

    if needsReviewText == "はい" {
        const blockedReview = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tneeds_review\t{reason}\n")
        appendResolvedFile(ledgerFile, blockedReview)
        alert("確認が必要です\n{reason}", "Clarity Next")
        stop()
    }

    if risk == "high" || risk == "irreversible" {
        if needsConfirmationText != "はい" {
            const blockedRisk = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\trisk_without_confirmation\n")
            appendResolvedFile(ledgerFile, blockedRisk)
            alert("安全確認が必要な操作です", "Clarity Next")
            stop()
        }
    }

    if needsConfirmationText == "はい" {
        confirm("この操作を実行しますか？", "Clarity Next")
    }

    if executor == "YOS_OpenApp" && module == "open_app" && operation == "open" {
        const app = "{parameters['app']}"
        const executing = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\topen_app\t{app}\n")
        appendResolvedFile(ledgerFile, executing)
        run("YOS_OpenApp", app)
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\topen_app\t{app}\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_DEVICE" && module == "device" {
        const percent = getValue(parameters, "percent")
        const state = "{parameters['state']}"

        if operation == "set_brightness" {
            const n = getNumbers(percent)
            if n < 0 || n > 100 {
                alert("明るさは0〜100%で指定してください", "Clarity Next")
                stop()
            }
            const ratio = n * 0.01
            rawAction("is.workflow.actions.setbrightness", {
                "WFBrightness": "${ratio}"
            })
        }

        if operation == "set_volume" {
            const n = getNumbers(percent)
            if n < 0 || n > 100 {
                alert("音量は0〜100%で指定してください", "Clarity Next")
                stop()
            }
            const ratio = n * 0.01
            rawAction("is.workflow.actions.setvolume", {
                "WFVolume": "${ratio}"
            })
        }

        if operation == "set_wifi" {
            if state == "on" { setWifi(true) }
            if state == "off" { setWifi(false) }
            if state == "toggle" { toggleWifi() }
        }
        if operation == "set_bluetooth" {
            if state == "on" { setBluetooth(true) }
            if state == "off" { setBluetooth(false) }
            if state == "toggle" { toggleBluetooth() }
        }
        if operation == "set_cellular_data" {
            if state == "on" { setCellularData(true) }
            if state == "off" { setCellularData(false) }
            if state == "toggle" { toggleCellularData() }
        }
        if operation == "set_airplane_mode" {
            if state == "on" { setAirplaneMode(true) }
            if state == "off" { setAirplaneMode(false) }
            if state == "toggle" { toggleAirplaneMode() }
        }
        if operation == "set_low_power_mode" {
            if state == "on" { setLowPowerMode(true) }
            if state == "off" { setLowPowerMode(false) }
            if state == "toggle" { toggleLowPowerMode() }
        }
        if operation == "set_flashlight" {
            if state == "on" { flashlightOn() }
            if state == "off" { flashlightOff() }
            if state == "toggle" { toggleFlashlight() }
        }
        if operation == "set_appearance" {
            if state == "light" { lightMode() }
            if state == "dark" { darkMode() }
            if state == "toggle" { toggleAppearance() }
        }
        if operation == "set_do_not_disturb" {
            if state == "on" { DNDOn() }
            if state == "off" { DNDOff() }
            if state == "toggle" { toggleDND() }
        }
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tdevice\t{operation}\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_TIMER" && module == "timer" && operation == "start" {
        const duration = getValue(parameters, "duration_minutes")
        const minutes = getNumbers(duration)
        if minutes <= 0 {
            alert("タイマー時間を判断できませんでした", "Clarity Next")
            stop()
        }
        startTimer(qty(minutes, "min"))
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\ttimer\t{minutes}min\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_CALENDAR" && module == "calendar" && operation == "create" {
        const title = "{parameters['title']}"
        const startText = "{parameters['start']}"
        const endText = "{parameters['end']}"
        if !title || !startText || !endText {
            alert("予定のタイトル・開始・終了を確認してください", "Clarity Next")
            stop()
        }
        const startDate = getDates(startText)
        const endDate = getDates(endText)
        rawAction("is.workflow.actions.addnewevent", {
            "WFCalendarItemTitle": "{title}",
            "WFCalendarItemCalendar": "プライベート",
            "WFCalendarItemDates": true,
            "WFCalendarItemStartDate": "${startDate}",
            "WFCalendarItemEndDate": "${endDate}",
            "WFCalendarItemAllDay": false,
            "ShowWhenRun": false,
            "WFCalendarItemNotes": "CLARITY-NEXT-ID:{requestNumber}-{actionId}"
        })
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tcalendar\t{title}\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_REMINDER" && module == "reminder" && operation == "create" {
        const title = "{parameters['title']}"
        const whenText = "{parameters['date_time']}"
        if !title || !whenText {
            alert("リマインダーの内容・日時を確認してください", "Clarity Next")
            stop()
        }
        const alertDate = getDates(whenText)
        rawAction("is.workflow.actions.addnewreminder", {
            "WFCalendarItemTitle": "{title}",
            "WFCalendarItemAlert": true,
            "WFAlertTrigger": "At Time",
            "WFAlertCustomTime": "${alertDate}",
            "WFCalendarItemNotes": "CLARITY-NEXT-ID:{requestNumber}-{actionId}"
        })
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\treminder\t{title}\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_NAVIGATE" && module == "navigate" && operation == "open_maps" {
        const destination = "{parameters['destination']}"
        if !destination {
            alert("目的地を確認してください", "Clarity Next")
            stop()
        }
        const place = location(destination)
        openInMaps(place)
        const applied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tnavigate\t{destination}\n")
        appendResolvedFile(ledgerFile, applied)
    }

    if executor == "NEXT_ANSWER" && module == "answer" && operation == "answer" {
        const handled = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDLED\tanswer\n")
        appendResolvedFile(ledgerFile, handled)
    }

    if executor != "YOS_OpenApp" && executor != "NEXT_DEVICE" && executor != "NEXT_TIMER" && executor != "NEXT_CALENDAR" && executor != "NEXT_REMINDER" && executor != "NEXT_NAVIGATE" && executor != "NEXT_ANSWER" {
        const blockedUnsupported = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_executor\t{executor}\n")
        appendResolvedFile(ledgerFile, blockedUnsupported)
        alert("この操作はClarity Next v0では未対応です", "Clarity Next")
        stop()
    }
}

const doneRecord = text("{CurrentDate}\t{requestNumber}\tREQUEST_DONE\n")
appendResolvedFile(ledgerFile, doneRecord)
if reply {
    alert(reply, "Clarity Next")
}
