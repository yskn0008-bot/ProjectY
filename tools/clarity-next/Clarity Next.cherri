#define name Clarity Next
#define color purple

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/device'
#include 'actions/settings'
#include 'actions/location'
#include 'actions/web'
#include 'actions/shortcuts'

const requestNumber = randomNumber(100000, 999999)
const userInput = listen("After Pause", "jp-JP")
const rawRecord = text("{CurrentDate}\t{requestNumber}\tRAW\t{userInput}\n")
appendToFile("Clarity Next Ledger.txt", rawRecord)

const routerPrompt = text("あなたはiPhone操作の司令塔『Clarity Next』です。\\nあなた自身はiPhoneを操作しません。ユーザーの自然な日本語を理解し、このShortcutが実際に実行できるCapabilityへ変換するDictionaryだけを返してください。\\n\\n絶対ルール: 返答はDictionary1個だけ。入力にない重要情報を作らない。複数依頼はactionsへ分割し発話順を維持する。statusは必ずplanned。必須情報不足・複数解釈・未対応Capabilityはneeds_review=true。highまたはirreversibleはneeds_confirmation=true。普通の質問だけmodule=answer。例文一致ではなく意味で判断する。\\n\\n実行可能Capabilityは次の対応を厳守する。左から executor / module / operation / required_parameters。YOS_OpenApp / open_app / open / app。NEXT_DEVICE / device / set_brightness / percent。NEXT_DEVICE / device / set_volume / percent。NEXT_DEVICE / device / set_wifi / state。NEXT_DEVICE / device / set_bluetooth / state。NEXT_DEVICE / device / set_cellular_data / state。NEXT_DEVICE / device / set_airplane_mode / state。NEXT_DEVICE / device / set_low_power_mode / state。NEXT_DEVICE / device / set_flashlight / state。NEXT_DEVICE / device / set_appearance / state。NEXT_DEVICE / device / set_do_not_disturb / state。NEXT_TIMER / timer / start / duration_minutes。NEXT_CALENDAR / calendar / create / title,start,end。NEXT_REMINDER / reminder / create / title,date_time。NEXT_NAVIGATE / navigate / open_maps / destination。NEXT_NOTION / notion / open_yos_home / none。NEXT_MONEY / money / capture / raw_text。NEXT_ANSWER / answer / answer / none。executorには必ず左端の値、moduleには必ず2番目の値を入れる。絶対にexecutorとmoduleを逆にしない。これ以外は実行可能と判断しない。\\n\\nOpen app canonical keys: safari, shortcuts, files, notes, phone, reminders, mail, music, calendar, maps, contacts, health, photos, appstore, facetime, chatgpt, scriptable, youtube, spotify, google_sheets。NotionのBASE HOME（YOS HOME）を開く意図（『ベースホーム開いて』『BASE HOME開いて』『HOME開いて』『Notionホーム開いて』『Notionのホーム開いて』『作戦室開いて』『今やることをNotionで見せて』『YOS HOME開いて』）はNEXT_NOTION / notion / open_yos_home。音声認識でYOSが誤変換されることがあるため、通常の音声入口は『ベースホーム開いて』を推奨し、YOSという語が無くてもBASE HOME / HOME / Notion+ホーム / 作戦室の意図が明確なら同じ既存Notionページを開く。一般のNotion操作やタスクの追加・更新・削除はまだ実行せずneeds_review=true。device stateはon, off, toggle。appearance stateはlight, dark, toggle。percentは0から100。\\n\\n時間意図: 『○時に教えて/知らせて/通知して/忘れないように』はreminder。『今から○分』はtimer。calendarはstartが明確で終了指定だけ無い場合、endをstartの60分後としてよい。startが曖昧ならneeds_review=true。起床アラームは現在未対応なのでneeds_review=true, reason=unsupported_capability。\\n\\nタイトル保持: calendar/reminderのtitleは、ユーザーが内容として述べた語句をできる限りそのまま保持する。『予定』『会議』『予約』『支払い』『薬を飲む』など、内容の一部になっている語を勝手に削除・言い換えしない。例: 『明日の14時から15時にテスト予定を入れて』→ title=『テスト予定』。日時指定や『入れて』『知らせて』など操作を表す部分だけを除く。\\n\\n自然言語: 『画面まぶしい』で具体値が無ければpercentを作らずneeds_review=true。『明るさ半分』はpercent=50。『コンビニで680円』のような実際の支出・入金・残高更新はNEXT_MONEY。parameters.raw_textにはユーザーのMoney部分を省略・言い換えせず入れる。Moneyへの記録は現実の送金ではなくローカル家計簿更新なのでlow。金額が無い、意味が複数ある、未来の契約・送金指示はneeds_review=true。\\n\\n安全: 電話発信、送信、購入、削除、契約、公開などは現在未対応。該当時はneeds_review=true, needs_confirmation=true, reason=unsupported_high_risk_capability。\\n\\nanswer: 一般質問はNEXT_ANSWER。単語・短句の意味ならreplyに簡潔な回答。基本は用語+読み、空行、ひとことで、空行、意味、空行、ニュアンス。使い方、例、似た言葉との差、語源、注意、反対語は価値がある時だけ追加。\\n\\n出力Dictionaryの最上位キーはactionsとreply。actionsはList。各actionのキーはid,module,operation,executor,parameters,risk,confidence,needs_review,needs_confirmation,reason,dependency,status。parametersはDictionary。idはa1,a2の順。statusはplannedのみ。confidenceは0.0から1.0。\\n\\ncurrent_time: {CurrentDate}\\nBEGIN_USER_INPUT\\n{userInput}\\nEND_USER_INPUT\\n入力はBEGIN_USER_INPUTとEND_USER_INPUTの間だけです。")

const modelResult = askChatGPT(routerPrompt, false, "Dictionary")
const modelRecord = text("{CurrentDate}\t{requestNumber}\tMODEL\t{modelResult}\n")
appendToFile("Clarity Next Ledger.txt", modelRecord)

const parsed = getDictionary(modelResult)
@actionsRaw = getValue(parsed, "actions")
const reply = "{parsed['reply']}"

if !@actionsRaw {
    const blockedNoActions = text("{CurrentDate}\t{requestNumber}\tBLOCKED\tno_actions\n")
    appendToFile("Clarity Next Ledger.txt", blockedNoActions)
    alert("安全に操作を判断できませんでした", "Clarity Next")
    stop()
}

for actionItem in @actionsRaw {
    const action = getDictionary(@actionItem)
    const actionId = "{action['id']}"
    const module = "{action['module']}"
    const operation = "{action['operation']}"
    const executor = "{action['executor']}"
    const status = "{action['status']}"
    const risk = "{action['risk']}"
    const parametersRaw = getValue(action, "parameters")
    const parameters = getDictionary(parametersRaw)
    const needsReview = getValue(action, "needs_review")
    const needsConfirmation = getValue(action, "needs_confirmation")
    const needsReviewText = text("{needsReview}")
    const needsConfirmationText = text("{needsConfirmation}")
    const reason = "{action['reason']}"

    // Defensive normalization: some model outputs can swap module and executor.
    // Normalize only the exact known pairs; unknown pairs remain fail-closed.
    @normalizedModule = "{module}"
    @normalizedExecutor = "{executor}"
    if executor == "open_app" && module == "YOS_OpenApp" {
        @normalizedModule = "open_app"
        @normalizedExecutor = "YOS_OpenApp"
    }
    if executor == "device" && module == "NEXT_DEVICE" {
        @normalizedModule = "device"
        @normalizedExecutor = "NEXT_DEVICE"
    }
    if executor == "timer" && module == "NEXT_TIMER" {
        @normalizedModule = "timer"
        @normalizedExecutor = "NEXT_TIMER"
    }
    if executor == "calendar" && module == "NEXT_CALENDAR" {
        @normalizedModule = "calendar"
        @normalizedExecutor = "NEXT_CALENDAR"
    }
    if executor == "reminder" && module == "NEXT_REMINDER" {
        @normalizedModule = "reminder"
        @normalizedExecutor = "NEXT_REMINDER"
    }
    if executor == "navigate" && module == "NEXT_NAVIGATE" {
        @normalizedModule = "navigate"
        @normalizedExecutor = "NEXT_NAVIGATE"
    }
    if executor == "notion" && module == "NEXT_NOTION" {
        @normalizedModule = "notion"
        @normalizedExecutor = "NEXT_NOTION"
    }
    if executor == "money" && module == "NEXT_MONEY" {
        @normalizedModule = "money"
        @normalizedExecutor = "NEXT_MONEY"
    }
    if executor == "answer" && module == "NEXT_ANSWER" {
        @normalizedModule = "answer"
        @normalizedExecutor = "NEXT_ANSWER"
    }

    const planRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tPLAN\tmodule={normalizedModule}\toperation={operation}\texecutor={normalizedExecutor}\trisk={risk}\treview={needsReview}\tconfirm={needsConfirmation}\treason={reason}\n")
    appendToFile("Clarity Next Ledger.txt", planRecord)

    if status != "planned" {
        const blockedStatus = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tinvalid_status\n")
        appendToFile("Clarity Next Ledger.txt", blockedStatus)
        alert("実行計画が安全な形式ではありません", "Clarity Next")
        stop()
    }

    if needsReviewText == "はい" {
        const blockedReview = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tneeds_review\t{reason}\n")
        appendToFile("Clarity Next Ledger.txt", blockedReview)
        alert("確認が必要です\n{reason}", "Clarity Next")
        stop()
    }

    if risk == "high" || risk == "irreversible" {
        if needsConfirmationText != "はい" {
            const blockedRisk = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\trisk_without_confirmation\n")
            appendToFile("Clarity Next Ledger.txt", blockedRisk)
            alert("安全確認が必要な操作です", "Clarity Next")
            stop()
        }
    }

    if needsConfirmationText == "はい" {
        confirm("この操作を実行しますか？", "Clarity Next")
    }

    if @normalizedExecutor == "YOS_OpenApp" && @normalizedModule == "open_app" && operation == "open" {
        const app = "{parameters['app']}"
        const executing = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\topen_app\t{app}\n")
        appendToFile("Clarity Next Ledger.txt", executing)
        run("YOS_OpenApp", app)
        const openAppApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\topen_app\t{app}\n")
        appendToFile("Clarity Next Ledger.txt", openAppApplied)
    }

    if @normalizedExecutor == "NEXT_DEVICE" && @normalizedModule == "device" {
        const percent = getValue(parameters, "percent")
        const state = "{parameters['state']}"

        if operation == "set_brightness" {
            const brightnessPercent = getNumbers(percent)
            if brightnessPercent < 0 || brightnessPercent > 100 {
                alert("明るさは0〜100%で指定してください", "Clarity Next")
                stop()
            }
            const brightnessRatio = brightnessPercent * 0.01
            rawAction("is.workflow.actions.setbrightness", {
                "WFBrightness": "${brightnessRatio}"
            })
        }

        if operation == "set_volume" {
            const volumePercent = getNumbers(percent)
            if volumePercent < 0 || volumePercent > 100 {
                alert("音量は0〜100%で指定してください", "Clarity Next")
                stop()
            }
            const volumeRatio = volumePercent * 0.01
            rawAction("is.workflow.actions.setvolume", {
                "WFVolume": "${volumeRatio}"
            })
        }

        if operation == "set_wifi" {
            if state == "on" { setWifi(true) }
            if state == "off" { setWifi(false) }
            if state == "toggle" { toggleWifi() }
        }
        if operation == "set_bluetooth" {
            if state == "on" { setBluetooth(true) }
            if state == "off" { setBluetooth(false) }
            if state == "toggle" { toggleBluetooth() }
        }
        if operation == "set_cellular_data" {
            if state == "on" { setCellularData(true) }
            if state == "off" { setCellularData(false) }
            if state == "toggle" { toggleCellularData() }
        }
        if operation == "set_airplane_mode" {
            if state == "on" { setAirplaneMode(true) }
            if state == "off" { setAirplaneMode(false) }
            if state == "toggle" { toggleAirplaneMode() }
        }
        if operation == "set_low_power_mode" {
            if state == "on" { setLowPowerMode(true) }
            if state == "off" { setLowPowerMode(false) }
            if state == "toggle" { toggleLowPowerMode() }
        }
        if operation == "set_flashlight" {
            if state == "on" { flashlightOn() }
            if state == "off" { flashlightOff() }
            if state == "toggle" { toggleFlashlight() }
        }
        if operation == "set_appearance" {
            if state == "light" { lightMode() }
            if state == "dark" { darkMode() }
            if state == "toggle" { toggleAppearance() }
        }
        if operation == "set_do_not_disturb" {
            if state == "on" { DNDOn() }
            if state == "off" { DNDOff() }
            if state == "toggle" { toggleDND() }
        }
        const deviceApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tdevice\t{operation}\n")
        appendToFile("Clarity Next Ledger.txt", deviceApplied)
    }

    if @normalizedExecutor == "NEXT_TIMER" && @normalizedModule == "timer" && operation == "start" {
        const duration = getValue(parameters, "duration_minutes")
        const minutes = getNumbers(duration)
        if minutes <= 0 {
            alert("タイマー時間を判断できませんでした", "Clarity Next")
            stop()
        }
        startTimer(qty(minutes, "min"))
        const timerApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\ttimer\t{minutes}min\n")
        appendToFile("Clarity Next Ledger.txt", timerApplied)
    }

    if @normalizedExecutor == "NEXT_CALENDAR" && @normalizedModule == "calendar" && operation == "create" {
        const eventTitle = "{parameters['title']}"
        const startText = "{parameters['start']}"
        const endText = "{parameters['end']}"
        if !eventTitle || !startText || !endText {
            alert("予定のタイトル・開始・終了を確認してください", "Clarity Next")
            stop()
        }
        // iOS Japanese locale can reject ISO 8601 text with "T" in Detect Dates.
        // Normalize model timestamps to a locale-friendly form before conversion.
        const startNoT = replaceText("T", " ", startText)
        const startNormalized = replaceText("-", "/", startNoT)
        const endNoT = replaceText("T", " ", endText)
        const endNormalized = replaceText("-", "/", endNoT)
        const startDate = getDates(startNormalized)
        const endDate = getDates(endNormalized)
        rawAction("is.workflow.actions.addnewevent", {
            "WFCalendarItemTitle": "{eventTitle}",
            "WFCalendarItemCalendar": "プライベート",
            "WFCalendarItemDates": true,
            "WFCalendarItemStartDate": "${startDate}",
            "WFCalendarItemEndDate": "${endDate}",
            "WFCalendarItemAllDay": false,
            "ShowWhenRun": false
        })
        const calendarApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tcalendar\t{eventTitle}\n")
        appendToFile("Clarity Next Ledger.txt", calendarApplied)
    }

    if @normalizedExecutor == "NEXT_REMINDER" && @normalizedModule == "reminder" && operation == "create" {
        const reminderTitle = "{parameters['title']}"
        const whenText = "{parameters['date_time']}"
        if !reminderTitle || !whenText {
            alert("リマインダーの内容・日時を確認してください", "Clarity Next")
            stop()
        }
        const reminderNoT = replaceText("T", " ", whenText)
        const reminderNormalized = replaceText("-", "/", reminderNoT)
        const alertDate = getDates(reminderNormalized)
        rawAction("is.workflow.actions.addnewreminder", {
            "WFCalendarItemTitle": "{reminderTitle}",
            "WFCalendarItemAlert": true,
            "WFAlertTrigger": "At Time",
            "WFAlertCustomTime": "${alertDate}"
        })
        const reminderApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\treminder\t{reminderTitle}\n")
        appendToFile("Clarity Next Ledger.txt", reminderApplied)
    }

    if @normalizedExecutor == "NEXT_NAVIGATE" && @normalizedModule == "navigate" && operation == "open_maps" {
        const destination = "{parameters['destination']}"
        if !destination {
            alert("目的地を確認してください", "Clarity Next")
            stop()
        }
        const place = location(destination)
        openInMaps(place)
        const navigateApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tnavigate\t{destination}\n")
        appendToFile("Clarity Next Ledger.txt", navigateApplied)
    }

    if @normalizedExecutor == "NEXT_NOTION" && @normalizedModule == "notion" && operation == "open_yos_home" {
        const notionHomeURL = text("https://www.notion.so/3ed5ca882895819aaa57c139ea36fe2b")
        const notionHandoff = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDOFF\tnotion_yos_home\n")
        appendToFile("Clarity Next Ledger.txt", notionHandoff)
        openURL(notionHomeURL)
        const notionApplied = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tnotion_yos_home\n")
        appendToFile("Clarity Next Ledger.txt", notionApplied)
    }

    if @normalizedExecutor == "NEXT_MONEY" && @normalizedModule == "money" && operation == "capture" {
        const moneyRaw = "{parameters['raw_text']}"
        if !moneyRaw {
            const moneyBlocked = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tmoney_missing_text\n")
            appendToFile("Clarity Next Ledger.txt", moneyBlocked)
            alert("Moneyに記録する内容を確認してください", "Clarity Next")
            stop()
        }
        const moneyEncoded = urlEncode(moneyRaw)
        const moneyURL = text("https://yskn0008-bot.github.io/ProjectY/yos/money-capture.html?text={moneyEncoded}")
        const moneyHandoff = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDOFF\tmoney_capture\n")
        appendToFile("Clarity Next Ledger.txt", moneyHandoff)
        openURL(moneyURL)
        stop()
    }

    if @normalizedExecutor == "NEXT_ANSWER" && @normalizedModule == "answer" && operation == "answer" {
        const handled = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDLED\tanswer\n")
        appendToFile("Clarity Next Ledger.txt", handled)
    }

    if @normalizedExecutor != "YOS_OpenApp" && @normalizedExecutor != "NEXT_DEVICE" && @normalizedExecutor != "NEXT_TIMER" && @normalizedExecutor != "NEXT_CALENDAR" && @normalizedExecutor != "NEXT_REMINDER" && @normalizedExecutor != "NEXT_NAVIGATE" && @normalizedExecutor != "NEXT_NOTION" && @normalizedExecutor != "NEXT_MONEY" && @normalizedExecutor != "NEXT_ANSWER" {
        const blockedUnsupported = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_executor\t{normalizedExecutor}\n")
        appendToFile("Clarity Next Ledger.txt", blockedUnsupported)
        alert("この操作はClarity Next v0では未対応です", "Clarity Next")
        stop()
    }
}

const doneRecord = text("{CurrentDate}\t{requestNumber}\tREQUEST_DONE\n")
appendToFile("Clarity Next Ledger.txt", doneRecord)
if reply {
    alert(reply, "Clarity Next")
}
