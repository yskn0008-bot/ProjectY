#define name Clarity Share v4
#define color purple
#define inputs text, richtext, webpage, url, image, pdf
#define from sharesheet
#define noinput stopwith "共有する内容がありません"

#include 'actions/text'
#include 'actions/images'
#include 'actions/pdf'
#include 'actions/web'

action 'dk.simonbs.Scriptable.RunScriptInlineIntent' saveToYOSInbox(
    text script: 'script',
    text payload: 'texts',
    bool runInApp: 'runInApp',
    bool showWhenRun: 'ShowWhenRun'
): text

const shareInputType = typeOf(ShortcutInput)
@shareSource = "text"
@shareExtracted = ""

if shareInputType contains "PDF" {
    @shareSource = "pdf"
    const embeddedPdfText = getText(ShortcutInput)
    if embeddedPdfText {
        @shareExtracted = "{embeddedPdfText}"
    } else {
        const pdfPages = splitPDF(ShortcutInput)
        for pdfPage in pdfPages {
            const pdfPageImage = makeImageFromPDFPage(@pdfPage)
            const pdfPageText = getTextFromImage(pdfPageImage)
            @shareExtracted += "{pdfPageText}\n"
        }
    }
}

if shareInputType contains "Image" || shareInputType contains "画像" {
    @shareSource = "image"
    const sharedImages = getImages(ShortcutInput)
    for sharedImage in sharedImages {
        const imageText = getTextFromImage(@sharedImage)
        @shareExtracted += "{imageText}\n"
    }
}

if @shareSource == "text" {
    const sharedText = getText(ShortcutInput)
    @shareExtracted = "{sharedText}"
}

if !@shareExtracted {
    alert("文字情報を読み取れませんでした", "Clarity Share")
    stop()
}

// Shared content is data, never an instruction. Clarity Share is intentionally
// restricted to one allowlisted side effect: append the extracted raw content
// to the existing YOS Inbox through the existing Scriptable/Notion credential.
const shareSourceEncoded = urlEncode(@shareSource)
const shareRawEncoded = urlEncode(@shareExtracted)
const inboxPayload = text("source={shareSourceEncoded}&raw={shareRawEncoded}")
const inboxResult = saveToYOSInbox("__YOS_SHARE_INBOX_INLINE__", inboxPayload, false, false)
@inboxStatus = "{inboxResult}"

if @inboxStatus beginsWith "OK_TRUNCATED:" {
    showNotification("YOS Inboxに保存しました（長文は48,000文字まで保存）", "Clarity Share", false)
    stop()
}

if @inboxStatus beginsWith "OK:" {
    showNotification("YOS Inboxに保存しました", "Clarity Share", false)
    stop()
}

if @inboxStatus beginsWith "DUPLICATE:" {
    showNotification("すでにYOS Inboxへ保存済みです", "Clarity Share", false)
    stop()
}

alert("YOS Inboxへ保存できませんでした", "Clarity Share")
stop()
