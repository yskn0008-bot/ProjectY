#define name Clarity
#define color blue

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'

// Voice -> existing Raw First inbox -> ChatGPT Dictionary -> fail-closed policy gate.
// Existing Clarity Inbox.txt stays the only raw fail-safe; no second raw store is created.
const originalInput = listen("After Pause", "jp-JP")
const requestNumber = randomNumber(100000, 999999)
const rawRecord = text("{CurrentDate}\t{requestNumber}\t{originalInput}\n")
appendToFile("Clarity Inbox.txt", rawRecord)

const modelPrompt = text("You are Clarity, the single natural-language gateway for MY WAY by YOS.\nPreserve original_input exactly. Never claim execution. Never invent dates, recipients, prices, accounts, destinations, device state, or automation capabilities.\nReturn only a Dictionary. Use only executors idea, memo, task, calendar, reminder, shopping, answer, shortcut_factory.\nUse only domains life, work, money, home, idea, shopping, communication, knowledge, system, other.\nUse only intents remember, answer, create, update, find, compare, decide, execute, monitor, notify, send, buy, organize, automate.\nUse only urgencies now, soon, today, scheduled, background.\nUse only risks low, medium, high, irreversible.\nIf calendar or reminder date/time is ambiguous, set needs_review=true rather than guessing.\nHigh or irreversible risk requires requires_confirmation=true. external_write=true also requires confirmation. Every action status must be planned.\nWhen the user asks to remove a repeated iPhone operation, create an Apple Shortcut, or automate an iPhone workflow, use executor shortcut_factory, domain system, intent automate. Shortcut generation/validation may be planned for low-risk requests without confirmation, but never claim installed, signed, published, or usable until a downstream executor verifies it.\nrequest_id: {requestNumber}\ncurrent_time: {CurrentDate}\noriginal_input: {originalInput}\nReturn keys request_id, original_input, context, interpretation, actions, watches, feedback. context has current_time, current_priorities, relevant_state. interpretation has objective, domains, urgency, risk, confidence. Each action has id, executor, domain, intent, target, content, conditions, destination, requires_confirmation, external_write, needs_review, dependency, status, date_time. Each watch has condition, check_target, action_when_true. feedback has summary, next_action, whisper_line. For a pure answer request, put the answer in feedback.summary. For captures or planned actions, keep feedback.summary empty unless the user must see something now.")

const modelResult = askChatGPT(modelPrompt, false, "Dictionary")
const parsedResult = getDictionary(modelResult)
const echoedInput = "{parsedResult['original_input']}"
const interpretationRaw = getValue(parsedResult, "interpretation")
const interpretation = getDictionary(interpretationRaw)
const risk = "{interpretation['risk']}"
@actionsRaw = getValue(parsedResult, "actions")

if echoedInput != "{originalInput}" {
    mustOutput("ここだけ確認して", "入力内容の確認が必要です")
}

if risk == "high" || risk == "irreversible" {
    mustOutput("ここだけ決めて", "大きな操作なので確認が必要です")
}

if !@actionsRaw {
    mustOutput("ここだけ確認して", "やることを安全に判断できませんでした")
}

for actionItem in @actionsRaw {
    const actionDict = getDictionary(@actionItem)
    const executor = "{actionDict['executor']}"
    const domain = "{actionDict['domain']}"
    const intent = "{actionDict['intent']}"
    const status = "{actionDict['status']}"
    const dateTime = "{actionDict['date_time']}"

    if status != "planned" {
        mustOutput("ここだけ確認して", "実行済み扱いの内容は受け付けません")
    }

    if executor != "idea" && executor != "memo" && executor != "task" && executor != "calendar" && executor != "reminder" && executor != "shopping" && executor != "answer" && executor != "shortcut_factory" {
        mustOutput("ここだけ確認して", "対応外の操作は実行しません")
    }

    if executor == "shortcut_factory" {
        if domain != "system" || intent != "automate" {
            mustOutput("ここだけ確認して", "自動化の内容を安全に整理できませんでした")
        }
    }

    if executor == "calendar" || executor == "reminder" {
        if !dateTime {
            mustOutput("ここだけ確認して", "日時だけ確認してください")
        }
    }
}

const ledgerRecord = text("{CurrentDate}\t{requestNumber}\tplanned\t{modelResult}\n")
appendToFile("Clarity Ledger.txt", ledgerRecord)

const feedbackRaw = getValue(parsedResult, "feedback")
const feedback = getDictionary(feedbackRaw)
const summary = "{feedback['summary']}"
if summary {
    show("{summary}")
}
