#define name Clarity
#define color blue
#define inputs text

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/device'
#include 'actions/settings'
#include 'actions/web'
#include 'actions/shortcuts'


// iOS 26 real-device compatibility: resolve the file first, then append through WFFile.
// Cherri v2.3.0's stock appendToFile() emits path-only WFFilePath, which can complete
// without persisting on current Shortcuts. This definition intentionally uses WFFile.
action 'file.append' appendResolvedFile(
    variable file: 'WFFile',
    variable input: 'WFInput'
) {
    "WFAppendFileWriteMode": "Append"
}

// Text Shortcut Input when supplied; otherwise voice -> Raw First -> ChatGPT Dictionary -> fail-closed policy -> local v1 executors -> Verify/Ledger.
// Existing Clarity Inbox.txt stays the raw fail-safe. Executor writes are local/reversible only.
// BUILD_ID is replaced post-compile with the exact verified GitHub commit SHA.
// Never use the Shortcut filename as runtime identity.
const buildId = text("__CLARITY_BUILD_ID__")
const requestNumber = randomNumber(100000, 999999)
@originalInput = "{ShortcutInput}"
if !@originalInput {
    @originalInput = listen("After Pause", "jp-JP")
}
const rawRecord = text("{CurrentDate}\t{requestNumber}\tRAW\t{@originalInput}\n")
const inboxFile = getFile("Clarity Inbox.txt")
appendResolvedFile(inboxFile, rawRecord)
const ledgerFile = getFile("Clarity Ledger.txt")
const bootRecord = text("{CurrentDate}\tBOOT\t{buildId}\t{requestNumber}\n")
appendResolvedFile(ledgerFile, bootRecord)

// Zero-network fast path for the first acceptance command.
// Raw First is already persisted above. This stays fail-closed and delegates execution
// to the same fixed YOS_OpenApp child, but avoids the ChatGPT round-trip for Safari.
if @originalInput contains "開いて" {
    if @originalInput contains "Safari" || @originalInput contains "サファリ" {
        const fastSafariRouteRecord = text("{CurrentDate}\\t{requestNumber}\\tFAST_ROUTE\\topen_app\\tsafari\\n")
        appendResolvedFile(ledgerFile, fastSafariRouteRecord)
        const fastSafariTarget = text("safari")
        run("YOS_OpenApp", fastSafariTarget)
        const fastSafariAppliedRecord = text("{CurrentDate}\\t{requestNumber}\\tAPPLIED\\topen_app\\tsafari\\tYOS_OpenApp\\tchild_returned\\tfast_path\\n")
        appendResolvedFile(ledgerFile, fastSafariAppliedRecord)
        const fastSafariDoneRecord = text("{CurrentDate}\\t{requestNumber}\\tREQUEST_DONE\\n")
        appendResolvedFile(ledgerFile, fastSafariDoneRecord)
        stop()
    }
}

const modelPrompt = text("You are Clarity, the single natural-language gateway for MY WAY by YOS.\nPreserve original_input exactly. Never claim execution. Never invent dates, recipients, prices, accounts, destinations, device state, app availability, setting state, or automation capabilities.\nReturn only a Dictionary. Use only executors idea, memo, task, calendar, reminder, shopping, answer, open_app, device_setting, myway.\nUse only domains life, work, money, home, idea, shopping, communication, knowledge, system, other.\nUse only intents remember, answer, create, update, find, compare, decide, execute, monitor, notify, send, buy, organize, automate.\nUse only urgencies now, soon, today, scheduled, background.\nUse only risks low, medium, high, irreversible.\nCalendar, Reminders, Shopping, Idea in Box, Clarity Inbox, opening an allowlisted app, changing an allowlisted local device setting, and opening the existing MY WAY Home are local reversible destinations: set external_write=false for those. external_write=true means a write to another person, remote service, purchase, contract, destructive system, or other non-local side effect.\nIf calendar or reminder date/time is ambiguous, set needs_review=true rather than guessing. For calendar only: when the start date/time is unambiguous but the user gives no duration/end time, set end_date_time to exactly 60 minutes after date_time. Never use that default to resolve an ambiguous start.\nHigh or irreversible risk requires requires_confirmation=true. external_write=true also requires confirmation. Every action status must be planned.\nUse action.content as the human-readable item/event/idea text to save. For shopping, use only the item text in content, without commentary. For idea, preserve the idea itself in content.\nFor app opening, use executor=open_app, domain=system, intent=execute, destination=App. Put one canonical target in target and the user's app label in content. Executable app targets are: safari, shortcuts, files, notes, phone, reminders, mail, music, calendar, maps, contacts, health, photos, appstore, facetime, chatgpt, scriptable, youtube, spotify, google_sheets. Normalize obvious Japanese/English names to those keys. If the requested app is not in this allowlist, preserve its name in target/content and set needs_review=true instead of guessing a bundle id.\nFor local device settings, use executor=device_setting, domain=system, intent=update, destination=iPhone. Executable targets are wifi, bluetooth, cellular_data, airplane_mode, low_power_mode, brightness, volume, appearance, flashlight, do_not_disturb. For wifi/bluetooth/cellular_data/airplane_mode/low_power_mode/flashlight/do_not_disturb, content must be on, off, or toggle. For appearance, content must be light, dark, or toggle. For brightness and volume, content must be a decimal integer from 0 through 100 representing percent. If the desired value is unclear or a different setting is requested, set needs_review=true instead of guessing.\nWhen the user asks to see, open, summarize, or check MY WAY / MYWAY / マイウェイの current information, use executor=myway, domain=life, intent=find, target=home, destination=MY WAY Home, external_write=false, needs_review=false. This opens the existing MY WAY Home, which already combines 今ここ・ここまで・行き先・次の一歩; do not create a duplicate summary.\nIf multiple actions include open_app or myway, put display/opening actions after settings or local writes so the Shortcut can finish earlier actions before switching apps.\nrequest_id: {requestNumber}\ncurrent_time: {CurrentDate}\noriginal_input: {@originalInput}\nReturn keys request_id, original_input, context, interpretation, actions, watches, feedback. context has current_time, current_priorities, relevant_state. interpretation has objective, domains, urgency, risk, confidence. Each action has id, executor, domain, intent, target, content, conditions, destination, requires_confirmation, external_write, needs_review, dependency, status, date_time, end_date_time. Each watch has condition, check_target, action_when_true. feedback has summary, next_action, whisper_line. For a pure answer request, put the answer in feedback.summary. For captures or planned actions, keep feedback.summary empty unless the user must see something now.")

const modelResult = askChatGPT(modelPrompt, false, "Dictionary")
const modelRawRecord = text("{CurrentDate}\t{requestNumber}\tMODEL_RAW\t{modelResult}\n")
appendResolvedFile(ledgerFile, modelRawRecord)
const parsedResult = getDictionary(modelResult)
const echoedInput = "{parsedResult['original_input']}"
const interpretationRaw = getValue(parsedResult, "interpretation")
const interpretation = getDictionary(interpretationRaw)
const risk = "{interpretation['risk']}"
@actionsRaw = getValue(parsedResult, "actions")

if echoedInput != "{@originalInput}" {
    const blockedOriginalRecord = text("{CurrentDate}\t{requestNumber}\tBLOCKED\toriginal_input_mismatch\n")
    appendResolvedFile(ledgerFile, blockedOriginalRecord)
    mustOutput("ここだけ確認して", "入力内容の確認が必要です")
}

if risk == "high" || risk == "irreversible" {
    const blockedRiskRecord = text("{CurrentDate}\t{requestNumber}\tBLOCKED\thigh_risk\n")
    appendResolvedFile(ledgerFile, blockedRiskRecord)
    mustOutput("ここだけ決めて", "大きな操作なので確認が必要です")
}

@lastExecutor = ""
@handoffExecutor = ""
@handoffTarget = ""

// Fail-safe only for high-confidence local display requests.
// This runs only when the model returned no actions, so it cannot override a valid model plan.
if !@actionsRaw {
    if @originalInput contains "開いて" {
        if @originalInput contains "MY WAY" || @originalInput contains "MYWAY" || @originalInput contains "マイウェイ" {
            @handoffExecutor = "myway"
            @handoffTarget = "home"
            const fallbackMyWayRecord = text("{CurrentDate}\t{requestNumber}\tFALLBACK_ROUTE\tmyway\thome\n")
            appendResolvedFile(ledgerFile, fallbackMyWayRecord)
        }
        if @originalInput contains "ChatGPT" || @originalInput contains "チャットGPT" {
            @handoffExecutor = "open_app"
            @handoffTarget = "chatgpt"
            const fallbackChatGPTRecord = text("{CurrentDate}\t{requestNumber}\tFALLBACK_ROUTE\topen_app\tchatgpt\n")
            appendResolvedFile(ledgerFile, fallbackChatGPTRecord)
        }
        if @originalInput contains "Safari" || @originalInput contains "サファリ" {
            @handoffExecutor = "open_app"
            @handoffTarget = "safari"
            const fallbackSafariRecord = text("{CurrentDate}\t{requestNumber}\tFALLBACK_ROUTE\topen_app\tsafari\n")
            appendResolvedFile(ledgerFile, fallbackSafariRecord)
        }
    }
}

if !@actionsRaw && !@handoffExecutor {
    const blockedNoActionsRecord = text("{CurrentDate}\t{requestNumber}\tBLOCKED\tno_actions\n")
    appendResolvedFile(ledgerFile, blockedNoActionsRecord)
    mustOutput("ここだけ確認して", "やることを安全に判断できませんでした")
}

for actionItem in @actionsRaw {
    const actionDict = getDictionary(@actionItem)
    const actionId = "{actionDict['id']}"
    const executor = "{actionDict['executor']}"
    @lastExecutor = "{executor}"
    const domain = "{actionDict['domain']}"
    const intent = "{actionDict['intent']}"
    const status = "{actionDict['status']}"
    const target = "{actionDict['target']}"
    const content = "{actionDict['content']}"
    const dateTime = "{actionDict['date_time']}"
    const endDateTime = "{actionDict['end_date_time']}"
    const requiresConfirmation = getValue(actionDict, "requires_confirmation")
    const externalWrite = getValue(actionDict, "external_write")
    const needsReview = getValue(actionDict, "needs_review")
    // Shortcuts renders Dictionary booleans as localized text when inserted into Text.
    // Real-device evidence on this Japanese iPhone: false -> "いいえ", true -> "はい".
    // Compare those Text outputs explicitly instead of using bare-boolean If conditions,
    // which Shortcuts compiled as existence checks and blocked even when the value was false.
    // 2026-09-24 device diagnosis: Calendar reached EXECUTING/APPLIED after bypassing only these broken gates.
    const requiresConfirmationText = text("{requiresConfirmation}")
    const externalWriteText = text("{externalWrite}")
    const needsReviewText = text("{needsReview}")
    const modelDecisionRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tMODEL_DECISION\texecutor={executor}\tdate_time={dateTime}\tend_date_time={endDateTime}\tneeds_review={needsReview}\toriginal_input={@originalInput}\n")
    appendResolvedFile(ledgerFile, modelDecisionRecord)

    if status != "planned" {
        const blockedStatusRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tmodel_claimed_execution\n")
        appendResolvedFile(ledgerFile, blockedStatusRecord)
        mustOutput("ここだけ確認して", "実行済み扱いの内容は受け付けません")
    }

    if executor != "idea" && executor != "memo" && executor != "task" && executor != "calendar" && executor != "reminder" && executor != "shopping" && executor != "answer" && executor != "open_app" && executor != "device_setting" && executor != "myway" {
        const blockedExecutorRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_executor\n")
        appendResolvedFile(ledgerFile, blockedExecutorRecord)
        mustOutput("ここだけ確認して", "対応外の操作は実行しません")
    }

    if executor == "open_app" {
        if domain != "system" || intent != "execute" {
            const blockedOpenAppRouteRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsafe_open_app_contract\n")
            appendResolvedFile(ledgerFile, blockedOpenAppRouteRecord)
            mustOutput("ここだけ確認して", "アプリ起動の内容を安全に整理できませんでした")
        }
    }

    if executor == "device_setting" {
        if domain != "system" || intent != "update" {
            const blockedSettingRouteRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsafe_device_setting_contract\n")
            appendResolvedFile(ledgerFile, blockedSettingRouteRecord)
            mustOutput("ここだけ確認して", "設定変更の内容を安全に整理できませんでした")
        }
    }

    if executor == "myway" {
        if domain != "life" || intent != "find" {
            const blockedMyWayRouteRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsafe_myway_contract\n")
            appendResolvedFile(ledgerFile, blockedMyWayRouteRecord)
            mustOutput("ここだけ確認して", "MY WAY表示の内容を安全に整理できませんでした")
        }
    }

    if executor == "calendar" {
        if !dateTime || !endDateTime {
            const blockedCalendarTimeRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tmissing_calendar_time\n")
            appendResolvedFile(ledgerFile, blockedCalendarTimeRecord)
            mustOutput("ここだけ確認して", "予定の日時だけ確認してください")
        }
    }

    if executor == "reminder" {
        if !dateTime {
            const blockedReminderTimeRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tmissing_reminder_time\n")
            appendResolvedFile(ledgerFile, blockedReminderTimeRecord)
            mustOutput("ここだけ確認して", "通知する日時だけ確認してください")
        }
    }

    if needsReviewText == "はい" {
        const blockedReviewRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tneeds_review\n")
        appendResolvedFile(ledgerFile, blockedReviewRecord)
        mustOutput("ここだけ確認して", "曖昧な点があるため自動では進めません")
    }

    if externalWriteText == "はい" && requiresConfirmationText == "いいえ" {
        const blockedExternalRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\texternal_write_without_confirmation\n")
        appendResolvedFile(ledgerFile, blockedExternalRecord)
        mustOutput("ここだけ確認して", "外部への変更は確認なしでは実行しません")
    }

    if requiresConfirmationText == "はい" {
        const blockedConfirmationRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\trequires_confirmation\n")
        appendResolvedFile(ledgerFile, blockedConfirmationRecord)
        mustOutput("ここだけ決めて", "実行前に確認が必要です")
    }

    if executor == "idea" {
        const ideaExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\tidea\n")
        appendResolvedFile(ledgerFile, ideaExecutingRecord)
        const ideaPayloadRecord = text("{CurrentDate}\tYOS-CLARITY-ID:{requestNumber}-{actionId}\t{content}\n")
        const ideaFile = getFile("Idea in Box.txt")
        appendResolvedFile(ideaFile, ideaPayloadRecord)
        const ideaAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tIdea in Box.txt\n")
        appendResolvedFile(ledgerFile, ideaAppliedRecord)
    }

    if executor == "memo" {
        // Raw First already persisted the exact input in Clarity Inbox.txt before AI ran.
        const memoAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tClarity Inbox.txt\n")
        appendResolvedFile(ledgerFile, memoAppliedRecord)
    }

    if executor == "calendar" {
        const calendarExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\tcalendar\n")
        appendResolvedFile(ledgerFile, calendarExecutingRecord)
        // Convert model-resolved text through Detect Dates. Current iOS exports
        // reliably feed Detect Dates outputs into Add New Event date fields.
        const startDate = getDates(dateTime)
        const endDate = getDates(endDateTime)
        rawAction("is.workflow.actions.addnewevent", {
            "WFCalendarItemTitle": "{content}",
            "WFCalendarItemCalendar": "プライベート",
            "WFCalendarItemDates": true,
            "WFCalendarItemStartDate": "${startDate}",
            "WFCalendarItemEndDate": "${endDate}",
            "WFCalendarItemAllDay": false,
            "ShowWhenRun": false,
            "WFCalendarItemNotes": "YOS-CLARITY-ID:{requestNumber}-{actionId}"
        })
        const calendarAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tcalendar\tYOS-CLARITY-ID:{requestNumber}-{actionId}\n")
        appendResolvedFile(ledgerFile, calendarAppliedRecord)
    }

    if executor == "reminder" {
        const reminderExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\treminder\n")
        appendResolvedFile(ledgerFile, reminderExecutingRecord)
        const alertDate = getDates(dateTime)
        rawAction("is.workflow.actions.addnewreminder", {
            "WFCalendarItemTitle": "{content}",
            "WFCalendarItemAlert": true,
            "WFAlertTrigger": "At Time",
            "WFAlertCustomTime": "${alertDate}",
            "WFCalendarItemNotes": "YOS-CLARITY-ID:{requestNumber}-{actionId}"
        })
        const reminderAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\treminder\tYOS-CLARITY-ID:{requestNumber}-{actionId}\n")
        appendResolvedFile(ledgerFile, reminderAppliedRecord)
    }

    if executor == "task" || executor == "shopping" {
        const taskExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\t{executor}\n")
        appendResolvedFile(ledgerFile, taskExecutingRecord)
        rawAction("is.workflow.actions.addnewreminder", {
            "WFCalendarItemTitle": "{content}",
            "WFCalendarItemAlert": false,
            "WFCalendarItemNotes": "YOS-CLARITY-ID:{requestNumber}-{actionId}"
        })
        const taskAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\t{executor}\tYOS-CLARITY-ID:{requestNumber}-{actionId}\n")
        appendResolvedFile(ledgerFile, taskAppliedRecord)
    }

    if executor == "answer" {
        const answerHandledRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDLED\tanswer\n")
        appendResolvedFile(ledgerFile, answerHandledRecord)
    }

    if executor == "device_setting" {
        const settingExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\tdevice_setting\t{target}={content}\n")
        appendResolvedFile(ledgerFile, settingExecutingRecord)

        if target != "wifi" && target != "bluetooth" && target != "cellular_data" && target != "airplane_mode" && target != "low_power_mode" && target != "brightness" && target != "volume" && target != "appearance" && target != "flashlight" && target != "do_not_disturb" {
            const blockedSettingTargetRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_device_setting\n")
            appendResolvedFile(ledgerFile, blockedSettingTargetRecord)
            mustOutput("ここだけ確認して", "この設定変更にはまだ対応していません")
        }

        if target == "wifi" || target == "bluetooth" || target == "cellular_data" || target == "airplane_mode" || target == "low_power_mode" || target == "flashlight" || target == "do_not_disturb" {
            if content != "on" && content != "off" && content != "toggle" {
                const blockedSettingValueRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tinvalid_device_setting_value\n")
                appendResolvedFile(ledgerFile, blockedSettingValueRecord)
                mustOutput("ここだけ確認して", "設定する値を安全に判断できませんでした")
            }
        }

        if target == "appearance" {
            if content != "light" && content != "dark" && content != "toggle" {
                const blockedAppearanceValueRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tinvalid_appearance_value\n")
                appendResolvedFile(ledgerFile, blockedAppearanceValueRecord)
                mustOutput("ここだけ確認して", "表示モードを安全に判断できませんでした")
            }
        }

        if target == "wifi" {
            if content == "on" { setWifi(true) }
            if content == "off" { setWifi(false) }
            if content == "toggle" { toggleWifi() }
        }
        if target == "bluetooth" {
            if content == "on" { setBluetooth(true) }
            if content == "off" { setBluetooth(false) }
            if content == "toggle" { toggleBluetooth() }
        }
        if target == "cellular_data" {
            if content == "on" { setCellularData(true) }
            if content == "off" { setCellularData(false) }
            if content == "toggle" { toggleCellularData() }
        }
        if target == "airplane_mode" {
            if content == "on" { setAirplaneMode(true) }
            if content == "off" { setAirplaneMode(false) }
            if content == "toggle" { toggleAirplaneMode() }
        }
        if target == "low_power_mode" {
            if content == "on" { setLowPowerMode(true) }
            if content == "off" { setLowPowerMode(false) }
            if content == "toggle" { toggleLowPowerMode() }
        }
        if target == "appearance" {
            if content == "light" { lightMode() }
            if content == "dark" { darkMode() }
            if content == "toggle" { toggleAppearance() }
        }
        if target == "flashlight" {
            if content == "on" { flashlightOn() }
            if content == "off" { flashlightOff() }
            if content == "toggle" { toggleFlashlight() }
        }
        if target == "do_not_disturb" {
            if content == "on" { DNDOn() }
            if content == "off" { DNDOff() }
            if content == "toggle" { toggleDND() }
        }
        if target == "brightness" {
            const brightnessPercent = getNumbers(content)
            if brightnessPercent < 0 || brightnessPercent > 100 {
                const blockedBrightnessRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tbrightness_out_of_range\n")
                appendResolvedFile(ledgerFile, blockedBrightnessRecord)
                mustOutput("ここだけ確認して", "明るさは0〜100%で指定してください")
            }
            const brightnessRatio = brightnessPercent * 0.01
            rawAction("is.workflow.actions.setbrightness", {
                "WFBrightness": "${brightnessRatio}"
            })
        }
        if target == "volume" {
            const volumePercent = getNumbers(content)
            if volumePercent < 0 || volumePercent > 100 {
                const blockedVolumeRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tvolume_out_of_range\n")
                appendResolvedFile(ledgerFile, blockedVolumeRecord)
                mustOutput("ここだけ確認して", "音量は0〜100%で指定してください")
            }
            const volumeRatio = volumePercent * 0.01
            rawAction("is.workflow.actions.setvolume", {
                "WFVolume": "${volumeRatio}"
            })
        }

        const settingAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tAPPLIED\tdevice_setting\t{target}={content}\n")
        appendResolvedFile(ledgerFile, settingAppliedRecord)
    }

    if executor == "open_app" {
        const appExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\topen_app\t{target}\n")
        appendResolvedFile(ledgerFile, appExecutingRecord)

        if target != "safari" && target != "shortcuts" && target != "files" && target != "notes" && target != "phone" && target != "reminders" && target != "mail" && target != "music" && target != "calendar" && target != "maps" && target != "contacts" && target != "health" && target != "photos" && target != "appstore" && target != "facetime" && target != "chatgpt" && target != "scriptable" && target != "youtube" && target != "spotify" && target != "google_sheets" {
            const blockedAppTargetRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_app\n")
            appendResolvedFile(ledgerFile, blockedAppTargetRecord)
            mustOutput("ここだけ確認して", "このアプリはまだ起動リストにありません")
        }

        @handoffExecutor = "open_app"
        @handoffTarget = "{target}"
        const appAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDOFF_READY\topen_app\t{target}\n")
        appendResolvedFile(ledgerFile, appAppliedRecord)
    }

    if executor == "myway" {
        if target != "home" {
            const blockedMyWayTargetRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tBLOCKED\tunsupported_myway_target\n")
            appendResolvedFile(ledgerFile, blockedMyWayTargetRecord)
            mustOutput("ここだけ確認して", "表示するMY WAY画面を判断できませんでした")
        }
        const myWayExecutingRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tEXECUTING\tmyway\thome\n")
        appendResolvedFile(ledgerFile, myWayExecutingRecord)
        @handoffExecutor = "myway"
        @handoffTarget = "home"
        const myWayAppliedRecord = text("{CurrentDate}\t{requestNumber}\t{actionId}\tHANDOFF_READY\tmyway\thome\n")
        appendResolvedFile(ledgerFile, myWayAppliedRecord)
    }

}

const feedbackRaw = getValue(parsedResult, "feedback")
const feedback = getDictionary(feedbackRaw)
const summary = "{feedback['summary']}"

// Fixed-child handoff. APPLIED is written only if Run Shortcut returns control.
// If YOS_OpenApp or its Open App action errors, Shortcuts stops before this record.
if @handoffExecutor == "open_app" {
    run("YOS_OpenApp", @handoffTarget)
    const appVerifiedRecord = text("{CurrentDate}\t{requestNumber}\tAPPLIED\topen_app\t{@handoffTarget}\tYOS_OpenApp\tchild_returned\n")
    appendResolvedFile(ledgerFile, appVerifiedRecord)
    const requestDoneOpenApp = text("{CurrentDate}\t{requestNumber}\tREQUEST_DONE\n")
    appendResolvedFile(ledgerFile, requestDoneOpenApp)
    stop()
}

if @handoffExecutor == "myway" {
    const requestDoneMyWay = text("{CurrentDate}\t{requestNumber}\tREQUEST_DONE\n")
    appendResolvedFile(ledgerFile, requestDoneMyWay)
    openURL("https://yskn0008-bot.github.io/ProjectY/yos/")
    stop()
}

if !@handoffExecutor {
    const requestDone = text("{CurrentDate}\t{requestNumber}\tREQUEST_DONE\n")
    appendResolvedFile(ledgerFile, requestDone)
    if summary {
        show("{summary}")
    }
}
