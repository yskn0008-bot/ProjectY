{
  "version": "1.0",
  "domains": [
    "life",
    "work",
    "money",
    "home",
    "idea",
    "shopping",
    "communication",
    "knowledge",
    "system",
    "other"
  ],
  "intents": [
    "remember",
    "answer",
    "create",
    "update",
    "find",
    "compare",
    "decide",
    "execute",
    "monitor",
    "notify",
    "send",
    "buy",
    "organize"
  ],
  "urgencies": ["now", "soon", "today", "scheduled", "background"],
  "risks": ["low", "medium", "high", "irreversible"],
