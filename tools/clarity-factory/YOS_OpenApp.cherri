if @target == "facetime" {
    openApp("facetime")
    output("YOS_OPEN_APP_OK:facetime")
}
if @target == "chatgpt" {
    openApp("com.openai.chat")
    output("YOS_OPEN_APP_OK:chatgpt")
}
if @target == "scriptable" {
    openApp("dk.simonbs.Scriptable")
    output("YOS_OPEN_APP_OK:scriptable")
