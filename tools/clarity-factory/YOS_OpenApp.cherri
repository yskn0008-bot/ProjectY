#define name YOS_OpenApp
#define color blue
#define inputs text

#include 'actions/device'

// Fixed child for Clarity open_app. Input is one canonical allowlisted target.
// It returns an explicit success token only after the Open App action is issued.
@target = "{ShortcutInput}"

if @target == "safari" {
    openApp("safari")
    output("YOS_OPEN_APP_OK:safari")
}
if @target == "shortcuts" {
    openApp("shortcuts")
    output("YOS_OPEN_APP_OK:shortcuts")
}
if @target == "files" {
    openApp("files")
    output("YOS_OPEN_APP_OK:files")
}
if @target == "notes" {
    openApp("notes")
    output("YOS_OPEN_APP_OK:notes")
}
if @target == "phone" {
    openApp("phone")
    output("YOS_OPEN_APP_OK:phone")
}
if @target == "reminders" {
    openApp("reminders")
    output("YOS_OPEN_APP_OK:reminders")
}
if @target == "mail" {
    openApp("mail")
    output("YOS_OPEN_APP_OK:mail")
}
if @target == "music" {
    openApp("music")
    output("YOS_OPEN_APP_OK:music")
}
if @target == "calendar" {
    openApp("calendar")
    output("YOS_OPEN_APP_OK:calendar")
}
if @target == "maps" {
    openApp("maps")
    output("YOS_OPEN_APP_OK:maps")
