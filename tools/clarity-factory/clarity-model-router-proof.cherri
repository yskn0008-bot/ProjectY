#define name Clarity Model Router Proof
#define color blue
#include 'actions/text'
#include 'actions/intelligence'
#include 'actions/shortcuts'

// Side-effect-free physical proof for:
// natural input -> Use Model structured actions -> existing Router -> child Shortcut.
// Every terminal path shows an explicit diagnostic before returning the typed result,
// so the physical acceptance harness cannot succeed or fail silently.
action 'is.workflow.actions.output' outputValue(variable value: 'WFOutput')

const originalInput = listen("After Pause", "jp-JP")

const modelPrompt = text("You are Clarity's UNDERSTAND layer. Structure the user's natural input into one or more actions. Preserve original_input exactly. Never claim execution. Return only a Dictionary with keys original_input and actions. actions must be an array. Each action must contain exactly these contract fields: id, module, input, risk, external_write, needs_review, needs_confirmation, status. For this side-effect-free proof only: module must always be YOS_Test; input must be a Dictionary with one key echo containing only the individual intent text; risk must be low; external_write=false; needs_review=false; needs_confirmation=false; status=planned. Split multiple intents into separate actions in their original order. Do not invent missing content. original_input: {originalInput}")

const modelResult = askChatGPT(
  modelPrompt,
  false,
  "Dictionary"
)

@parsed = getDictionary(modelResult)
@echoedInputValue = getValue(@parsed, "original_input")
@echoedInput = "{@echoedInputValue}"
@actionsRaw = getValue(@parsed, "actions")

if @echoedInput != "{originalInput}" {
    @blocked = {"status":"blocked","verified":false,"result":{"message":"original_input_mismatch"},"error_code":"ORIGINAL_INPUT_MISMATCH"}
    show("Clarity Model Router Proof\nBLOCKED\nORIGINAL_INPUT_MISMATCH")
    outputValue(@blocked)
}

if !@actionsRaw {
    @blocked = {"status":"blocked","verified":false,"result":{"message":"actions_missing"},"error_code":"INVALID_ACTION_SCHEMA"}
    show("Clarity Model Router Proof\nBLOCKED\nINVALID_ACTION_SCHEMA")
    outputValue(@blocked)
}

for actionItem in @actionsRaw {
    @action = getDictionary(@actionItem)

    @idValue = getValue(@action, "id")
    @id = "{@idValue}"
    @moduleValue = getValue(@action, "module")
    @module = "{@moduleValue}"
    @statusValue = getValue(@action, "status")
    @status = "{@statusValue}"
    @riskValue = getValue(@action, "risk")
    @risk = "{@riskValue}"
    @externalWrite = getValue(@action, "external_write")
    @needsReview = getValue(@action, "needs_review")
    @needsConfirmation = getValue(@action, "needs_confirmation")
    @inputRaw = getValue(@action, "input")

    if !@id || @module != "YOS_Test" || @status != "planned" || @risk != "low" || @externalWrite || @needsReview || @needsConfirmation || !@inputRaw {
        @blocked = {"status":"blocked","verified":false,"result":{"message":"invalid_action_schema"},"error_code":"INVALID_ACTION_SCHEMA"}
        show("Clarity Model Router Proof\nBLOCKED\nINVALID_ACTION_SCHEMA")
        outputValue(@blocked)
    }

    @input = getDictionary(@inputRaw)
    @echoValue = getValue(@input, "echo")
    @echo = "{@echoValue}"

    if !@echo {
        @blocked = {"status":"blocked","verified":false,"result":{"message":"missing_echo"},"error_code":"INVALID_ACTION_INPUT"}
        show("Clarity Model Router Proof\nBLOCKED\nINVALID_ACTION_INPUT")
        outputValue(@blocked)
    }

    @routerRequest = {"module":"YOS_Test","input":{"echo":"{@echo}"}}
    @childRaw = run("Clarity Dispatcher Proof", @routerRequest)
    @child = getDictionary(@childRaw)
    @childStatusValue = getValue(@child, "status")
    @childStatus = "{@childStatusValue}"
    @childVerified = getValue(@child, "verified")

    if @childStatus != "success" || !@childVerified {
        @failed = {"status":"failed","verified":false,"result":{"message":"child_unverified"},"error_code":"CHILD_RESULT_UNVERIFIED"}
        show("Clarity Model Router Proof\nFAILED\nCHILD_RESULT_UNVERIFIED")
        outputValue(@failed)
    }
}

@passed = {"status":"success","verified":true,"result":{"message":"MODEL_ROUTER_E2E_PASS"},"error_code":""}
show("Clarity Model Router Proof\nPASS\nMODEL_ROUTER_E2E_PASS")
outputValue(@passed)
