#define name YOS_Test
#define color blue
#define version 18

// Cherri's stock Stop and Output wrapper is text-only. Keep the contract typed.
action 'is.workflow.actions.output' outputValue(variable value: 'WFOutput')

/* Phase 2 child: side-effect-free echo/contract proof. */

@payload = getDictionary(ShortcutInput)
@echoValue = getValue(@payload, "echo")
@echo = "{@echoValue}"
@result = {"status":"success","verified":true,"result":{"echo":"{@echo}"},"error_code":""}
outputValue(@result)
