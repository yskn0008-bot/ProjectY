#define name Clarity Formal v2
#define color blue

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/shortcuts'

// Auto-generated owner-facing Clarity Demo entry.
// Factory path: voice -> Raw First -> Use Model -> policy/router -> execution child -> verified result.

action 'file.append' appendResolvedFile(
    variable file: 'WFFile',
    variable input: 'WFInput'
) {
    "WFAppendFileWriteMode": "Append"
}

const originalInput = listen("After Pause", "jp-JP")
const requestNumber = randomNumber(100000, 999999)
const rawRecord = text("{CurrentDate}\t{requestNumber}\tRAW\t{originalInput}\n")
const inboxFile = getFile("Clarity Inbox.txt")
appendResolvedFile(inboxFile, rawRecord)

const modelPrompt = text("あなたはiPhoneの個人AIルーター「Clarity」のUNDERSTAND層です。\n役割は自然な1入力を実行前の構造化ACTIONへ分解することだけです。実行・保存・登録・送信したと主張しません。\ncurrent_time: {CurrentDate}\n最重要ルール: 1目的=1ACTION。異なるmoduleの目的を混ぜない。Calendarは予定・予約・イベントだけ。Shoppingは買う物だけで別ACTION。Ideaは思いつき・アイデアだけで別ACTION。Reminderは独立した後で行うこと・期限・通知だけ。Calendarに付随する通知はCalendarのalert_minutes_beforeへ入れ、同内容のReminderを重複生成しない。Moneyは支出・収入・金額記録だけ。original_inputは入力をそのまま保持。入力にない内容は作らない。\n日時: current_timeを基準に今日/明日/明後日/今夜/明日15時など通常の日本語日時を解決し、date_timeとend_date_timeはISO 8601のローカル日時で返す。開始日時が一意に決まり、終了指定がないCalendarはend_date_timeを開始60分後にする。午前午後が本当に曖昧な「3時」などは推測せずneeds_review=true。Shopping/Ideaは日時指定がなければ日時不要でneeds_review=false。\nCalendar alert_minutes_beforeは通知指定がある時だけ数値で、対応値は5,15,30,60,120,1440。その他の通知間隔はneeds_review=true。\n不明な値は推測せず空文字またはnull。不明点があるACTIONはneeds_review=true。riskは通常low。external_writeはローカルCalendar/Reminders/Idea/Money候補、OpenApp、DeviceSetting、MyWayではfalse。needs_confirmationは通常false。statusは必ずplanned。\n利用可能module: Calendar, Reminder, Money, Shopping, Idea, OpenApp, DeviceSetting, MyWay, Other。\nReturn only a Dictionary. Keys: original_input, actions. actions is an array. Each action has id, module, input, risk, external_write, needs_review, needs_confirmation, status. input is a Dictionary with text,title,date_time,end_date_time,alert_minutes_before,amount,merchant,item,note,raw_input,target,value.\nCalendar: titleは予定名のみ。Shopping: itemに買う物、条件はnote。Idea: noteに発想内容。Reminder: textに内容、必要ならdate_time。Money: raw_inputにMoney意図の自然文を保持し、金額や店名を推測しない。OpenApp: targetは safari,shortcuts,files,notes,phone,reminders,mail,music,calendar,maps,contacts,health,photos,appstore,facetime,chatgpt,scriptable,youtube,spotify,google_sheets のいずれか。未登録アプリはneeds_review=true。DeviceSetting: targetは wifi,bluetooth,low_power_mode,brightness,volume,appearance,flashlight,do_not_disturb のいずれか。wifi/bluetooth/low_power_mode/flashlight/do_not_disturb のvalueは on,off,toggle。appearanceは light,dark,toggle。brightness/volumeは0〜100の整数。曖昧または未対応設定はneeds_review=true。MyWay: MY WAY/MYWAY/マイウェイを見たい・開きたい・まとめを見たい場合はtarget=home,value=open。OpenAppとMyWayは他のACTIONより後ろに置く。Otherは既存実行先が無い場合だけ。\n入力: {originalInput}")

const modelResult = askChatGPT(modelPrompt, false, "Dictionary")
@parsed = getDictionary(modelResult)
@echoValue = getValue(@parsed, "original_input")
@echoedInput = "{@echoValue}"
@actionsRaw = getValue(@parsed, "actions")

if @echoedInput != "{originalInput}" {
    mustOutput("Clarity", "BLOCKED\noriginal_input mismatch")
}

if !@actionsRaw {
    mustOutput("Clarity", "BLOCKED\nactions missing")
}

@calendar = false
@reminder = false
@money = false
@shopping = false
@idea = false
@openApp = false
@deviceSetting = false
@myWay = false
@other = false
@blocked = false

for actionItem in @actionsRaw {
    @action = getDictionary(@actionItem)
    @moduleValue = getValue(@action, "module")
    @module = "{@moduleValue}"
    @statusValue = getValue(@action, "status")
    @status = "{@statusValue}"
    @riskValue = getValue(@action, "risk")
    @risk = "{@riskValue}"
    @externalWrite = getValue(@action, "external_write")
    @needsReview = getValue(@action, "needs_review")
    @needsConfirmation = getValue(@action, "needs_confirmation")

    if @status != "planned" {
        @blocked = true
    }
    if @risk == "high" || @risk == "irreversible" {
        @blocked = true
    }
    if @externalWrite || @needsReview || @needsConfirmation {
        @blocked = true
    }

    if @module == "Calendar" {
        @calendar = true
    }
    if @module == "Reminder" {
        @reminder = true
    }
    if @module == "Money" {
        @money = true
    }
    if @module == "Shopping" {
        @shopping = true
    }
    if @module == "Idea" {
        @idea = true
    }
    if @module == "OpenApp" {
        @openApp = true
    }
    if @module == "DeviceSetting" {
        @deviceSetting = true
    }
    if @module == "MyWay" {
        @myWay = true
    }
    if @module == "Other" {
        @other = true
        @blocked = true
    }

    if @module != "Calendar" && @module != "Reminder" && @module != "Money" && @module != "Shopping" && @module != "Idea" && @module != "OpenApp" && @module != "DeviceSetting" && @module != "MyWay" && @module != "Other" {
        @blocked = true
    }
}

if @blocked {
    mustOutput("Clarity", "BLOCKED\n確認が必要なACTIONがあります")
}

@childRaw = run("Clarity Actions Formal v2", @parsed)
@child = getDictionary(@childRaw)
@childStatusValue = getValue(@child, "status")
@childStatus = "{@childStatusValue}"
@childVerified = getValue(@child, "verified")
@childErrorValue = getValue(@child, "error_code")
@childError = "{@childErrorValue}"

if @childStatus != "success" || !@childVerified {
    mustOutput("Clarity", "FAILED\n{@childError}")
}

show("Clarity Formal v2\nE2E PASS\nCalendar: {@calendar}\nReminder: {@reminder}\nMoney: {@money}\nShopping: {@shopping}\nIdea: {@idea}\nOpenApp: {@openApp}\nDeviceSetting: {@deviceSetting}\nMyWay: {@myWay}\n実行結果をVerify/Ledgerまで確認済み")
