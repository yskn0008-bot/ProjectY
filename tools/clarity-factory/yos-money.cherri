#define name Money
#define color green

#include 'actions/web'

// Internal executor only: Clarity is the sole normal user entry.
// Stop and Output normally has a text-oriented Cherri wrapper. This local definition
// preserves Dictionary child results for the parent router.
action 'is.workflow.actions.output' outputValue(variable value: 'WFOutput')

const inputType = typeOf(ShortcutInput)
if inputType != "Dictionary" {
    const invalidInput = {
        "status": "blocked",
        "verified": false,
        "result": {
            "message": "Money入力を受け取れませんでした",
            "payload_json": ""
        },
        "error_code": "invalid_money_input"
    }
    outputValue(invalidInput)
}

const input = getDictionary(ShortcutInput)
const rawInputValue = getValue(input, "raw_input")
const rawInput = "{rawInputValue}"
if !rawInput {
    const missingInput = {
        "status": "blocked",
        "verified": false,
        "result": {
            "message": "Money入力が空です",
            "payload_json": ""
        },
        "error_code": "missing_raw_input"
    }
    outputValue(missingInput)
}

const encodedInput = urlEncode("{rawInput}")
const bridgeURL = "scriptable:///run/Money%20Bridge?text={encodedInput}&source=clarity"
const callbackRaw = openXCallbackURL(bridgeURL)
const callbackType = typeOf(callbackRaw)

if callbackType != "Dictionary" {
    const invalidCallback = {
        "status": "failed",
        "verified": false,
        "result": {
            "message": "Money実行結果を確認できませんでした",
            "payload_json": ""
        },
        "error_code": "invalid_money_callback"
    }
    outputValue(invalidCallback)
}

const callback = getDictionary(callbackRaw)
const statusValue = getValue(callback, "status")
const verifiedValue = getValue(callback, "verified")
const resultValue = getValue(callback, "result")
const errorValue = getValue(callback, "error_code")
const status = "{statusValue}"
const verifiedText = "{verifiedValue}"
const resultText = "{resultValue}"
const errorCode = "{errorValue}"

if !status || !verifiedText || !resultText {
    const incompleteCallback = {
        "status": "failed",
        "verified": false,
        "result": {
            "message": "Money実行結果が不完全です",
            "payload_json": ""
        },
        "error_code": "incomplete_money_callback"
    }
    outputValue(incompleteCallback)
}

const resultDictionary = getDictionary(resultText)
const messageValue = getValue(resultDictionary, "message")
const message = "{messageValue}"

if verifiedText == "true" {
    const verifiedOutput = {
        "status": "{status}",
        "verified": true,
        "result": {
            "message": "{message}",
            "payload_json": "{resultText}"
        },
        "error_code": "{errorCode}"
    }
    outputValue(verifiedOutput)
}

const unverifiedOutput = {
    "status": "{status}",
    "verified": false,
    "result": {
        "message": "{message}",
        "payload_json": "{resultText}"
    },
    "error_code": "{errorCode}"
}
outputValue(unverifiedOutput)
