#define name ClarityInputProbeV4
#define color blue

#include 'actions/shortcuts'
#include 'actions/device'
#include 'actions/text'

setBrightness(0.80)
wait(1)

const childResult = run("ClarityInputChildV4", "ping")
wait(1)

const currentBrightness = getDeviceDetail("Current Brightness")
show("ClarityInputProbeV4\nBrightness after child: {currentBrightness}\nExpected 0.35 if input arrived, 0.20 if input was empty.")
