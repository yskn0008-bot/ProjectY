{
  "version": "1.0",
  "name": "Clarity iPhone Capability Registry",
  "target_platform": "iPhone / iOS 26+",
  "owner_entry_policy": "Clarity is the single normal user entry point for all supported iPhone actions.",
  "scope": {
    "executable": "Every capability exposed on the target iPhone through Apple Shortcuts, App Intents, approved URL/deep-link handoff, or an existing YOS child asset.",
    "protected": "When iOS requires explicit user interaction or does not expose a public automation API, Clarity must route to the nearest native UI and state that execution still requires the user.",
    "dynamic_apps": "Third-party app capabilities are included when the installed app exposes a usable App Intent/Shortcut action."
  },
  "completion_gate": {
    "registry_has_no_unknown_capability_state": true,
    "all_available_direct_or_child_capabilities_have_verified_route": true,
    "all_protected_capabilities_have_explicit_ui_handoff": true,
    "all_side_effecting_routes_require_policy": true,
    "all_applied_results_require_verify": true,
    "physical_iphone_e2e_required": true,
    "fallback_kept_until_replacement_route_passes_e2e": true
  },
  "execution_modes": [
    "direct_shortcuts",
    "existing_yos_asset",
    "registered_child_shortcut",
    "app_intent_child",
    "open_native_ui",
    "not_publicly_automatable"
  ],
  "statuses": [
    "implemented",
    "existing_asset",
    "pending_module",
    "needs_device_verification",
    "dynamic_by_device",
    "ui_handoff_required",
    "not_publicly_automatable"
  ],
