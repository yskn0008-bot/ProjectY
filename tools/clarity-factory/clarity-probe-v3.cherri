#define name ClarityProbeV3
#define color blue

#include 'actions/text'
#include 'actions/shortcuts'
#include 'actions/device'

setBrightness(0.80)
wait(1)

const payload = {
    "original_input":"brightness-probe-v3",
    "actions":[
        {
            "id":"a1",
            "module":"DeviceSetting",
            "input":{
                "text":"",
                "title":"",
                "date_time":"",
                "end_date_time":"",
                "alert_minutes_before":"",
                "amount":"",
                "merchant":"",
                "item":"",
                "note":"",
                "raw_input":"brightness-probe-v3",
                "target":"brightness",
                "value":"35"
            },
            "risk":"low",
            "external_write":false,
            "needs_review":false,
            "needs_confirmation":false,
            "status":"planned"
        }
    ]
}

const childRaw = run("ClarityActionsV3", payload)
wait(1)
const currentBrightness = getDeviceDetail("Current Brightness")
show("ClarityProbeV3\nBrightness after child: {currentBrightness}\nChild output: {childRaw}")
