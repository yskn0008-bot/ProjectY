#define name YOS_Device
#define color blue

#include 'actions/text'
#include 'actions/device'

// Fixed local device child. The parent routes here but never performs the
// device operation itself. Parse the existing "brightness|<percent>" contract
// and keep unsupported/malformed input fail-closed.
@incoming = "{ShortcutInput}"
@parts = splitText(@incoming, "|")
const partCount = count(@parts)

if partCount == 2 {
    const commandPart = getListItem(@parts, 1)
    const valuePart = getListItem(@parts, 2)
    @command = "{commandPart}"
    @valueText = "{valuePart}"

    if @command == "brightness" {
        @numericMatches = matchText('^(100|[0-9][0-9]?)$', @valueText)
        const numericMatchCount = count(@numericMatches)

        if numericMatchCount == 1 {
            const brightnessPercent = getNumbers(@valueText)
            const brightnessRatio = brightnessPercent * 0.01
            rawAction("is.workflow.actions.setbrightness", {
                "WFBrightness": "${brightnessRatio}"
            })
            output("YOS_DEVICE_OK:brightness={brightnessPercent}")
        }
    }
}

output("YOS_DEVICE_BLOCKED:{ShortcutInput}")
