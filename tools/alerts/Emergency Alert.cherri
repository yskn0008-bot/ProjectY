#define name Emergency Alert
#define color red
#define inputs text

#include 'actions/text'
#include 'actions/documents'
#include 'actions/calendar'

// Input must carry all emergency gates explicitly.
@incoming = "{ShortcutInput}"
const historyFolder = createFolder("YOS Display History")
const alertStateFolder = createFolder("YOS Alert State")

// Fail closed. An emergency must explicitly satisfy all three gates.
// Canonical caller input:
// YOS_EMERGENCY_V1 AWARE=1 ACTION=1 HARM=1
// followed by the human-readable alert text.
if @incoming contains "YOS_EMERGENCY_V1" {
    if @incoming contains "AWARE=1" {
        if @incoming contains "ACTION=1" {
            if @incoming contains "HARM=1" {
                const lastEmergencyFile = getFile("YOS Alert State/Emergency Alert Last.txt", nil, false)
                const lastEmergencyText = getText(lastEmergencyFile)
                @lastEmergency = "{lastEmergencyText}"
                if @lastEmergency == @incoming {
                    stop()
                }
                saveFile("YOS Alert State/Emergency Alert Last.txt", @incoming, true)

                const stampNow = currentDate()
                const stamp = formatDate(stampNow, "Custom", "yyyy-MM-dd HHmmss")
                const log = text("【Emergency Alert】\n{@incoming}")
                saveFile("YOS Display History/{stamp} Emergency Alert.txt", log, false)

                const notifyBody = replaceText('^YOS_[A-Z0-9_]+_V1[^\\n]*\\n?', "", @incoming, true, true)
                const notifyPayload = {
                    "title": "Emergency Alert",
                    "body": "{notifyBody}",
                    "url": "https://yskn0008-bot.github.io/ProjectY/system/",
                    "thread": "yos-notifications-emergency"
                }
                run("YOS Notify", notifyPayload)
                stop()
            }
        }
    }
}
stop()
