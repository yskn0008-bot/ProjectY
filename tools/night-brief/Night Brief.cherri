#define name Night Brief
#define color purple

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/location'
#include 'actions/shortcuts'

// Local-first Night Brief.
// YOS Night History.json is only a derived cache; MY LIFE yos-life-v1 remains the owner store.
const historyFile = getFile("YOS Night History.json", nil, false)
const historyJson = getText(historyFile)

const today = currentDate()
const tomorrow = adjustDate(today, "Add", qty(1, "days"))
const tomorrowLabel = formatDate(tomorrow, "Custom", "    yyyy/MM/dd（EEE）")

const tomorrowStartText = text("{tomorrowLabel} 00:00")
const tomorrowStart = date(tomorrowStartText)
const tomorrowEndText = text("{tomorrowLabel} 23:59")
const tomorrowEnd = date(tomorrowEndText)

// These three placeholder actions are replaced after Cherri compilation with the
// same native Weather / Calendar / Reminders actions already proven on the iPhone.
const tomorrowWeather = text("YOS_NIGHT_WEATHER_PLACEHOLDER")
const tomorrowCalendar = text("YOS_NIGHT_CALENDAR_PLACEHOLDER")
const tomorrowReminders = text("YOS_NIGHT_REMINDERS_PLACEHOLDER")

const nightFacts = text("明日の日付：
{tomorrowLabel}

天気予報：
{tomorrowWeather}

明日の予定：
{tomorrowCalendar}

明日のリマインダー：
{tomorrowReminders}

過去14日のMY LIFE Night記録：
{historyJson}")

const modelPrompt = text("あなたはYOS Night Briefです。

目的：
本人が寝る前に、
「明日になってから知ると遅いこと」と
「本人自身では気づきにくい最近のパターン」
だけを短く知らせる。

与えられた情報以外の事実を作らない。
情報がない項目は無理に埋めない。
事実・観察・推論を区別する。

【明日の予定】
Calendarの明日の予定を時間順に整理する。
終日予定は「終日」と表示する。
予定がなければ「予定なし」。

【明日の天気】
天気予報から明日の分だけを見る。
天気、最高・最低気温、雨など、前夜に準備へ影響することだけを短く出す。

【明日のごみ】
収集区域④。
2026年9月1日以降のルール：
月曜：かん・びん・紙・ペットボトル・有害ごみ
火曜：燃やすごみ
第1・第3水曜：草木
第2・第4水曜：燃やさないごみ
木曜：通常収集なし
金曜：燃やすごみ
土曜：通常収集なし
日曜：通常収集なし
明日の曜日と、その月の何回目の水曜日かを正しく判定し、該当するごみだけ表示する。なければ「なし」。

【期限・準備】
明日期限の未完了Reminder、明日の予定や天気から見て前夜に準備する必要が明確なものだけ出す。
根拠なく準備物を作らない。

【外部視点】
過去14日のMY LIFE Night記録から、本人自身では気づきにくいものだけ拾う。
・繰り返している行動
・同じ場所で詰まるパターン
・判断の繰り返し
・計画と実際の差
・進みやすい条件
・以前から変化していること

ルール：
・1回だけの出来事をパターン扱いしない
・複数日の証拠があるものだけパターン候補にする
・性格診断、心理診断をしない
・本人を決めつけない
・推論なら「推論」と分かるようにする
・以前と同じ発見を、新しい根拠なしに繰り返さない
・十分な証拠がなければ「新しい発見なし」

出力：
【明日の予定】：
【天気】：
【ごみ】：
【期限・準備】：
【外部視点】：

寝る前に20〜30秒で読める長さにする。
タイトルや前置きは不要。

入力情報：
{nightFacts}")

const response = askChatGPT(modelPrompt, false, "Text")
showNotification(response)
alert(response, "Night Brief")
run("Night Check in", response)
