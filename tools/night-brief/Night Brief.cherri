#define name Night Brief
#define color purple

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/location'

// Native-only Night Brief.
// No Safari, Scriptable, URL callback, or Run Shortcut.
// Night history is a derived iCloud cache, one file per day.
// Existing MY LIFE remains separate; this removes browser sync from the critical night flow.

const historyFolder = createFolder("YOS Night History")
const historyFiles = getFolderContents(historyFolder, false)
const recentHistoryFiles = filterFiles(historyFiles, 14, "Name", "Z to A")
const recentHistory = getText(recentHistoryFiles)

const today = currentDate()
const todayKey = formatDate(today, "Custom", "yyyy-MM-dd")
const todayLabel = formatDate(today, "Custom", "yyyy/MM/dd（EEE）")
const tomorrow = adjustDate(today, "Add", qty(1, "days"))
const tomorrowLabel = formatDate(tomorrow, "Custom", "yyyy/MM/dd（EEE）")

const todayStartText = text("{todayLabel} 00:00")
const todayStart = date(todayStartText)
const todayEndText = text("{todayLabel} 23:59")
const todayEnd = date(todayEndText)
const tomorrowStartText = text("{tomorrowLabel} 00:00")
const tomorrowStart = date(tomorrowStartText)
const tomorrowEndText = text("{tomorrowLabel} 23:59")
const tomorrowEnd = date(tomorrowEndText)

// Replaced after compilation with native iPhone Calendar/Reminder/Weather actions.
const todayCalendar = text("YOS_NIGHT_TODAY_CALENDAR_PLACEHOLDER")
const todayReminders = text("YOS_NIGHT_TODAY_REMINDERS_PLACEHOLDER")
const tomorrowWeather = text("YOS_NIGHT_WEATHER_PLACEHOLDER")
const tomorrowCalendar = text("YOS_NIGHT_CALENDAR_PLACEHOLDER")
const tomorrowReminders = text("YOS_NIGHT_REMINDERS_PLACEHOLDER")

const nightFacts = text("今日の日付：
{todayLabel}

今日の予定：
{todayCalendar}

今日の未完了リマインダー：
{todayReminders}

明日の日付：
{tomorrowLabel}

天気予報：
{tomorrowWeather}

明日の予定：
{tomorrowCalendar}

明日のリマインダー：
{tomorrowReminders}

直近のNight記録：
{recentHistory}")

const modelPrompt = text("あなたはYOS Night Briefです。

目的：
本人が日記を書く前に、その日ここまでの情報から、本人自身では気づきにくいことを見つける。

内部分析では根拠のある観察候補を最大10個まで作る。
ただし本人へ候補一覧は見せない。
似たものをまとめ、重要度と根拠で統合し、最終表示は【今日の発見】最大3項目だけにする。

内部で見るもの：
・行動や判断の繰り返し
・迷い、摩擦、やり直し
・予定と実行のズレ
・進みやすい条件
・以前からの変化
・本人が明示していない可能性のある傾向

証拠として使ってよいもの：
・今日のCalendar
・今日の未完了Reminder
・直近のNight記録
・明日のCalendar / Reminder / 天気
・このChatGPT実行時に実際に参照できる今日の会話文脈や記憶がある場合のみ、その内容

参照できない情報を見たことにしない。
1回だけの出来事を確認済みパターン扱いしない。
心理診断・性格診断・動機の断定をしない。
新しい根拠が弱ければ項目数を減らす。

前夜準備も短くまとめる。
【明日】予定 / 天気 / ごみ / 期限・準備 を必要なものだけ1〜3行。

収集区域④。2026年9月1日以降：
月曜：かん・びん・紙・ペットボトル・有害ごみ
火曜：燃やすごみ
第1・第3水曜：草木
第2・第4水曜：燃やさないごみ
木曜：通常収集なし
金曜：燃やすごみ
土曜：通常収集なし
日曜：通常収集なし

出力順：
【今日の発見】
1. ...
2. ...
3. ...
【明日】...

タイトルや前置きは不要。
iPhoneで10〜15秒で読み切れる長さを最優先する。

入力情報：
{nightFacts}")

const response = askChatGPT(modelPrompt, false, "Text")
showNotification("Night Brief：今日の発見をまとめました")
alert(response, "Night Brief")

const rawInput = prompt(
    "テーマは決めなくてOK。今日のことを自由に書く・話す。\n\n思いつかなければ：今日あったこと／気分・気づき／明日やること",
    "Text",
    ""
)

const checkinPrompt = text("あなたはYOS Night Check-inです。
本人の今日の入力を整理し、日記前に作った外部視点と直近記録も参考にしながら、今日のNight記録を作る。

入力や記録にない事実を作らない。
性格診断・心理診断をしない。
事実・観察・推論を区別する。
過去と同じ発見を、新しい根拠なしに繰り返さない。

返答はDictionaryのみ。
キーは summary, mood_state, tomorrow, discoveries, three_line_diary, tomorrow_message の6つだけ。

summary: 今日あったことを簡潔に整理。
mood_state: 本人の入力に根拠がある気分・状態だけ。
tomorrow: 明日やること。無ければ空文字。
discoveries: 日記前の外部視点と本人入力を照合し、新しい根拠がある発見だけ。根拠不足なら『新しい発見なし』。
three_line_diary: 事実ベースの3行日記。改行で3行。
tomorrow_message: 明日への短い一言。

日記前の外部視点：
{response}

直近のNight記録：
{recentHistory}

今日の本人入力：
{rawInput}")

const checkinResult = askChatGPT(checkinPrompt, false, "Dictionary")
const parsed = getDictionary(checkinResult)

const summary = "{parsed['summary']}"
const mood = "{parsed['mood_state']}"
const tomorrowAction = "{parsed['tomorrow']}"
const discoveries = "{parsed['discoveries']}"
const diary = "{parsed['three_line_diary']}"
const message = "{parsed['tomorrow_message']}"

const recordText = text("YOS_NIGHT_RECORD_V1
date: {todayKey}
summary: {summary}
mood_state: {mood}
tomorrow: {tomorrowAction}
discoveries: {discoveries}
three_line_diary:
{diary}
tomorrow_message: {message}
raw_input:
{rawInput}
")

saveFile("YOS Night History/{todayKey}.txt", recordText, true)

const finalText = text("保存しました

発見：
{discoveries}

明日：
{tomorrowAction}

3行日記：
{diary}")

alert(finalText, "Night Brief")
