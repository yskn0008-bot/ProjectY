#define name Night Brief
#define color purple

#include 'actions/text'
#include 'actions/documents'
#include 'actions/intelligence'
#include 'actions/calendar'
#include 'actions/location'
#include 'actions/shortcuts'
#include 'actions/web'

// Local-first Night Brief.
// YOS Night History.json is only a derived cache; MY LIFE yos-life-v1 remains the owner store.
const historyFile = getFile("YOS Night History.json", nil, false)
const historyJson = getText(historyFile)

const today = currentDate()
const todayLabel = formatDate(today, "Custom", "    yyyy/MM/dd（EEE）")
const tomorrow = adjustDate(today, "Add", qty(1, "days"))
const tomorrowLabel = formatDate(tomorrow, "Custom", "    yyyy/MM/dd（EEE）")

const todayStartText = text("{todayLabel} 00:00")
const todayStart = date(todayStartText)
const todayEndText = text("{todayLabel} 23:59")
const todayEnd = date(todayEndText)
const tomorrowStartText = text("{tomorrowLabel} 00:00")
const tomorrowStart = date(tomorrowStartText)
const tomorrowEndText = text("{tomorrowLabel} 23:59")
const tomorrowEnd = date(tomorrowEndText)

// These five placeholder actions are replaced after Cherri compilation with
// native iPhone actions. Today signals feed the unconscious-observation layer;
// tomorrow signals keep the existing preparation brief.
const todayCalendar = text("YOS_NIGHT_TODAY_CALENDAR_PLACEHOLDER")
const todayReminders = text("YOS_NIGHT_TODAY_REMINDERS_PLACEHOLDER")
const tomorrowWeather = text("YOS_NIGHT_WEATHER_PLACEHOLDER")
const tomorrowCalendar = text("YOS_NIGHT_CALENDAR_PLACEHOLDER")
const tomorrowReminders = text("YOS_NIGHT_REMINDERS_PLACEHOLDER")

const nightFacts = text("今日の日付：
{todayLabel}

今日の予定：
{todayCalendar}

今日の未完了リマインダー：
{todayReminders}

明日の日付：
{tomorrowLabel}

天気予報：
{tomorrowWeather}

明日の予定：
{tomorrowCalendar}

明日のリマインダー：
{tomorrowReminders}

過去14日のMY LIFE Night記録：
{historyJson}")

const modelPrompt = text("あなたはYOS Night Briefです。

目的：
本人が日記を書く前に、その日ここまでの情報から、本人自身では気づきにくいことを見つける。

内部分析では必ず最低10個の独立した観察候補を作る。
ただし本人へ10個をそのまま見せない。
似たものをまとめ、重要度と根拠で統合し、最終表示は【今日の発見】3項目だけにする。

内部で見るもの：
・行動や判断の繰り返し
・迷い、摩擦、やり直し
・予定と実行のズレ
・進みやすい条件
・以前からの変化
・本人が明示していない可能性のある傾向

証拠として使ってよいもの：
・今日のCalendar
・今日の未完了Reminder
・過去14日のMY LIFE Night記録
・明日のCalendar / Reminder / 天気
・このChatGPT実行時に実際に参照できる今日の会話文脈や記憶がある場合のみ、その内容
参照できない情報を見たことにしてはいけない。

【今日の発見】
・3項目だけ
・1項目は最大2行
・各項目は「発見 — 根拠」の形
・【確認済み】【観察候補】【推論】のどれかを短く付ける
・同じ根拠の言い換えは禁止
・本人の自己評価をそのまま発見にしない
・心理診断、性格診断、動機の断定をしない
・証拠が弱ければ断定しない
・内部で10個未満しか根拠ある候補を作れない場合は、水増しせず3項目未満でもよい

前夜準備も短くまとめる。
【明日】予定 / 天気 / ごみ / 期限・準備 を必要なものだけ1〜3行。
収集区域④。2026年9月1日以降：
月曜：かん・びん・紙・ペットボトル・有害ごみ
火曜：燃やすごみ
第1・第3水曜：草木
第2・第4水曜：燃やさないごみ
木曜：通常収集なし
金曜：燃やすごみ
土曜：通常収集なし
日曜：通常収集なし

出力順：
【今日の発見】
1. ...
2. ...
3. ...
【明日】...

タイトルや前置き、内部で作った10個の一覧は表示しない。
iPhoneで10〜15秒で読み切れる長さを最優先する。

入力情報：
{nightFacts}")

const response = askChatGPT(modelPrompt, false, "Text")
showNotification("Night Brief：今日の発見を3つにまとめました")
show(response)
openURL("shortcuts://run-shortcut?name=Night%20Check%20in")
