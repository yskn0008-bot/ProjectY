#define name YOS 日記
#define color purple
#define inputs text

#include 'actions/text'
#include 'actions/calendar'
#include 'actions/intelligence'
#include 'actions/documents'
#include 'actions/crypto'
#include 'actions/web'

// YOS 日記: one short answer is enough to preserve the day's memory.
// This remains an independent shortcut; the existing Night Brief is untouched.
// No Notion credentials or personal diary records are embedded in this source.
const now = currentDate()
const day = formatDate(now, "Custom", "yyyy-MM-dd")
const timeKey = formatDate(now, "Custom", "HH-mm-ss")

// Step 1: open the existing paper journal with today's schedule BEFORE typing.
// Step 2: only the same Scriptable journal can hand the person's words back here.
// A strict callback marker means ordinary Night Brief input cannot be mistaken for a diary.
@incoming = "{ShortcutInput}"
if @incoming contains "YOS_JOURNAL_COMPOSE_V1:" {
    nothing() // No extra prompt; the callback text is processed below.
} else {
    const startURL = text("scriptable:///run?scriptName=YOS%20Journal%20Book&mode=compose&date={day}")
    openURL(startURL)
    stop()
}
const raw = replaceText("YOS_JOURNAL_COMPOSE_V1:", "", @incoming)

// Save the original words FIRST; even if AI editing or Notion fails, the memory
// remains in the existing iCloud YOS Journal Pending folder.
const pendingFolder = createFolder("YOS Journal Pending")
const original = text("YOS_JOURNAL_RAW_V2\n日付：{day}\n本人の言葉（原文）：\n{raw}")
saveFile("YOS Journal Pending/{day}-{timeKey}-raw.txt", original, false)

// Editorial整理だけ。本人が話していない感情や出来事は創作しない。
// This summary is separated from the verbatim answer in Notion.
const editorialPrompt = text("あなたはYOSの記憶日記編集担当です。本人が数年後に読み返したとき、その日の出来事・そのときの気持ち・どう感じたかを思い出せるように、短い記録を作ってください。

目的は内省や指導ではなく、その日の記憶を残すこと。本人が誰かに見せる前提ではありません。
厳守：
・本人が実際に述べた事実、気持ち、感じ方だけを書き、推測で補わない。
・本人の固有名詞、場所、言葉、印象的な描写は分かる範囲で残す。
・言っていない会話、感情、理由、天候、風景、決意を捏造しない。
・説教、アドバイス、性格分析、無理な前向き解釈は禁止。
・箇条書き風の3項目だけ。全体で原則40〜150字程度。情報が少なければさらに短く。
・わからない項目には『未記録』と書く。本人の言葉を大げさに脚色しない。
・前置き、結論、余分な質問は入れない。

出力形式：
【出来事】実際に起きたこと
【気持ち】そのとき本人が語った気持ち
【どう感じた】考えたこと、印象や忘れたくない細部

本人の入力（そのままの原文）：
{raw}")
const edited = askChatGPT(editorialPrompt, false, "Text")
// Do not branch directly on the ChatGPT app's result variable.
// In Cherri 2.3, that produces an incomplete iOS If comparator.
// An empty result is rejected by the existing Journal Book before Notion save.
// The raw words have already been backed up in iCloud.
const finalStory = text("{edited}")
const diary = text("【今日の記憶】\n{finalStory}")
const todayQuestion = text("今日、何があって、どんな気持ちになり、どう感じた？")
const originalAnswer = text("{raw}")

// Prepared payload is also backed up before Notion is opened.
// Neither local backup is presented as a successful Notion save.
const prepared = text("YOS_JOURNAL_LOCAL_BACKUP_V2\n日付：{day}\n【YOSの整理】\n{diary}\n\n【本人の言葉（原文）】\n{originalAnswer}")
saveFile("YOS Journal Pending/{day}-{timeKey}-prepared.txt", prepared, false)

// Existing Journal Book displays the short recollection for review before saving.
// Journal Book passes the reviewed version to the unchanged Notion Bridge;
// the Night Brief -> YOS 日記 handoff already in main remains intact.
const diaryBase64 = base64Encode(diary)
const questionBase64 = base64Encode(todayQuestion)
const answerBase64 = base64Encode(originalAnswer)
const d64 = urlEncode(diaryBase64)
const q64 = urlEncode(questionBase64)
const a64 = urlEncode(answerBase64)
const storyBase64 = base64Encode(finalStory)
const story64 = urlEncode(storyBase64)
const bookURL = text("scriptable:///run?scriptName=YOS%20Journal%20Book&date={day}&story={story64}&diary={d64}&question={q64}&answer={a64}")
openURL(bookURL)
stop()
