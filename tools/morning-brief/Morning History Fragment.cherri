#define name Morning History Fragment
#define color purple
#define inputs text

#include 'actions/text'
#include 'actions/documents'

@incoming = "{ShortcutInput}"
const historyNow = currentDate()
const historyStamp = formatDate(historyNow, "Custom", "yyyy-MM-dd HHmmss")
const historyText = text("【Morning Brief】\n{@incoming}")
saveFile("YOS Display History/{historyStamp} Morning Brief.txt", historyText, false)
