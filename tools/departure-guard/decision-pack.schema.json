{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecty.local/schemas/decision-pack-v0.2.json",
  "title": "ProjectY Decision Pack v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "candidate_id",
    "trigger_event_id",
    "created_at",
    "expires_at",
    "evidence",
    "reasons",
    "confidence",
    "status",
    "user_decision",
    "execution_result",
    "reversible",
    "options"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "trigger_event_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "decision_deadline": { "type": ["string", "null"], "format": "date-time" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "confidence": { "enum": ["low", "medium", "high"] },
    "status": { "enum": ["shadow", "prepared", "presented", "expired", "cancelled"] },
    "user_decision": { "type": ["string", "null"] },
    "execution_result": { "type": ["object", "null"] },
    "reversible": { "const": true },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "reversible", "action_contract"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "reversible": { "type": "boolean" },
          "action_contract": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["schema_version", "action", "status", "approved_by_user", "candidate_id", "payload"],
                "properties": {
                  "schema_version": { "const": "0.1" },
                  "action": { "type": "string", "minLength": 1 },
                  "status": { "const": "proposed" },
                  "approved_by_user": { "const": false },
                  "candidate_id": { "type": "string", "minLength": 1 },
                  "payload": { "type": "object" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
