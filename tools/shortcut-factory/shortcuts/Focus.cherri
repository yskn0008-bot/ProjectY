#define name Focus
#define color blue
#define version 18
#include actions/safari

// One-tap bridge: current YOS NOW task -> existing action URL.
// Runtime logic is injected after Cherri compilation so no token is embedded here.
const focusTarget = rawAction("dk.simonbs.Scriptable.RunScriptInlineIntent", {
    "script": "__YOS_FOCUS_INLINE__",
    "parameter": "",
    "runInApp": false,
    "ShowWhenRun": false
})

openURL(focusTarget)
