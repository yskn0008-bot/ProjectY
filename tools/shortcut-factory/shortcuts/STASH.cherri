#define name STASH
#define color teal
#define inputs text
#define from sharesheet

#include 'actions/documents'
#include 'actions/sharing'
#include 'actions/text'

/*
Existing STASH contract:
- Input text -> append to iCloud Drive/Shortcuts/POCKET.txt.
- No input -> show a readable numbered vCard list without changing stored text.
- Selecting an item copies the exact stored text to the clipboard AND removes
  that item from POCKET.txt, so STASH behaves as a take-and-use pocket.
*/

action 'file.append' appendResolvedFile(
    variable file: 'WFFile',
    variable input: 'WFInput'
) {
    "WFAppendFileWriteMode": "Append"
}

if ShortcutInput {
    const sharedText = getText(ShortcutInput)
    if sharedText {
        const entry = text("{sharedText}\n===YOS_NEXT===\n")
        const pocketFile = getFile("POCKET.txt")
        appendResolvedFile(pocketFile, entry)
        showNotification("保存しました", "STASH", false)
        stop()
    }
}

const stashFile = getFile("POCKET.txt", nil, false)
if !stashFile {
    showNotification("STASHはまだ空です", "STASH", false)
    stop()
}

const stashText = getText(stashFile)

// Split on the complete storage delimiter so list items do not inherit the
// separator newlines. Build a display-only vCard list; POCKET text stays exact.
@rawItems = splitText(stashText, "\n===YOS_NEXT===\n")
@displayItems: array
@rawIndex = 0
@visibleCount = 0

for item in @rawItems {
    @rawIndex += 1
    const cleanItem = getText(@item)
    if cleanItem {
        @visibleCount += 1
        @displayItems += makeVCard("{@rawIndex}｜STASH", "{cleanItem}")
    }
}

if @visibleCount == 0 {
    showNotification("STASHはまだ空です", "STASH", false)
    stop()
}

// vCard gives each row a short numbered title and the saved text as a subtitle.
@menuText = "{@displayItems}"
@menuFile = setName(@menuText, "STASH Menu.vcf")
@menuContacts = @menuFile.contact
const chosenTitle = chooseFromList(@menuContacts, "STASH｜使うものを選択")

if chosenTitle {
    const chosenIndex = getNumbers(chosenTitle)
    const chosenText = getListItem(@rawItems, chosenIndex)
    setClipboard(chosenText)

    // Consume the exact stored entry after copying it.
    const consumedEntry = text("{chosenText}\n===YOS_NEXT===\n")
    const remaining = replaceText(consumedEntry, "", stashText)
    saveFile("POCKET.txt", remaining, true)

    showNotification("コピーしてSTASHから削除しました", "STASH", false)
}
